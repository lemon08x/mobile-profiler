+bool asst::Controller::set_viewport(const std::string& value)
+{
+    if (m_scale_proxy) {
+        Log.error("Viewport must be configured before connecting");
+        return false;
+    }
+
+    if (value.empty() || value == "auto") {
+        m_viewport_override.reset();
+        m_hybrid_viewport = false;
+        m_adaptive_viewport = false;
+        return true;
+    }
+
+    if (value == "hybrid") {
+        m_viewport_override.reset();
+        m_hybrid_viewport = true;
+        m_adaptive_viewport = false;
+        return true;
+    }
+
+    if (value == "adaptive") {
+        m_viewport_override.reset();
+        m_hybrid_viewport = false;
+        m_adaptive_viewport = true;
+        return true;
+    }
+
+    const auto parsed = json::parse(value);
+    if (!parsed) {
+        Log.error("Invalid viewport JSON", value);
+        return false;
+    }
+
+    std::optional<Rect> viewport;
+    if (parsed->is_array()) {
+        const auto& items = parsed->as_array();
+        if (items.size() == 4 && items[0].is<int>() && items[1].is<int>() && items[2].is<int>() &&
+            items[3].is<int>()) {
+            viewport = Rect {
+                items[0].as<int>(),
+                items[1].as<int>(),
+                items[2].as<int>(),
+                items[3].as<int>(),
+            };
+        }
+    }
+    else if (parsed->is_object()) {
+        const auto& object = parsed->as_object();
+        if (object.contains("x") && object.contains("y") && object.contains("width") && object.contains("height")) {
+            viewport = Rect {
+                object.get("x", -1),
+                object.get("y", -1),
+                object.get("width", -1),
+                object.get("height", -1),
+            };
+        }
+    }
+
+    if (!viewport || viewport->x < 0 || viewport->y < 0 || viewport->width <= 0 || viewport->height <= 0) {
+        Log.error("Viewport must be auto, hybrid, adaptive, or [x, y, width, height]", value);
+        return false;
+    }
+
+    m_viewport_override = viewport;
+    m_hybrid_viewport = false;
+    m_adaptive_viewport = false;
+    return true;
+}
