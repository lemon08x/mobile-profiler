+                    if (const double cur_score = cur_max_iter->score; max_score < cur_score) {
+                        max_score = cur_score;
+                        cur_facility_result = cur_res;
+                        cor_suffix_index = static_cast<int>(i);
+                    }
                 }
             }
         }
