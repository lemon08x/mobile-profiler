 {
     const auto& task = hits.task_ptr;
+
+    // JustReturn carries no visual evidence, so an adaptive viewport cannot
+    // inherit a meaningful alignment from recognition. Infer the intended
+    // crop from the hard-coded action coordinate instead: left and right edge
+    // controls stay attached to their physical edges, while content actions
+    // use the centered viewport.
+    if (ctrler()->uses_adaptive_viewport() && task->algorithm == AlgorithmType::JustReturn) {
+        std::optional<int> logical_x;
+        switch (task->action) {
+        case ProcessTaskAction::ClickRect:
+            logical_x = task->specific_rect.x + task->specific_rect.width / 2;
+            break;
+        case ProcessTaskAction::ClickSelf:
+            if (!hits.rect.empty()) {
+                logical_x = hits.rect.x + hits.rect.width / 2;
+            }
+            break;
+        case ProcessTaskAction::Swipe: {
+            const int start_x = task->specific_rect.x + task->specific_rect.width / 2;
+            const int end_x = task->rect_move.x + task->rect_move.width / 2;
+            logical_x = (start_x + end_x) / 2;
+            break;
+        }
+        default:
+            break;
+        }
+
+        if (logical_x) {
+            const ViewportAlignment alignment =
+                ViewportTransform::preferred_alignment_for_logical_x(*logical_x);
+            ctrler()->set_viewport_alignment(alignment);
+            Log.trace("Adaptive viewport inferred action alignment", static_cast<int>(alignment), *logical_x);
+        }
+    }
+
     switch (task->action) {
     case ProcessTaskAction::ClickRect:
         exec_click_task(task->specific_rect);
