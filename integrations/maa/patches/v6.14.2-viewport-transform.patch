+#pragma once
+
+#include <optional>
+#include <utility>
+
+#include "Common/AsstTypes.h"
+
+namespace asst
+{
+enum class ViewportAlignment
+{
+    Center,
+    Left,
+    Right,
+};
+
+class ViewportTransform
+{
+public:
+    static constexpr int HybridEdgeBand = 400;
+
+    ViewportTransform(
+        std::pair<int, int> display_size,
+        std::optional<Rect> viewport = std::nullopt,
+        bool hybrid_edges = false,
+        bool adaptive_viewport = false);
+
+    Point logical_to_display(const Point& point) const noexcept;
+    Point display_to_logical(const Point& point) const noexcept;
+
+    std::pair<Point, Point> logical_swipe_to_display(
+        const Point& start,
+        const Point& end,
+        bool preserve_logical_delta) const noexcept;
+
+    std::pair<int, int> logical_size() const noexcept;
+    std::pair<int, int> display_size() const noexcept;
+    const Rect& viewport() const noexcept;
+    Rect active_viewport() const noexcept;
+    bool uses_hybrid_edges() const noexcept;
+    bool uses_adaptive_viewport() const noexcept;
+    ViewportAlignment viewport_alignment() const noexcept;
+    bool set_viewport_alignment(ViewportAlignment alignment) noexcept;
+    Point convert_viewport_point(
+        const Point& point,
+        ViewportAlignment from,
+        ViewportAlignment to) const noexcept;
+    static ViewportAlignment preferred_alignment_for_logical_x(int logical_x) noexcept;
+
+private:
+    static Rect centered_viewport(std::pair<int, int> display_size) noexcept;
+    Rect viewport_for_alignment(ViewportAlignment alignment) const noexcept;
+    static int scale_axis(int coordinate, int source_extent, int target_offset, int target_extent) noexcept;
+
+    std::pair<int, int> m_display_size;
+    Rect m_viewport;
+    bool m_hybrid_edges = false;
+    bool m_adaptive_viewport = false;
+    ViewportAlignment m_viewport_alignment = ViewportAlignment::Center;
+};
+} // namespace asst
