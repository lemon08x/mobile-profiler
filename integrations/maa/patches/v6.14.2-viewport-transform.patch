diff --git a/src/MaaCore/Controller/ViewportTransform.cpp b/src/MaaCore/Controller/ViewportTransform.cpp
new file mode 100644
index 0000000..358499d
--- /dev/null
+++ b/src/MaaCore/Controller/ViewportTransform.cpp
@@ -0,0 +1,234 @@
+#include "ViewportTransform.h"
+
+#include <cstdint>
+#include <stdexcept>
+
+asst::ViewportTransform::ViewportTransform(
+    std::pair<int, int> display_size,
+    std::optional<Rect> viewport,
+    bool hybrid_edges,
+    bool adaptive_viewport) :
+    m_display_size(display_size),
+    m_viewport(viewport.value_or(centered_viewport(display_size))),
+    m_hybrid_edges(hybrid_edges),
+    m_adaptive_viewport(adaptive_viewport)
+{
+    const auto [display_width, display_height] = m_display_size;
+    if (display_width <= 0 || display_height <= 0) {
+        throw std::invalid_argument("Display size must be positive");
+    }
+
+    if (m_viewport.x < 0 || m_viewport.y < 0 || m_viewport.width <= 0 || m_viewport.height <= 0 ||
+        static_cast<int64_t>(m_viewport.x) + m_viewport.width > display_width ||
+        static_cast<int64_t>(m_viewport.y) + m_viewport.height > display_height) {
+        throw std::invalid_argument("Viewport is outside the display");
+    }
+}
+
+asst::Point asst::ViewportTransform::logical_to_display(const Point& point) const noexcept
+{
+    if (uses_adaptive_viewport()) {
+        const Rect current = active_viewport();
+        return {
+            scale_axis(point.x, WindowWidthDefault, current.x, current.width),
+            scale_axis(point.y, WindowHeightDefault, current.y, current.height),
+        };
+    }
+
+    if (m_hybrid_edges && m_display_size.first > m_viewport.width) {
+        const int right_band_start = WindowWidthDefault - HybridEdgeBand;
+        int display_x = 0;
+        if (point.x < HybridEdgeBand) {
+            display_x = scale_axis(point.x, WindowHeightDefault, 0, m_viewport.height);
+        }
+        else if (point.x >= right_band_start) {
+            display_x = m_display_size.first -
+                        scale_axis(WindowWidthDefault - point.x, WindowHeightDefault, 0, m_viewport.height);
+        }
+        else {
+            display_x = scale_axis(point.x, WindowWidthDefault, m_viewport.x, m_viewport.width);
+        }
+        return {
+            display_x,
+            scale_axis(point.y, WindowHeightDefault, m_viewport.y, m_viewport.height),
+        };
+    }
+
+    return {
+        scale_axis(point.x, WindowWidthDefault, m_viewport.x, m_viewport.width),
+        scale_axis(point.y, WindowHeightDefault, m_viewport.y, m_viewport.height),
+    };
+}
+
+asst::Point asst::ViewportTransform::display_to_logical(const Point& point) const noexcept
+{
+    if (uses_adaptive_viewport()) {
+        const Rect current = active_viewport();
+        return {
+            scale_axis(point.x - current.x, current.width, 0, WindowWidthDefault),
+            scale_axis(point.y - current.y, current.height, 0, WindowHeightDefault),
+        };
+    }
+
+    if (m_hybrid_edges && m_display_size.first > m_viewport.width) {
+        const int physical_edge_width =
+            scale_axis(HybridEdgeBand, WindowHeightDefault, 0, m_viewport.height);
+        if (point.x < physical_edge_width) {
+            return {
+                scale_axis(point.x, m_viewport.height, 0, WindowHeightDefault),
+                scale_axis(point.y - m_viewport.y, m_viewport.height, 0, WindowHeightDefault),
+            };
+        }
+        if (point.x >= m_display_size.first - physical_edge_width) {
+            return {
+                WindowWidthDefault -
+                    scale_axis(m_display_size.first - point.x, m_viewport.height, 0, WindowHeightDefault),
+                scale_axis(point.y - m_viewport.y, m_viewport.height, 0, WindowHeightDefault),
+            };
+        }
+    }
+
+    return {
+        scale_axis(point.x - m_viewport.x, m_viewport.width, 0, WindowWidthDefault),
+        scale_axis(point.y - m_viewport.y, m_viewport.height, 0, WindowHeightDefault),
+    };
+}
+
+std::pair<asst::Point, asst::Point> asst::ViewportTransform::logical_swipe_to_display(
+    const Point& start,
+    const Point& end,
+    bool preserve_logical_delta) const noexcept
+{
+    Point display_start = logical_to_display(start);
+    Point display_end = logical_to_display(end);
+    if (preserve_logical_delta) {
+        display_end = display_start + (end - start);
+    }
+    return { display_start, display_end };
+}
+
+std::pair<int, int> asst::ViewportTransform::logical_size() const noexcept
+{
+    return { WindowWidthDefault, WindowHeightDefault };
+}
+
+std::pair<int, int> asst::ViewportTransform::display_size() const noexcept
+{
+    return m_display_size;
+}
+
+const asst::Rect& asst::ViewportTransform::viewport() const noexcept
+{
+    return m_viewport;
+}
+
+asst::Rect asst::ViewportTransform::active_viewport() const noexcept
+{
+    if (!uses_adaptive_viewport()) {
+        return m_viewport;
+    }
+
+    return viewport_for_alignment(m_viewport_alignment);
+}
+
+asst::Rect asst::ViewportTransform::viewport_for_alignment(ViewportAlignment alignment) const noexcept
+{
+    if (!uses_adaptive_viewport()) {
+        return m_viewport;
+    }
+
+    switch (alignment) {
+    case ViewportAlignment::Left:
+        return { 0, m_viewport.y, m_viewport.width, m_viewport.height };
+    case ViewportAlignment::Right:
+        return {
+            m_display_size.first - m_viewport.width,
+            m_viewport.y,
+            m_viewport.width,
+            m_viewport.height,
+        };
+    case ViewportAlignment::Center:
+    default:
+        return m_viewport;
+    }
+}
+
+bool asst::ViewportTransform::uses_hybrid_edges() const noexcept
+{
+    return m_hybrid_edges && m_display_size.first > m_viewport.width;
+}
+
+bool asst::ViewportTransform::uses_adaptive_viewport() const noexcept
+{
+    return m_adaptive_viewport && m_display_size.first > m_viewport.width;
+}
+
+asst::ViewportAlignment asst::ViewportTransform::viewport_alignment() const noexcept
+{
+    return m_viewport_alignment;
+}
+
+bool asst::ViewportTransform::set_viewport_alignment(ViewportAlignment alignment) noexcept
+{
+    if (!uses_adaptive_viewport() && alignment != ViewportAlignment::Center) {
+        return false;
+    }
+    m_viewport_alignment = alignment;
+    return true;
+}
+
+asst::Point asst::ViewportTransform::convert_viewport_point(
+    const Point& point,
+    ViewportAlignment from,
+    ViewportAlignment to) const noexcept
+{
+    if (!uses_adaptive_viewport() || from == to) {
+        return point;
+    }
+
+    const Rect source = viewport_for_alignment(from);
+    const Rect target = viewport_for_alignment(to);
+    return {
+        point.x + scale_axis(source.x - target.x, target.width, 0, WindowWidthDefault),
+        point.y + scale_axis(source.y - target.y, target.height, 0, WindowHeightDefault),
+    };
+}
+
+asst::ViewportAlignment asst::ViewportTransform::preferred_alignment_for_logical_x(int logical_x) noexcept
+{
+    if (logical_x < HybridEdgeBand) {
+        return ViewportAlignment::Left;
+    }
+    if (logical_x >= WindowWidthDefault - HybridEdgeBand) {
+        return ViewportAlignment::Right;
+    }
+    return ViewportAlignment::Center;
+}
+
+asst::Rect asst::ViewportTransform::centered_viewport(std::pair<int, int> display_size) noexcept
+{
+    const auto [display_width, display_height] = display_size;
+    if (display_width <= 0 || display_height <= 0) {
+        return {};
+    }
+
+    if (static_cast<int64_t>(display_width) * WindowHeightDefault >=
+        static_cast<int64_t>(display_height) * WindowWidthDefault) {
+        const int viewport_width = static_cast<int>(
+            static_cast<int64_t>(display_height) * WindowWidthDefault / WindowHeightDefault);
+        return { (display_width - viewport_width) / 2, 0, viewport_width, display_height };
+    }
+
+    const int viewport_height =
+        static_cast<int>(static_cast<int64_t>(display_width) * WindowHeightDefault / WindowWidthDefault);
+    return { 0, (display_height - viewport_height) / 2, display_width, viewport_height };
+}
+
+int asst::ViewportTransform::scale_axis(
+    int coordinate,
+    int source_extent,
+    int target_offset,
+    int target_extent) noexcept
+{
+    return target_offset + static_cast<int>(static_cast<int64_t>(coordinate) * target_extent / source_extent);
+}
