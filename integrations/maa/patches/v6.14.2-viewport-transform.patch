+#include <catch2/catch_test_macros.hpp>
+
+#include <cmath>
+#include <stdexcept>
+
+#include "Controller/ViewportTransform.h"
+
+TEST_CASE("Viewport transform is identity at the canonical resolution")
+{
+    const asst::ViewportTransform transform({ 1280, 720 });
+
+    REQUIRE(transform.logical_size() == std::pair { 1280, 720 });
+    REQUIRE(transform.display_size() == std::pair { 1280, 720 });
+    REQUIRE(transform.viewport() == asst::Rect { 0, 0, 1280, 720 });
+    REQUIRE(transform.logical_to_display({ 321, 654 }) == asst::Point { 321, 654 });
+    REQUIRE(transform.display_to_logical({ 321, 654 }) == asst::Point { 321, 654 });
+}
+
+TEST_CASE("Viewport transform scales a 16 by 9 display uniformly")
+{
+    const asst::ViewportTransform transform({ 1920, 1080 });
+
+    REQUIRE(transform.viewport() == asst::Rect { 0, 0, 1920, 1080 });
+    REQUIRE(transform.logical_to_display({ 640, 360 }) == asst::Point { 960, 540 });
+    REQUIRE(transform.display_to_logical({ 960, 540 }) == asst::Point { 640, 360 });
+}
+
+TEST_CASE("Viewport transform centers a canonical viewport on an ultrawide phone")
+{
+    const asst::ViewportTransform transform({ 2800, 1260 });
+
+    REQUIRE(transform.viewport() == asst::Rect { 280, 0, 2240, 1260 });
+    REQUIRE(transform.logical_to_display({ 0, 0 }) == asst::Point { 280, 0 });
+    REQUIRE(transform.logical_to_display({ 640, 360 }) == asst::Point { 1400, 630 });
+}
+
+TEST_CASE("Viewport transform supports asymmetric custom content bounds")
+{
+    const asst::Rect viewport { 300, 20, 2160, 1215 };
+    const asst::ViewportTransform transform({ 2800, 1260 }, viewport);
+
+    REQUIRE(transform.viewport() == viewport);
+    REQUIRE(transform.logical_to_display({ 0, 0 }) == asst::Point { 300, 20 });
+
+    const asst::Point logical { 923, 517 };
+    const asst::Point round_trip = transform.display_to_logical(transform.logical_to_display(logical));
+    REQUIRE(std::abs(round_trip.x - logical.x) <= 1);
+    REQUIRE(std::abs(round_trip.y - logical.y) <= 1);
+}
+
+TEST_CASE("Hybrid edge transform keeps edge UI and center content in their native scale")
+{
+    const asst::ViewportTransform transform({ 2800, 1260 }, std::nullopt, true);
+
+    REQUIRE(transform.uses_hybrid_edges());
+    REQUIRE(transform.logical_to_display({ 200, 360 }) == asst::Point { 350, 630 });
+    REQUIRE(transform.logical_to_display({ 640, 360 }) == asst::Point { 1400, 630 });
+    REQUIRE(transform.logical_to_display({ 1080, 360 }) == asst::Point { 2450, 630 });
+}
+
+TEST_CASE("Adaptive viewport switches between left center and right canonical crops")
+{
+    asst::ViewportTransform transform({ 2800, 1260 }, std::nullopt, false, true);
+
+    REQUIRE(transform.uses_adaptive_viewport());
+    REQUIRE(transform.viewport_alignment() == asst::ViewportAlignment::Center);
+    REQUIRE(transform.active_viewport() == asst::Rect { 280, 0, 2240, 1260 });
+    REQUIRE(transform.logical_to_display({ 640, 360 }) == asst::Point { 1400, 630 });
+
+    REQUIRE(transform.set_viewport_alignment(asst::ViewportAlignment::Left));
+    REQUIRE(transform.active_viewport() == asst::Rect { 0, 0, 2240, 1260 });
+    REQUIRE(transform.logical_to_display({ 640, 360 }) == asst::Point { 1120, 630 });
+    REQUIRE(transform.display_to_logical({ 1120, 630 }) == asst::Point { 640, 360 });
+
+    REQUIRE(transform.set_viewport_alignment(asst::ViewportAlignment::Right));
+    REQUIRE(transform.active_viewport() == asst::Rect { 560, 0, 2240, 1260 });
+    REQUIRE(transform.logical_to_display({ 640, 360 }) == asst::Point { 1680, 630 });
+    REQUIRE(transform.display_to_logical({ 1680, 630 }) == asst::Point { 640, 360 });
+}
+
+TEST_CASE("Adaptive viewport points can be normalized to the battlefield viewport")
+{
+    asst::ViewportTransform transform({ 2800, 1260 }, std::nullopt, false, true);
+
+    const asst::Point right_point { 1146, 658 };
+    const asst::Point center_point = transform.convert_viewport_point(
+        right_point,
+        asst::ViewportAlignment::Right,
+        asst::ViewportAlignment::Center);
+
+    REQUIRE(center_point == asst::Point { 1306, 658 });
+
+    transform.set_viewport_alignment(asst::ViewportAlignment::Right);
+    const asst::Point display_from_right = transform.logical_to_display(right_point);
+    transform.set_viewport_alignment(asst::ViewportAlignment::Center);
+    REQUIRE(transform.logical_to_display(center_point) == display_from_right);
+    REQUIRE(transform.convert_viewport_point(
+                center_point,
+                asst::ViewportAlignment::Center,
+                asst::ViewportAlignment::Right) == right_point);
+}
+
+TEST_CASE("High resolution swipe fix preserves the unscaled logical delta")
+{
+    const asst::ViewportTransform transform({ 1920, 1080 });
+
+    const auto [normal_start, normal_end] =
+        transform.logical_swipe_to_display({ 100, 200 }, { 500, 350 }, false);
+    REQUIRE(normal_start == asst::Point { 150, 300 });
+    REQUIRE(normal_end == asst::Point { 750, 525 });
+
+    const auto [fixed_start, fixed_end] =
+        transform.logical_swipe_to_display({ 100, 200 }, { 500, 350 }, true);
+    REQUIRE(fixed_start == asst::Point { 150, 300 });
+    REQUIRE(fixed_end == asst::Point { 550, 450 });
+}
+
+TEST_CASE("Hard-coded edge actions choose their matching adaptive viewport")
+{
+    REQUIRE(asst::ViewportTransform::preferred_alignment_for_logical_x(0) == asst::ViewportAlignment::Left);
+    REQUIRE(asst::ViewportTransform::preferred_alignment_for_logical_x(399) == asst::ViewportAlignment::Left);
+    REQUIRE(asst::ViewportTransform::preferred_alignment_for_logical_x(400) == asst::ViewportAlignment::Center);
+    REQUIRE(asst::ViewportTransform::preferred_alignment_for_logical_x(879) == asst::ViewportAlignment::Center);
+    REQUIRE(asst::ViewportTransform::preferred_alignment_for_logical_x(880) == asst::ViewportAlignment::Right);
+    REQUIRE(asst::ViewportTransform::preferred_alignment_for_logical_x(1279) == asst::ViewportAlignment::Right);
+}
+
+TEST_CASE("Viewport transform rejects bounds outside the display")
+{
+    REQUIRE_THROWS_AS((asst::ViewportTransform({ 2800, 1260 }, asst::Rect { 700, 0, 2240, 1260 })),
+                      std::invalid_argument);
+    REQUIRE_THROWS_AS((asst::ViewportTransform({ 0, 1260 })), std::invalid_argument);
+}
