+std::vector<double> template_scale_candidates(double hint)
+{
+    std::vector<double> candidates { 1.0 };
+    if (hint <= 0.0 || hint >= 0.995) {
+        return candidates;
+    }
+
+    for (const double multiplier : std::array { 0.99, 1.0, 1.01 }) {
+        const double candidate = std::clamp(hint * multiplier, 0.5, 1.0);
+        const bool duplicate = std::ranges::any_of(candidates, [candidate](double existing) {
+            return std::abs(existing - candidate) < 0.001;
+        });
+        if (!duplicate) {
+            candidates.emplace_back(candidate);
+        }
+    }
+    return candidates;
+}
+
+bool set_scaled_task(asst::MultiMatcher& matcher, const std::string& task_name, double scale)
+{
+    matcher.set_task_info(task_name);
+    if (std::abs(scale - 1.0) < 0.001) {
+        return true;
+    }
+
+    const auto task = asst::Task.get<asst::MatchTaskInfo>(task_name);
+    if (!task || task->templ_names.size() != 1) {
+        Log.warn(
+            "Cannot scale facility template",
+            task_name,
+            "template count",
+            task ? task->templ_names.size() : 0);
+        return false;
+    }
+
+    const cv::Mat& source = asst::TemplResource::get_instance().get_templ(task->templ_names.front());
+    if (source.empty()) {
+        return false;
+    }
+
+    cv::Mat resized;
+    cv::resize(
+        source,
+        resized,
+        cv::Size(),
+        scale,
+        scale,
+        scale < 1.0 ? cv::INTER_AREA : cv::INTER_CUBIC);
+    matcher.set_templ(std::move(resized));
+    return true;
+}
