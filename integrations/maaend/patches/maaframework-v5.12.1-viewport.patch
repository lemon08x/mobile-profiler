+
+namespace
+{
+using MAA_CTRL_NS::ViewportAlignment;
+using MAA_CTRL_NS::ViewportMode;
+using MAA_CTRL_NS::ViewportTransform;
+
+int failures = 0;
+
+void check(bool condition, std::string_view message)
+{
+    if (condition) {
+        return;
+    }
+    ++failures;
+    std::cerr << "FAILED: " << message << '\n';
+}
+
+void check_point(const cv::Point& actual, const cv::Point& expected, std::string_view message)
+{
+    check(actual == expected, message);
+}
+
+void check_rect(const cv::Rect& actual, const cv::Rect& expected, std::string_view message)
+{
+    check(actual == expected, message);
+}
+
+void test_parse()
+{
+    const auto adaptive = ViewportTransform::parse(" 1280X720:Adaptive ");
+    check(adaptive.has_value(), "parse adaptive viewport");
+    if (adaptive) {
+        check(adaptive->logical_size == cv::Size(1280, 720), "parse logical size");
+        check(adaptive->mode == ViewportMode::Adaptive, "parse adaptive mode");
+    }
+
+    const auto center = ViewportTransform::parse("1920x1080");
+    check(center.has_value() && center->mode == ViewportMode::Center, "default to center mode");
+    check(!ViewportTransform::parse("1280x0:adaptive"), "reject zero height");
+    check(!ViewportTransform::parse("1280x720:unknown"), "reject unknown mode");
+    check(!ViewportTransform::parse("1280x720:adaptive:extra"), "reject extra separator");
+}
+
+void test_identity_and_scaled_16x9()
+{
+    const MAA_CTRL_NS::ViewportConfig config { .logical_size = { 1280, 720 }, .mode = ViewportMode::Adaptive };
+
+    const ViewportTransform identity({ 1280, 720 }, config);
+    check(identity.active(), "1280x720 viewport active");
+    check(!identity.adaptive(), "1280x720 does not need candidates");
+    check_rect(identity.viewport(), { 0, 0, 1280, 720 }, "1280x720 viewport bounds");
+    check_point(identity.logical_to_display({ 1279, 719 }, ViewportAlignment::Center), { 1279, 719 }, "identity edge mapping");
+
+    const ViewportTransform scaled({ 1920, 1080 }, config);
+    check(scaled.active(), "1920x1080 viewport active");
+    check(!scaled.adaptive(), "1920x1080 does not need candidates");
+    check_rect(scaled.viewport(), { 0, 0, 1920, 1080 }, "1920x1080 viewport bounds");
+    check_point(scaled.logical_to_display({ 640, 360 }, ViewportAlignment::Center), { 960, 540 }, "1920x1080 center mapping");
+    check_point(scaled.display_to_logical({ 960, 540 }, ViewportAlignment::Center), { 640, 360 }, "1920x1080 inverse center mapping");
+}
+
+void test_ultrawide_candidates_and_mapping()
+{
+    const MAA_CTRL_NS::ViewportConfig config { .logical_size = { 1280, 720 }, .mode = ViewportMode::Adaptive };
+
+    struct MatrixCase
+    {
+        cv::Size display;
+        int viewport_width = 0;
+        int center_offset = 0;
+        int right_offset = 0;
+    };
+    const std::array matrix {
+        MatrixCase { .display = { 2800, 1260 }, .viewport_width = 2240, .center_offset = 280, .right_offset = 560 },
+        MatrixCase { .display = { 2400, 1080 }, .viewport_width = 1920, .center_offset = 240, .right_offset = 480 },
+        MatrixCase { .display = { 2340, 1080 }, .viewport_width = 1920, .center_offset = 210, .right_offset = 420 },
+    };
+
+    for (const auto& item : matrix) {
+        const ViewportTransform transform(item.display, config);
+        const std::string prefix = std::to_string(item.display.width) + "x" + std::to_string(item.display.height) + " ";
+
+        check(transform.active(), prefix + "viewport active");
+        check(transform.adaptive(), prefix + "viewport adaptive");
+        check_rect(
+            transform.viewport(ViewportAlignment::Left),
+            { 0, 0, item.viewport_width, item.display.height },
+            prefix + "left viewport");
+        check_rect(
+            transform.viewport(ViewportAlignment::Center),
+            { item.center_offset, 0, item.viewport_width, item.display.height },
+            prefix + "center viewport");
+        check_rect(
+            transform.viewport(ViewportAlignment::Right),
+            { item.right_offset, 0, item.viewport_width, item.display.height },
+            prefix + "right viewport");
+
+        check_point(transform.logical_to_display({ 0, 0 }, ViewportAlignment::Left), { 0, 0 }, prefix + "left origin mapping");
+        check_point(
+            transform.logical_to_display({ 0, 0 }, ViewportAlignment::Center),
+            { item.center_offset, 0 },
+            prefix + "center origin mapping");
+        check_point(
+            transform.logical_to_display({ 0, 0 }, ViewportAlignment::Right),
+            { item.right_offset, 0 },
+            prefix + "right origin mapping");
+        check_point(
+            transform.logical_to_display({ 640, 360 }, ViewportAlignment::Center),
+            { item.center_offset + item.viewport_width / 2, item.display.height / 2 },
+            prefix + "center mapping");
+        check_point(
+            transform.display_to_logical(
+                { item.center_offset + item.viewport_width / 2, item.display.height / 2 },
+                ViewportAlignment::Center),
+            { 640, 360 },
+            prefix + "inverse center mapping");
+    }
+
+    const ViewportTransform transform({ 2800, 1260 }, config);
+
+    const std::vector<cv::Point> logical_swipe { { 100, 600 }, { 640, 360 }, { 1180, 120 } };
+    const std::vector<cv::Point> expected_swipe { { 735, 1050 }, { 1680, 630 }, { 2625, 210 } };
+    for (size_t index = 0; index < logical_swipe.size(); ++index) {
+        check_point(
+            transform.logical_to_display(logical_swipe[index], ViewportAlignment::Right),
+            expected_swipe[index],
+            "swipe and multi-touch points use the same transform");
+    }
+
+    const auto candidates = transform.candidate_alignments();
+    check(candidates == std::array { ViewportAlignment::Center, ViewportAlignment::Left, ViewportAlignment::Right }, "candidate order");
+}
+
+void test_orientation_and_boundaries()
+{
+    const MAA_CTRL_NS::ViewportConfig config { .logical_size = { 1280, 720 }, .mode = ViewportMode::Adaptive };
+    const ViewportTransform portrait({ 1260, 2800 }, config);
+    check(!portrait.active(), "portrait screenshot leaves landscape viewport inactive");
+
+    const ViewportTransform landscape_after_portrait({ 2400, 1080 }, config);
+    check(landscape_after_portrait.active(), "landscape viewport reactivates after portrait frame");
+    check_rect(
+        landscape_after_portrait.viewport(ViewportAlignment::Right),
+        { 480, 0, 1920, 1080 },
+        "orientation transition recomputes right viewport");
+
+    const ViewportTransform too_small({ 1000, 500 }, config);
+    check(!too_small.active(), "undersized screenshot leaves viewport inactive");
+
+    const ViewportTransform transform({ 2800, 1260 }, config);
+    const cv::Point mapped = transform.logical_to_display({ 9999, -10 }, ViewportAlignment::Right);
+    check(mapped.x >= 560 && mapped.x < 2800 && mapped.y >= 0 && mapped.y < 1260, "out-of-range logical point is clamped");
+
+    check(ViewportTransform::preferred_alignment_for_logical_x(399, 1280) == ViewportAlignment::Left, "left edge band");
+    check(ViewportTransform::preferred_alignment_for_logical_x(400, 1280) == ViewportAlignment::Center, "center band start");
+    check(ViewportTransform::preferred_alignment_for_logical_x(879, 1280) == ViewportAlignment::Center, "center band end");
+    check(ViewportTransform::preferred_alignment_for_logical_x(880, 1280) == ViewportAlignment::Right, "right edge band");
+}
+
+void test_recognition_evidence_serialization()
+{
+    MAA_TASK_NS::RecoResult result {
+        .reco_id = 7,
+        .name = "InWorld",
+        .algorithm = "Or",
+        .box = cv::Rect { 10, 20, 30, 40 },
+        .viewport_alignment = "left",
+        .frame_id = 42,
+    };
+    const json::value serialized = result;
+    const auto& object = serialized.as_object();
+    check(object.at("viewport_alignment").as_string() == "left", "recognition callback carries viewport alignment");
+    check(object.at("frame_id").as_integer() == 42, "recognition callback carries raw frame id");
+}
+} // namespace
+
+int main()
+{
+    test_parse();
+    test_identity_and_scaled_16x9();
+    test_ultrawide_candidates_and_mapping();
+    test_orientation_and_boundaries();
+    test_recognition_evidence_serialization();
+
+    if (failures != 0) {
+        std::cerr << failures << " viewport transform checks failed\n";
+        return EXIT_FAILURE;
+    }
+    std::cout << "viewport transform checks passed\n";
+    return EXIT_SUCCESS;
+}
