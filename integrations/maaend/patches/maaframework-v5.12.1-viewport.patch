+    PRIVATE
+    ${CMAKE_SOURCE_DIR}/source/MaaAdbControlUnit
+    ${MAA_PRIVATE_INC}
+    ${MAA_PUBLIC_INC})
+
+add_test(NAME screencap::failover COMMAND ScreencapFailoverTesting)
+set_target_properties(ScreencapFailoverTesting PROPERTIES FOLDER Testing)
diff --git a/test/screencap/main.cpp b/test/screencap/main.cpp
new file mode 100644
index 0000000..4792583
--- /dev/null
+++ b/test/screencap/main.cpp
@@ -0,0 +1,109 @@
+#include <cstdlib>
+#include <iostream>
+#include <optional>
+#include <string_view>
+#include <vector>
+
+#include "Manager/ScreencapFailoverPolicy.h"
+
+namespace
+{
+using MAA_CTRL_UNIT_NS::ScreencapFailoverPolicy;
+
+int failures = 0;
+
+void check(bool condition, std::string_view message)
+{
+    if (condition) {
+        return;
+    }
+    ++failures;
+    std::cerr << "FAILED: " << message << '\n';
+}
+
+void check_order(const std::vector<size_t>& actual, const std::vector<size_t>& expected, std::string_view message)
+{
+    check(actual == expected, message);
+}
+
+void test_active_first_and_switch()
+{
+    ScreencapFailoverPolicy policy;
+    policy.reset(3);
+
+    check_order(policy.begin_attempt(), { 0, 1, 2 }, "initial attempt follows benchmark order");
+    policy.report_failure(0);
+    policy.report_success(1);
+    check(policy.active_candidate() == std::optional<size_t>(1), "successful fallback becomes active");
+
+    check_order(policy.begin_attempt(), { 1, 2 }, "failed method is skipped for the next frame");
+    check_order(policy.begin_attempt(), { 1, 0, 2 }, "backed-off method returns behind the active method");
+}
+
+void test_exponential_backoff()
+{
+    ScreencapFailoverPolicy policy;
+    policy.reset(1);
+
+    check_order(policy.begin_attempt(), { 0 }, "single candidate starts available");
+    policy.report_failure(0);
+    check(policy.begin_attempt().empty(), "first failure skips one frame");
+    check_order(policy.begin_attempt(), { 0 }, "first failure retries after one skipped frame");
+
+    policy.report_failure(0);
+    check(policy.begin_attempt().empty(), "second failure begins longer backoff");
+    check(policy.begin_attempt().empty(), "second failure skips two frames");
+    check_order(policy.begin_attempt(), { 0 }, "second failure retries after two skipped frames");
+}
+
+void test_lifecycle_reset()
+{
+    ScreencapFailoverPolicy policy;
+    policy.reset(2);
+
+    check_order(policy.begin_attempt(), { 0, 1 }, "candidates initially available");
+    policy.report_failure(0);
+    policy.report_failure(1);
+    policy.reset_backoff();
+
+    check_order(policy.begin_attempt(), { 0, 1 }, "resolution or app lifecycle change clears backoff");
+}
+
+void test_runtime_attempt_sequence()
+{
+    ScreencapFailoverPolicy policy;
+    policy.reset(3);
+    std::vector<size_t> calls;
+
+    const auto selected = policy.try_candidates([&](size_t candidate) {
+        calls.emplace_back(candidate);
+        return candidate == 2;
+    });
+
+    check_order(calls, { 0, 1, 2 }, "runtime failure immediately tries ranked fallback methods");
+    check(selected == std::optional<size_t>(2), "runtime attempt reports the successful fallback");
+    check(policy.active_candidate() == std::optional<size_t>(2), "runtime attempt switches the active candidate");
+
+    calls.clear();
+    policy.try_candidates([&](size_t candidate) {
+        calls.emplace_back(candidate);
+        return true;
+    });
+    check_order(calls, { 2 }, "next frame uses the successful fallback first");
+}
+} // namespace
+
+int main()
+{
+    test_active_first_and_switch();
+    test_exponential_backoff();
+    test_lifecycle_reset();
+    test_runtime_attempt_sequence();
+
+    if (failures != 0) {
+        std::cerr << failures << " screencap failover checks failed\n";
+        return EXIT_FAILURE;
+    }
+    std::cout << "screencap failover checks passed\n";
+    return EXIT_SUCCESS;
+}
