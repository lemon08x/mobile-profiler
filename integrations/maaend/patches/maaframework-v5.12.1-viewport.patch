+
+bool ControllerAgent::adaptive_viewport() const
+{
+    std::unique_lock lock(image_mutex_);
+    return viewport_transform_ && viewport_transform_->adaptive();
+}
+
+ViewportAlignment ControllerAgent::viewport_alignment() const
+{
+    std::unique_lock lock(image_mutex_);
+    return viewport_alignment_;
+}
+
+bool ControllerAgent::select_viewport_alignment(ViewportAlignment alignment)
+{
+    if (alignment != ViewportAlignment::Center && alignment != ViewportAlignment::Left && alignment != ViewportAlignment::Right) {
+        return false;
+    }
+
+    std::unique_lock lock(image_mutex_);
+    if (!viewport_transform_ || !viewport_transform_->active()) {
+        return alignment == ViewportAlignment::Center;
+    }
+    if (!viewport_transform_->adaptive() && alignment != ViewportAlignment::Center) {
+        return false;
+    }
+    if (raw_image_.empty()) {
+        return false;
+    }
+
+    cv::Mat selected = render_viewport_image(raw_image_, alignment);
+    if (selected.empty()) {
+        return false;
+    }
+    viewport_alignment_ = alignment;
+    cached_viewport_alignment_ = alignment;
+    image_ = std::move(selected);
+    return true;
+}
+
+std::vector<ViewportImage> ControllerAgent::viewport_images() const
+{
+    std::unique_lock lock(image_mutex_);
+    if (!viewport_transform_ || !viewport_transform_->adaptive() || raw_image_.empty()) {
+        return { { .alignment = cached_viewport_alignment_, .frame_id = frame_id_, .image = image_.clone() } };
+    }
+
+    std::vector<ViewportImage> result;
+    const auto order = viewport_transform_->candidate_alignments();
+
+    std::vector<cv::Rect> seen;
+    for (const auto alignment : order) {
+        const cv::Rect rect = viewport_transform_->viewport(alignment);
+        if (std::ranges::find(seen, rect) != seen.end()) {
+            continue;
+        }
+        seen.emplace_back(rect);
+        result.emplace_back(
+            ViewportImage { .alignment = alignment, .frame_id = frame_id_, .image = render_viewport_image(raw_image_, alignment) });
+    }
+    return result;
+}
+
+ViewportAlignment ControllerAgent::preferred_viewport_alignment(int logical_x) const
+{
+    std::unique_lock lock(image_mutex_);
+    if (!viewport_transform_ || !viewport_transform_->adaptive()) {
+        return ViewportAlignment::Center;
+    }
+    return ViewportTransform::preferred_alignment_for_logical_x(logical_x, viewport_transform_->logical_size().width);
 }
 
