-cv::Point ControllerAgent::preproc_touch_point(const cv::Point& p)
+std::optional<Param>
+    ControllerAgent::display_param_snapshot_locked(Action::Type type, const Param& param, ViewportAlignment alignment) const
+{
+    const auto map_point = [&](const cv::Point& point) -> std::optional<cv::Point> {
+        if (control_unit_ && control_unit_->get_features() & MaaControllerFeature_NoScalingTouchPoints) {
+            return point;
+        }
+        if (viewport_transform_ && viewport_transform_->active() && !raw_image_.empty()) {
+            return viewport_transform_->logical_to_display(point, alignment);
+        }
+        if (image_target_width_ <= 0 || image_target_height_ <= 0 || image_raw_width_ <= 0 || image_raw_height_ <= 0) {
+            return std::nullopt;
+        }
+
+        const double scale_width = static_cast<double>(image_raw_width_) / image_target_width_;
+        const double scale_height = static_cast<double>(image_raw_height_) / image_target_height_;
+        return cv::Point {
+            static_cast<int>(std::round(point.x * scale_width)),
+            static_cast<int>(std::round(point.y * scale_height)),
+        };
+    };
+
+    Param display = param;
+    if (type == Action::Type::click) {
+        auto& value = std::get<ClickParam>(display);
+        const auto point = map_point(value.point);
+        if (!point) {
+            return std::nullopt;
+        }
+        value.point = *point;
+    }
+    else if (type == Action::Type::long_press) {
+        auto& value = std::get<LongPressParam>(display);
+        const auto point = map_point(value.point);
+        if (!point) {
+            return std::nullopt;
+        }
+        value.point = *point;
+    }
+    else if (type == Action::Type::swipe) {
+        auto& value = std::get<SwipeParam>(display);
+        const auto begin = map_point(value.begin);
+        if (!begin) {
+            return std::nullopt;
+        }
+        value.begin = *begin;
+        for (auto& end : value.end) {
+            const auto point = map_point(end);
+            if (!point) {
+                return std::nullopt;
+            }
+            end = *point;
+        }
+    }
+    else if (type == Action::Type::multi_swipe) {
+        auto& value = std::get<MultiSwipeParam>(display);
+        for (auto& swipe : value.swipes) {
+            const auto begin = map_point(swipe.begin);
+            if (!begin) {
+                return std::nullopt;
+            }
+            swipe.begin = *begin;
+            for (auto& end : swipe.end) {
+                const auto point = map_point(end);
+                if (!point) {
+                    return std::nullopt;
+                }
+                end = *point;
+            }
+        }
+    }
+    else if (type == Action::Type::touch_down || type == Action::Type::touch_move) {
+        auto& value = std::get<TouchParam>(display);
+        const auto point = map_point(value.point);
+        if (!point) {
+            return std::nullopt;
+        }
+        value.point = *point;
+    }
+    else if (type == Action::Type::scroll) {
+        auto& value = std::get<ScrollParam>(display);
+        const auto point = map_point(value.point);
+        if (!point) {
+            return std::nullopt;
+        }
+        value.point = *point;
+    }
+    else {
+        return std::nullopt;
+    }
+
+    return display;
+}
