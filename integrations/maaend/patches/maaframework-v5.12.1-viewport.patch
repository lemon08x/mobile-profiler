+cv::Mat ControllerAgent::render_viewport_image(const cv::Mat& raw, ViewportAlignment alignment) const
+{
+    if (raw.empty() || !viewport_transform_ || !viewport_transform_->active()) {
+        return {};
+    }
+
+    const cv::Rect viewport = viewport_transform_->viewport(alignment);
+    const cv::Rect bounds { 0, 0, raw.cols, raw.rows };
+    if (viewport.empty() || (viewport & bounds) != viewport) {
+        LogError << "Screenshot viewport is outside the raw image" << VAR(viewport.x) << VAR(viewport.y) << VAR(viewport.width)
+                 << VAR(viewport.height) << VAR(raw.cols) << VAR(raw.rows);
+        return {};
+    }
