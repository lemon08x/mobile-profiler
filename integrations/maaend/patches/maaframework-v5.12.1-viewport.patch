diff --git a/source/MaaAdbControlUnit/Manager/ScreencapFailoverPolicy.cpp b/source/MaaAdbControlUnit/Manager/ScreencapFailoverPolicy.cpp
new file mode 100644
index 0000000..442aed1
--- /dev/null
+++ b/source/MaaAdbControlUnit/Manager/ScreencapFailoverPolicy.cpp
@@ -0,0 +1,71 @@
+#include "ScreencapFailoverPolicy.h"
+
+#include <algorithm>
+
+MAA_CTRL_UNIT_NS_BEGIN
+
+void ScreencapFailoverPolicy::reset(size_t candidate_count, size_t active_candidate)
+{
+    candidates_.assign(candidate_count, CandidateState {});
+    active_candidate_ = active_candidate < candidate_count ? std::optional<size_t>(active_candidate) : std::nullopt;
+    generation_ = 0;
+}
+
+void ScreencapFailoverPolicy::reset_backoff()
+{
+    for (auto& candidate : candidates_) {
+        candidate = CandidateState {};
+    }
+}
+
+std::vector<size_t> ScreencapFailoverPolicy::begin_attempt()
+{
+    ++generation_;
+    std::vector<size_t> order;
+    order.reserve(candidates_.size());
+
+    if (active_candidate_ && available(*active_candidate_)) {
+        order.emplace_back(*active_candidate_);
+    }
+    for (size_t candidate = 0; candidate < candidates_.size(); ++candidate) {
+        if (candidate == active_candidate_ || !available(candidate)) {
+            continue;
+        }
+        order.emplace_back(candidate);
+    }
+    return order;
+}
+
+void ScreencapFailoverPolicy::report_success(size_t candidate)
+{
+    if (candidate >= candidates_.size()) {
+        return;
+    }
+    candidates_[candidate] = CandidateState {};
+    active_candidate_ = candidate;
+}
+
+void ScreencapFailoverPolicy::report_failure(size_t candidate)
+{
+    if (candidate >= candidates_.size()) {
+        return;
+    }
+
+    auto& state = candidates_[candidate];
+    ++state.consecutive_failures;
+    const uint32_t exponent = std::min<uint32_t>(state.consecutive_failures - 1, 5);
+    const uint64_t skipped_generations = uint64_t { 1 } << exponent;
+    state.retry_generation = generation_ + skipped_generations + 1;
+}
+
+std::optional<size_t> ScreencapFailoverPolicy::active_candidate() const noexcept
+{
+    return active_candidate_;
+}
+
+bool ScreencapFailoverPolicy::available(size_t candidate) const noexcept
+{
+    return candidate < candidates_.size() && generation_ >= candidates_[candidate].retry_generation;
+}
+
+MAA_CTRL_UNIT_NS_END
diff --git a/source/MaaAdbControlUnit/Manager/ScreencapFailoverPolicy.h b/source/MaaAdbControlUnit/Manager/ScreencapFailoverPolicy.h
new file mode 100644
index 0000000..156531d
--- /dev/null
+++ b/source/MaaAdbControlUnit/Manager/ScreencapFailoverPolicy.h
@@ -0,0 +1,51 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <vector>
+
+#include "Common/Conf.h"
+
+MAA_CTRL_UNIT_NS_BEGIN
+
+class ScreencapFailoverPolicy
+{
+public:
+    void reset(size_t candidate_count, size_t active_candidate = 0);
+    void reset_backoff();
+
+    std::vector<size_t> begin_attempt();
+    void report_success(size_t candidate);
+    void report_failure(size_t candidate);
+
+    template <typename Attempt>
+    std::optional<size_t> try_candidates(Attempt&& attempt)
+    {
+        for (const size_t candidate : begin_attempt()) {
+            if (attempt(candidate)) {
+                report_success(candidate);
+                return candidate;
+            }
+            report_failure(candidate);
+        }
+        return std::nullopt;
+    }
+
+    std::optional<size_t> active_candidate() const noexcept;
+
+private:
+    struct CandidateState
+    {
+        uint32_t consecutive_failures = 0;
+        uint64_t retry_generation = 0;
+    };
+
+    bool available(size_t candidate) const noexcept;
+
+    std::vector<CandidateState> candidates_;
+    std::optional<size_t> active_candidate_;
+    uint64_t generation_ = 0;
+};
+
+MAA_CTRL_UNIT_NS_END
diff --git a/source/MaaFramework/Controller/ViewportTransform.cpp b/source/MaaFramework/Controller/ViewportTransform.cpp
new file mode 100644
index 0000000..7605f1f
--- /dev/null
+++ b/source/MaaFramework/Controller/ViewportTransform.cpp
@@ -0,0 +1,226 @@
+#include "ViewportTransform.h"
+
+#include <algorithm>
+#include <cctype>
+#include <charconv>
+#include <cmath>
+#include <cstdint>
+#include <string>
+
+MAA_CTRL_NS_BEGIN
+
+namespace
+{
+std::string trim_and_lower(std::string_view value)
+{
+    const auto first = value.find_first_not_of(" \t\r\n");
+    if (first == std::string_view::npos) {
+        return {};
+    }
+    const auto last = value.find_last_not_of(" \t\r\n");
+    std::string result(value.substr(first, last - first + 1));
+    std::ranges::transform(result, result.begin(), [](unsigned char ch) { return static_cast<char>(std::tolower(ch)); });
+    return result;
+}
+
+bool parse_positive_int(std::string_view value, int& output) noexcept
+{
+    if (value.empty()) {
+        return false;
+    }
+    const char* begin = value.data();
+    const char* end = begin + value.size();
+    const auto [ptr, error] = std::from_chars(begin, end, output);
+    return error == std::errc() && ptr == end && output > 0;
+}
+} // namespace
+
+ViewportTransform::ViewportTransform(cv::Size display_size, ViewportConfig config)
+    : display_size_(display_size)
+    , config_(config)
+{
+    if (display_size_.width <= 0 || display_size_.height <= 0 || config_.logical_size.width <= 0 || config_.logical_size.height <= 0) {
+        return;
+    }
+
+    const bool display_landscape = display_size_.width >= display_size_.height;
+    const bool logical_landscape = config_.logical_size.width >= config_.logical_size.height;
+    if (display_landscape != logical_landscape || display_size_.width < config_.logical_size.width
+        || display_size_.height < config_.logical_size.height) {
+        return;
+    }
+
+    const int64_t display_ratio = static_cast<int64_t>(display_size_.width) * config_.logical_size.height;
+    const int64_t logical_ratio = static_cast<int64_t>(display_size_.height) * config_.logical_size.width;
+    if (display_ratio >= logical_ratio) {
+        const int width =
+            static_cast<int>(static_cast<int64_t>(display_size_.height) * config_.logical_size.width / config_.logical_size.height);
+        center_viewport_ = { (display_size_.width - width) / 2, 0, width, display_size_.height };
+    }
+    else {
+        const int height =
+            static_cast<int>(static_cast<int64_t>(display_size_.width) * config_.logical_size.height / config_.logical_size.width);
+        center_viewport_ = { 0, (display_size_.height - height) / 2, display_size_.width, height };
+    }
+
+    active_ = center_viewport_.width >= config_.logical_size.width && center_viewport_.height >= config_.logical_size.height;
+}
+
+std::optional<ViewportConfig> ViewportTransform::parse(std::string_view value) noexcept
+{
+    const std::string normalized = trim_and_lower(value);
+    if (normalized.empty() || normalized == "off" || normalized == "disabled") {
+        return std::nullopt;
+    }
+
+    const size_t separator = normalized.find(':');
+    const std::string_view size_part(normalized.data(), separator == std::string::npos ? normalized.size() : separator);
+    const std::string_view mode_part =
+        separator == std::string::npos ? std::string_view("center") : std::string_view(normalized).substr(separator + 1);
+    const size_t cross = size_part.find('x');
+    if (cross == std::string_view::npos || size_part.find('x', cross + 1) != std::string_view::npos) {
+        return std::nullopt;
+    }
+
+    int width = 0;
+    int height = 0;
+    if (!parse_positive_int(size_part.substr(0, cross), width) || !parse_positive_int(size_part.substr(cross + 1), height)) {
+        return std::nullopt;
+    }
+
+    ViewportMode mode;
+    if (mode_part == "center" || mode_part == "centre") {
+        mode = ViewportMode::Center;
+    }
+    else if (mode_part == "adaptive") {
+        mode = ViewportMode::Adaptive;
+    }
+    else {
+        return std::nullopt;
+    }
+
+    return ViewportConfig { .logical_size = { width, height }, .mode = mode };
+}
+
+std::string_view ViewportTransform::mode_name(ViewportMode mode) noexcept
+{
+    switch (mode) {
+    case ViewportMode::Adaptive:
+        return "adaptive";
+    case ViewportMode::Center:
+    default:
+        return "center";
+    }
+}
+
+std::string_view ViewportTransform::alignment_name(ViewportAlignment alignment) noexcept
+{
+    switch (alignment) {
+    case ViewportAlignment::Left:
+        return "left";
+    case ViewportAlignment::Right:
+        return "right";
+    case ViewportAlignment::Center:
+    default:
+        return "center";
+    }
+}
+
+bool ViewportTransform::active() const noexcept
+{
+    return active_;
+}
+
+bool ViewportTransform::adaptive() const noexcept
+{
+    if (!active_ || config_.mode != ViewportMode::Adaptive) {
+        return false;
+    }
+    return center_viewport_.width != display_size_.width || center_viewport_.height != display_size_.height;
+}
+
+cv::Size ViewportTransform::display_size() const noexcept
+{
+    return display_size_;
+}
+
+cv::Size ViewportTransform::logical_size() const noexcept
+{
+    return config_.logical_size;
+}
+
+cv::Rect ViewportTransform::viewport(ViewportAlignment alignment) const noexcept
+{
+    if (!active_) {
+        return {};
+    }
+    if (!adaptive() || alignment == ViewportAlignment::Center) {
+        return center_viewport_;
+    }
+
+    if (center_viewport_.width < display_size_.width) {
+        const int x = alignment == ViewportAlignment::Left ? 0 : display_size_.width - center_viewport_.width;
+        return { x, center_viewport_.y, center_viewport_.width, center_viewport_.height };
+    }
+    if (center_viewport_.height < display_size_.height) {
+        const int y = alignment == ViewportAlignment::Left ? 0 : display_size_.height - center_viewport_.height;
+        return { center_viewport_.x, y, center_viewport_.width, center_viewport_.height };
+    }
+    return center_viewport_;
+}
+
+std::array<ViewportAlignment, 3> ViewportTransform::candidate_alignments() const noexcept
+{
+    return { ViewportAlignment::Center, ViewportAlignment::Left, ViewportAlignment::Right };
+}
+
+cv::Point ViewportTransform::logical_to_display(const cv::Point& point, ViewportAlignment alignment) const noexcept
+{
+    const cv::Rect target = viewport(alignment);
+    if (target.empty()) {
+        return point;
+    }
+    return {
+        scale_axis(point.x, config_.logical_size.width, target.x, target.width),
+        scale_axis(point.y, config_.logical_size.height, target.y, target.height),
+    };
+}
+
+cv::Point ViewportTransform::display_to_logical(const cv::Point& point, ViewportAlignment alignment) const noexcept
+{
+    const cv::Rect source = viewport(alignment);
+    if (source.empty()) {
+        return point;
+    }
+    return {
+        scale_axis(point.x - source.x, source.width, 0, config_.logical_size.width),
+        scale_axis(point.y - source.y, source.height, 0, config_.logical_size.height),
+    };
+}
+
+ViewportAlignment ViewportTransform::preferred_alignment_for_logical_x(int logical_x, int logical_width) noexcept
+{
+    if (logical_width <= 0) {
+        return ViewportAlignment::Center;
+    }
+    const int edge_band = logical_width * 5 / 16;
+    if (logical_x < edge_band) {
+        return ViewportAlignment::Left;
+    }
+    if (logical_x >= logical_width - edge_band) {
+        return ViewportAlignment::Right;
+    }
+    return ViewportAlignment::Center;
+}
+
+int ViewportTransform::scale_axis(int coordinate, int source_extent, int target_offset, int target_extent) noexcept
+{
+    if (source_extent <= 0 || target_extent <= 0) {
+        return target_offset;
+    }
+    const int bounded = std::clamp(coordinate, 0, source_extent - 1);
+    const int scaled = static_cast<int>(std::llround(static_cast<double>(bounded) * static_cast<double>(target_extent) / source_extent));
+    return target_offset + std::clamp(scaled, 0, target_extent - 1);
+}
+
+MAA_CTRL_NS_END
diff --git a/source/MaaFramework/Controller/ViewportTransform.h b/source/MaaFramework/Controller/ViewportTransform.h
new file mode 100644
index 0000000..b0f2176
--- /dev/null
+++ b/source/MaaFramework/Controller/ViewportTransform.h
@@ -0,0 +1,62 @@
+#pragma once
+
+#include <array>
+#include <optional>
+#include <string_view>
+
+#include "Common/Conf.h"
+#include "MaaFramework/MaaDef.h"
+#include "MaaUtils/NoWarningCVMat.hpp"
+
+MAA_CTRL_NS_BEGIN
+
+enum class ViewportMode
+{
+    Center,
+    Adaptive,
+};
+
+enum class ViewportAlignment
+{
+    Center = MaaViewportAlignment_Center,
+    Left = MaaViewportAlignment_Left,
+    Right = MaaViewportAlignment_Right,
+};
+
+struct ViewportConfig
+{
+    cv::Size logical_size;
+    ViewportMode mode = ViewportMode::Center;
+};
+
+class ViewportTransform
+{
+public:
+    ViewportTransform(cv::Size display_size, ViewportConfig config);
+
+    static std::optional<ViewportConfig> parse(std::string_view value) noexcept;
+    static std::string_view mode_name(ViewportMode mode) noexcept;
+    static std::string_view alignment_name(ViewportAlignment alignment) noexcept;
+
+    bool active() const noexcept;
+    bool adaptive() const noexcept;
+    cv::Size display_size() const noexcept;
+    cv::Size logical_size() const noexcept;
+    cv::Rect viewport(ViewportAlignment alignment = ViewportAlignment::Center) const noexcept;
+    std::array<ViewportAlignment, 3> candidate_alignments() const noexcept;
+
+    cv::Point logical_to_display(const cv::Point& point, ViewportAlignment alignment) const noexcept;
+    cv::Point display_to_logical(const cv::Point& point, ViewportAlignment alignment) const noexcept;
+
+    static ViewportAlignment preferred_alignment_for_logical_x(int logical_x, int logical_width) noexcept;
+
+private:
+    static int scale_axis(int coordinate, int source_extent, int target_offset, int target_extent) noexcept;
+
+    cv::Size display_size_;
+    ViewportConfig config_;
+    cv::Rect center_viewport_;
+    bool active_ = false;
+};
+
+MAA_CTRL_NS_END
