+bool ControllerAgent::set_screenshot_viewport_alignment(MaaOptionValue value, MaaOptionValueSize val_size)
+{
+    LogDebug;
+
+    if (!value || val_size != sizeof(MaaViewportAlignment)) {
+        LogError << "invalid viewport alignment option" << VAR_VOIDP(value) << VAR(val_size);
+        return false;
+    }
+
+    const auto raw = *reinterpret_cast<const MaaViewportAlignment*>(value);
+    ViewportAlignment alignment;
+    switch (raw) {
+    case MaaViewportAlignment_Center:
+        alignment = ViewportAlignment::Center;
+        break;
+    case MaaViewportAlignment_Left:
+        alignment = ViewportAlignment::Left;
+        break;
+    case MaaViewportAlignment_Right:
+        alignment = ViewportAlignment::Right;
+        break;
+    default:
+        LogError << "unknown viewport alignment" << VAR(raw);
+        return false;
+    }
+
+    std::unique_lock lock(image_mutex_);
+    if (raw_image_.empty()) {
+        LogError << "viewport alignment requires a valid cached raw frame";
+        return false;
+    }
+
+    const bool active = viewport_transform_ && viewport_transform_->active();
+    if (!active) {
+        if (alignment != ViewportAlignment::Center || image_.empty()) {
+            LogError << "only center viewport alignment is available while adaptive viewport is inactive" << VAR(raw);
+            return false;
+        }
+        viewport_alignment_ = ViewportAlignment::Center;
+        cached_viewport_alignment_ = ViewportAlignment::Center;
+        return true;
+    }
+    if (!viewport_transform_->adaptive() && alignment != ViewportAlignment::Center) {
+        LogError << "left and right viewport alignments require adaptive viewport mode" << VAR(raw);
+        return false;
+    }
+
+    cv::Mat selected = render_viewport_image(raw_image_, alignment);
+    if (selected.empty()) {
+        return false;
+    }
+    viewport_alignment_ = alignment;
+    cached_viewport_alignment_ = alignment;
+    image_ = std::move(selected);
+    LogInfo << "selected screenshot viewport alignment without capturing a new frame" << VAR(ViewportTransform::alignment_name(alignment))
+            << VAR(frame_id_);
+    return true;
+}
+
