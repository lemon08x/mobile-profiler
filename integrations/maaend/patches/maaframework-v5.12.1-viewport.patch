+void PipelineTask::select_direct_hit_action_alignment(const RecoResult& reco, const PipelineData& data)
+{
+    auto* ctrl = controller();
+    if (!ctrl || !ctrl->adaptive_viewport() || reco.algorithm != "DirectHit") {
+        return;
+    }
+
+    const auto logical_x = action_logical_x(reco, data);
+    if (!logical_x) {
+        return;
+    }
+
+    const auto alignment = ctrl->preferred_viewport_alignment(*logical_x);
+    if (!ctrl->select_viewport_alignment(alignment)) {
+        LogError << "failed to infer DirectHit action viewport alignment" << VAR(*logical_x)
+                 << VAR(MAA_CTRL_NS::ViewportTransform::alignment_name(alignment));
+        return;
+    }
+
+    LogInfo << "selected DirectHit action viewport alignment" << VAR(*logical_x)
+            << VAR(MAA_CTRL_NS::ViewportTransform::alignment_name(alignment));
+}
+
+std::optional<int> PipelineTask::action_logical_x(const RecoResult& reco, const PipelineData& data)
+{
+    if (!context_ || !reco.box) {
+        return std::nullopt;
+    }
+
+    ActionHelper helper(context_.get());
+    std::vector<int> centers;
+    auto append_target = [&](const MAA_RES_NS::Action::Target& target) {
+        const cv::Rect rect = helper.get_target_rect(target, *reco.box);
+        if (!rect.empty()) {
+            centers.emplace_back(rect.x + rect.width / 2);
+        }
+    };
+    auto append_swipe = [&](const MAA_RES_NS::Action::SwipeParam& swipe) {
+        append_target(swipe.begin);
+        for (size_t index = 0; index < swipe.end.size(); ++index) {
+            const auto& end = swipe.end[index];
+            const cv::Rect offset = swipe.end_offset.empty()          ? cv::Rect {}
+                                    : index < swipe.end_offset.size() ? swipe.end_offset[index]
+                                                                      : swipe.end_offset.back();
+            append_target(MAA_RES_NS::Action::Target { .type = end.type, .param = end.param, .offset = offset });
+        }
+    };
+
+    using namespace MAA_RES_NS::Action;
+    switch (data.action_type) {
+    case Type::Click:
+        append_target(std::get<ClickParam>(data.action_param).target);
+        break;
+    case Type::LongPress:
+        append_target(std::get<LongPressParam>(data.action_param).target);
+        break;
+    case Type::Swipe:
+        append_swipe(std::get<SwipeParam>(data.action_param));
+        break;
+    case Type::MultiSwipe:
+        for (const auto& swipe : std::get<MultiSwipeParam>(data.action_param).swipes) {
+            append_swipe(swipe);
+        }
+        break;
+    case Type::TouchDown:
+    case Type::TouchMove:
+        append_target(std::get<TouchParam>(data.action_param).target);
+        break;
+    case Type::Scroll:
+        append_target(std::get<ScrollParam>(data.action_param).target);
+        break;
+    case Type::Custom:
+        append_target(std::get<CustomParam>(data.action_param).target);
+        break;
+    default:
+        break;
+    }
+
+    if (centers.empty()) {
+        return std::nullopt;
+    }
+    return std::accumulate(centers.cbegin(), centers.cend(), 0) / static_cast<int>(centers.size());
+}
