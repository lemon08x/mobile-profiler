+void ControllerAgent::configure_viewport_from_environment()
+{
+#ifdef _MSC_VER
+    char* raw_value = nullptr;
+    size_t value_size = 0;
+    if (_dupenv_s(&raw_value, &value_size, "MAA_SCREENSHOT_VIEWPORT") != 0) {
+        return;
+    }
+    const std::unique_ptr<char, decltype(&std::free)> value_holder(raw_value, &std::free);
+    const std::string value = value_holder ? value_holder.get() : "";
+#else
+    const char* raw_value = std::getenv("MAA_SCREENSHOT_VIEWPORT");
+    const std::string value = raw_value ? raw_value : "";
+#endif
+    if (value.empty()) {
+        return;
+    }
+
+    viewport_config_ = ViewportTransform::parse(value);
+    if (!viewport_config_) {
+        LogError << "Invalid MAA_SCREENSHOT_VIEWPORT; expected WIDTHxHEIGHT:center or WIDTHxHEIGHT:adaptive" << VAR(value);
+        return;
+    }
+
+    LogInfo << "Configured screenshot viewport from environment" << VAR(viewport_config_->logical_size.width)
+            << VAR(viewport_config_->logical_size.height) << VAR(ViewportTransform::mode_name(viewport_config_->mode));
+}
