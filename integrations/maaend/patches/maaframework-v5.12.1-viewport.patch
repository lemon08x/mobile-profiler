diff --git a/test/viewport/controller.cpp b/test/viewport/controller.cpp
new file mode 100644
index 0000000..bbf86a5
--- /dev/null
+++ b/test/viewport/controller.cpp
@@ -0,0 +1,437 @@
+#include <chrono>
+#include <condition_variable>
+#include <cstdlib>
+#include <iostream>
+#include <mutex>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include <opencv2/core.hpp>
+
+#include <MaaFramework/MaaAPI.h>
+
+namespace
+{
+struct InputEvent
+{
+    std::string type;
+    int contact = 0;
+    int x = 0;
+    int y = 0;
+    std::chrono::steady_clock::time_point at = std::chrono::steady_clock::now();
+};
+
+struct FakeController
+{
+    int width = 2800;
+    int height = 1260;
+    std::vector<uint8_t> pixels = std::vector<uint8_t>(static_cast<size_t>(width) * height * 3, 0);
+    std::vector<InputEvent> events;
+    std::vector<std::string> controller_callbacks;
+    MaaControllerFeature features = 0;
+    std::mutex mutex;
+    std::condition_variable condition;
+    bool block_start = false;
+    bool start_entered = false;
+    bool release_start = false;
+};
+
+int failures = 0;
+
+void check(bool condition, std::string_view message)
+{
+    if (condition) {
+        return;
+    }
+    ++failures;
+    std::cerr << "FAILED: " << message << '\n';
+}
+
+MaaBool request_uuid(void*, MaaStringBuffer* buffer)
+{
+    return MaaStringBufferSet(buffer, "viewport-controller-test");
+}
+
+void controller_event(void*, const char* message, const char* details_json, void* trans_arg)
+{
+    auto& state = *static_cast<FakeController*>(trans_arg);
+    std::unique_lock lock(state.mutex);
+    state.controller_callbacks.emplace_back(
+        std::string(message ? message : "") + " " + std::string(details_json ? details_json : ""));
+}
+
+MaaBool connect(void*)
+{
+    return true;
+}
+
+MaaBool connected(void*)
+{
+    return true;
+}
+
+MaaControllerFeature get_features(void* trans_arg)
+{
+    auto& state = *static_cast<FakeController*>(trans_arg);
+    std::unique_lock lock(state.mutex);
+    return state.features;
+}
+
+MaaBool screencap(void* trans_arg, MaaImageBuffer* buffer)
+{
+    auto& state = *static_cast<FakeController*>(trans_arg);
+    std::unique_lock lock(state.mutex);
+    return MaaImageBufferSetRawData(buffer, state.pixels.data(), state.width, state.height, CV_8UC3);
+}
+
+MaaBool start_app(const char*, void* trans_arg)
+{
+    auto& state = *static_cast<FakeController*>(trans_arg);
+    std::unique_lock lock(state.mutex);
+    if (!state.block_start) {
+        return true;
+    }
+    state.start_entered = true;
+    state.condition.notify_all();
+    state.condition.wait(lock, [&]() { return state.release_start; });
+    return true;
+}
+
+MaaBool click(int32_t x, int32_t y, void* trans_arg)
+{
+    auto& state = *static_cast<FakeController*>(trans_arg);
+    std::unique_lock lock(state.mutex);
+    state.events.emplace_back(InputEvent { .type = "click", .x = x, .y = y });
+    return true;
+}
+
+MaaBool swipe(int32_t x1, int32_t y1, int32_t x2, int32_t y2, int32_t, void* trans_arg)
+{
+    auto& state = *static_cast<FakeController*>(trans_arg);
+    std::unique_lock lock(state.mutex);
+    state.events.emplace_back(InputEvent { .type = "swipe_begin", .x = x1, .y = y1 });
+    state.events.emplace_back(InputEvent { .type = "swipe_end", .x = x2, .y = y2 });
+    return true;
+}
+
+MaaBool touch_down(int32_t contact, int32_t x, int32_t y, int32_t, void* trans_arg)
+{
+    auto& state = *static_cast<FakeController*>(trans_arg);
+    std::unique_lock lock(state.mutex);
+    state.events.emplace_back(InputEvent { .type = "down", .contact = contact, .x = x, .y = y });
+    return true;
+}
+
+MaaBool touch_move(int32_t contact, int32_t x, int32_t y, int32_t, void* trans_arg)
+{
+    auto& state = *static_cast<FakeController*>(trans_arg);
+    std::unique_lock lock(state.mutex);
+    state.events.emplace_back(InputEvent { .type = "move", .contact = contact, .x = x, .y = y });
+    return true;
+}
+
+MaaBool touch_up(int32_t contact, void* trans_arg)
+{
+    auto& state = *static_cast<FakeController*>(trans_arg);
+    std::unique_lock lock(state.mutex);
+    state.events.emplace_back(InputEvent { .type = "up", .contact = contact });
+    return true;
+}
+
+MaaBool scroll(int32_t dx, int32_t dy, void* trans_arg)
+{
+    auto& state = *static_cast<FakeController*>(trans_arg);
+    std::unique_lock lock(state.mutex);
+    state.events.emplace_back(InputEvent { .type = "scroll", .x = dx, .y = dy });
+    return true;
+}
+
+MaaBool get_info(void*, MaaStringBuffer* buffer)
+{
+    return MaaStringBufferSet(buffer, "{}");
+}
+
+MaaCustomControllerCallbacks callbacks()
+{
+    MaaCustomControllerCallbacks value {};
+    value.connect = connect;
+    value.connected = connected;
+    value.request_uuid = request_uuid;
+    value.get_features = get_features;
+    value.start_app = start_app;
+    value.screencap = screencap;
+    value.click = click;
+    value.swipe = swipe;
+    value.touch_down = touch_down;
+    value.touch_move = touch_move;
+    value.touch_up = touch_up;
+    value.scroll = scroll;
+    value.get_info = get_info;
+    return value;
+}
+
+bool set_alignment(MaaController* controller, MaaViewportAlignment alignment)
+{
+    return MaaControllerSetOption(controller, MaaCtrlOption_ScreenshotViewportAlignment, &alignment, sizeof(alignment));
+}
+
+std::string controller_info(MaaController* controller)
+{
+    MaaStringBuffer* buffer = MaaStringBufferCreate();
+    if (!buffer || !MaaControllerGetInfo(controller, buffer)) {
+        if (buffer) {
+            MaaStringBufferDestroy(buffer);
+        }
+        return {};
+    }
+    std::string result = MaaStringBufferGet(buffer);
+    MaaStringBufferDestroy(buffer);
+    return result;
+}
+
+bool has_json_integer(const std::string& value, std::string_view key, int expected)
+{
+    const std::string compact = std::string("\"") + std::string(key) + "\":" + std::to_string(expected);
+    const std::string spaced = std::string("\"") + std::string(key) + "\": " + std::to_string(expected);
+    return value.find(compact) != std::string::npos || value.find(spaced) != std::string::npos;
+}
+
+InputEvent last_event(FakeController& state)
+{
+    std::unique_lock lock(state.mutex);
+    return state.events.empty() ? InputEvent {} : state.events.back();
+}
+
+std::vector<InputEvent> events_since(FakeController& state, size_t offset)
+{
+    std::unique_lock lock(state.mutex);
+    if (offset >= state.events.size()) {
+        return {};
+    }
+    return { state.events.begin() + static_cast<std::ptrdiff_t>(offset), state.events.end() };
+}
+
+size_t event_count(FakeController& state)
+{
+    std::unique_lock lock(state.mutex);
+    return state.events.size();
+}
+
+size_t succeeded_touch_callback_count(FakeController& state, size_t offset)
+{
+    std::unique_lock lock(state.mutex);
+    if (offset >= state.controller_callbacks.size()) {
+        return 0;
+    }
+    size_t count = 0;
+    for (auto iter = state.controller_callbacks.begin() + static_cast<std::ptrdiff_t>(offset);
+         iter != state.controller_callbacks.end(); ++iter) {
+        if (iter->find("Controller.Action.Succeeded") != std::string::npos
+            && (iter->find("\"action\":\"touch_down\"") != std::string::npos
+                || iter->find("\"action\":\"touch_up\"") != std::string::npos)) {
+            ++count;
+        }
+    }
+    return count;
+}
+
+void set_resolution(FakeController& state, int width, int height)
+{
+    std::unique_lock lock(state.mutex);
+    state.width = width;
+    state.height = height;
+    state.pixels.assign(static_cast<size_t>(width) * height * 3, 0);
+}
+
+std::pair<int, int> cached_image_size(MaaController* controller)
+{
+    MaaImageBuffer* buffer = MaaImageBufferCreate();
+    if (!buffer || !MaaControllerCachedImage(controller, buffer)) {
+        if (buffer) {
+            MaaImageBufferDestroy(buffer);
+        }
+        return {};
+    }
+    const std::pair result { MaaImageBufferWidth(buffer), MaaImageBufferHeight(buffer) };
+    MaaImageBufferDestroy(buffer);
+    return result;
+}
+
+void test_controller_contract()
+{
+#ifdef _WIN32
+    _putenv_s("MAA_SCREENSHOT_VIEWPORT", "1280x720:adaptive");
+#else
+    setenv("MAA_SCREENSHOT_VIEWPORT", "1280x720:adaptive", 1);
+#endif
+
+    FakeController state;
+    auto callback_table = callbacks();
+    MaaController* controller = MaaCustomControllerCreate(&callback_table, &state);
+    check(controller != nullptr, "create custom controller");
+    if (!controller) {
+        return;
+    }
+    const MaaSinkId controller_sink = MaaControllerAddSink(controller, controller_event, &state);
+    check(controller_sink != MaaInvalidId, "add controller event sink");
+
+    check(MaaControllerWait(controller, MaaControllerPostConnection(controller)) == MaaStatus_Succeeded, "connect custom controller");
+
+    MaaViewportAlignment invalid = 99;
+    check(!set_alignment(controller, MaaViewportAlignment_Center), "alignment requires a raw frame");
+    check(!set_alignment(controller, invalid), "unknown alignment is rejected");
+    check(
+        !MaaControllerSetOption(controller, MaaCtrlOption_ScreenshotViewportAlignment, &invalid, sizeof(int16_t)),
+        "invalid alignment option size is rejected");
+
+    check(MaaControllerWait(controller, MaaControllerPostScreencap(controller)) == MaaStatus_Succeeded, "initial screencap");
+    const std::string first_info = controller_info(controller);
+    check(has_json_integer(first_info, "frame_id", 1), "first raw frame has frame id 1");
+    check(first_info.find("available_alignments") != std::string::npos, "controller info exposes available alignments");
+
+    check(set_alignment(controller, MaaViewportAlignment_Left), "select left viewport");
+    check(has_json_integer(controller_info(controller), "frame_id", 1), "alignment switch does not increment frame id");
+
+    {
+        std::unique_lock lock(state.mutex);
+        state.block_start = true;
+    }
+    const MaaCtrlId blocker = MaaControllerPostStartApp(controller, "viewport-test-blocker");
+    {
+        std::unique_lock lock(state.mutex);
+        state.condition.wait(lock, [&]() { return state.start_entered; });
+    }
+    const MaaCtrlId queued_click = MaaControllerPostClick(controller, 0, 0);
+    check(set_alignment(controller, MaaViewportAlignment_Right), "switch to right while click is queued");
+    {
+        std::unique_lock lock(state.mutex);
+        state.release_start = true;
+        state.condition.notify_all();
+    }
+    check(MaaControllerWait(controller, blocker) == MaaStatus_Succeeded, "blocking action completes");
+    check(MaaControllerWait(controller, queued_click) == MaaStatus_Succeeded, "queued click completes");
+    check(last_event(state).type == "click" && last_event(state).x == 0, "queued click keeps left alignment snapshot");
+
+    check(set_alignment(controller, MaaViewportAlignment_Left), "select left for contact 1");
+    check(MaaControllerWait(controller, MaaControllerPostTouchDown(controller, 1, 0, 100, 1)) == MaaStatus_Succeeded, "contact 1 down");
+    check(set_alignment(controller, MaaViewportAlignment_Right), "select right after contact 1 down");
+    check(MaaControllerWait(controller, MaaControllerPostTouchMove(controller, 1, 0, 100, 1)) == MaaStatus_Succeeded, "contact 1 move");
+    check(last_event(state).type == "move" && last_event(state).x == 0, "touch move keeps contact alignment");
+    check(MaaControllerWait(controller, MaaControllerPostTouchUp(controller, 1)) == MaaStatus_Succeeded, "contact 1 up");
+    check(
+        MaaControllerWait(controller, MaaControllerPostTouchMove(controller, 1, 0, 100, 1)) == MaaStatus_Succeeded,
+        "hover move after touch up");
+    check(last_event(state).type == "move" && last_event(state).x == 560, "touch up clears contact alignment");
+
+    size_t callback_offset = 0;
+    {
+        std::unique_lock lock(state.mutex);
+        callback_offset = state.controller_callbacks.size();
+    }
+    constexpr int FastTouchIterations = 64;
+    for (int index = 0; index != FastTouchIterations; ++index) {
+        check(
+            MaaControllerWait(controller, MaaControllerPostTouchDown(controller, 3, 640, 360, 1))
+                == MaaStatus_Succeeded,
+            "fast contact down succeeds");
+        check(
+            MaaControllerWait(controller, MaaControllerPostTouchUp(controller, 3)) == MaaStatus_Succeeded,
+            "fast contact up succeeds");
+    }
+    check(
+        succeeded_touch_callback_count(state, callback_offset) == FastTouchIterations * 2,
+        "zero-duration focused actions never outrun callback registration");
+
+    check(
+        MaaControllerWait(controller, MaaControllerPostSwipe(controller, 0, 0, 1279, 719, 200)) == MaaStatus_Succeeded,
+        "right-aligned swipe");
+    check(last_event(state).type == "swipe_end" && last_event(state).x == 2798, "swipe end uses right alignment");
+
+    {
+        std::unique_lock lock(state.mutex);
+        state.features = MaaControllerFeature_UseMouseDownAndUpInsteadOfClick;
+    }
+    MaaResource* resource = MaaResourceCreate();
+    MaaTasker* tasker = MaaTaskerCreate();
+    check(resource != nullptr && MaaResourceClear(resource), "create an empty valid resource for direct action tests");
+    check(
+        tasker != nullptr && MaaTaskerBindResource(tasker, resource) && MaaTaskerBindController(tasker, controller),
+        "bind direct action tasker");
+    if (tasker && MaaTaskerInited(tasker)) {
+        const size_t multi_swipe_offset = event_count(state);
+        const MaaRect reco_box {};
+        const char* action_param = R"({
+            "swipes": [{
+                "begin": [0, 100],
+                "end": [[100, 100], [200, 100]],
+                "end_hold": [30, 0],
+                "duration": [1, 1],
+                "contact": 2,
+                "pressure": 1
+            }]
+        })";
+        const MaaTaskId action_id = MaaTaskerPostAction(tasker, "MultiSwipe", action_param, &reco_box, "{}");
+        check(action_id != MaaInvalidId && MaaTaskerWait(tasker, action_id) == MaaStatus_Succeeded, "segmented multi swipe succeeds");
+        const auto multi_swipe_events = events_since(state, multi_swipe_offset);
+        check(multi_swipe_events.size() == 4, "segmented swipe emits one down, exact endpoints, and one up");
+        if (multi_swipe_events.size() == 4) {
+            check(
+                multi_swipe_events[0].type == "down" && multi_swipe_events[0].contact == 2 && multi_swipe_events[0].x == 560,
+                "segmented swipe starts at the selected right viewport");
+            check(
+                multi_swipe_events[1].type == "move" && multi_swipe_events[1].x == 735 && multi_swipe_events[2].type == "move"
+                    && multi_swipe_events[2].x == 910,
+                "short segments still emit both exact endpoints without lifting between them");
+            check(
+                multi_swipe_events[2].at - multi_swipe_events[1].at >= std::chrono::milliseconds(25),
+                "segment end_hold delays the following segment");
+            check(multi_swipe_events[3].type == "up" && multi_swipe_events[3].contact == 2, "touch lifts only after the final segment");
+        }
+    }
+    if (tasker) {
+        MaaTaskerDestroy(tasker);
+    }
+    if (resource) {
+        MaaResourceDestroy(resource);
+    }
+
+    const size_t scroll_offset = event_count(state);
+    check(MaaControllerWait(controller, MaaControllerPostScroll(controller, 120, -240)) == MaaStatus_Succeeded, "right-aligned scroll");
+    const auto scroll_events = events_since(state, scroll_offset);
+    check(
+        scroll_events.size() == 2 && scroll_events[0].type == "move" && scroll_events[0].x == 560 && scroll_events[1].type == "scroll"
+            && scroll_events[1].x == 120 && scroll_events[1].y == -240,
+        "scroll cursor position uses queued alignment while deltas stay unscaled");
+
+    check(MaaControllerWait(controller, MaaControllerPostScreencap(controller)) == MaaStatus_Succeeded, "second screencap");
+    check(has_json_integer(controller_info(controller), "frame_id", 2), "new raw frame increments frame id");
+
+    set_resolution(state, 1260, 2800);
+    check(MaaControllerWait(controller, MaaControllerPostScreencap(controller)) == MaaStatus_Succeeded, "portrait screencap");
+    check(!set_alignment(controller, MaaViewportAlignment_Left), "portrait frame rejects left alignment");
+    check(set_alignment(controller, MaaViewportAlignment_Center), "portrait frame accepts center alignment");
+    check(cached_image_size(controller) != std::pair { 1280, 720 }, "portrait frame is not reported as a landscape viewport");
+
+    set_resolution(state, 2400, 1080);
+    check(
+        MaaControllerWait(controller, MaaControllerPostScreencap(controller)) == MaaStatus_Succeeded,
+        "landscape screencap after portrait");
+    check(cached_image_size(controller) == std::pair { 1280, 720 }, "landscape transition restores logical viewport");
+    check(set_alignment(controller, MaaViewportAlignment_Right), "landscape transition restores adaptive alignments");
+    check(has_json_integer(controller_info(controller), "frame_id", 4), "orientation transitions preserve monotonic frame ids");
+
+    MaaControllerDestroy(controller);
+}
+} // namespace
+
+int main()
+{
+    test_controller_contract();
+    if (failures != 0) {
+        std::cerr << failures << " viewport controller checks failed\n";
+        return EXIT_FAILURE;
+    }
+    std::cout << "viewport controller checks passed\n";
+    return EXIT_SUCCESS;
+}
