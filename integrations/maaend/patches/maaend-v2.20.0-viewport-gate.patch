@@ -0,0 +1,119 @@
+package viewportprobe
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"time"
+
+	"github.com/MaaXYZ/MaaEnd/agent/go-service/pkg/viewport"
+	maa "github.com/MaaXYZ/maa-framework-go/v4"
+	"github.com/rs/zerolog/log"
+)
+
+const (
+	component       = "viewport_input_probe"
+	joystickContact = int32(0)
+	cameraContact   = int32(1)
+	joystickX       = int32(195)
+	joystickY       = int32(551)
+	cameraX         = int32(640)
+	cameraY         = int32(264)
+	cameraDeltaX    = int32(24)
+)
+
+type inputSession interface {
+	PreferredLabel(context.Context, maa.ViewportAlignment) (viewport.Frame, error)
+	TouchDown(context.Context, viewport.Frame, int32, int32, int32, int32) error
+	TouchMove(context.Context, viewport.Frame, int32, int32, int32, int32) error
+	TouchUp(context.Context, int32) error
+}
+
+type inputEvidence struct {
+	left  viewport.Frame
+	right viewport.Frame
+}
+
+func runInputProbe(ctx context.Context, session inputSession) (inputEvidence, error) {
+	left, err := session.PreferredLabel(ctx, maa.ViewportAlignmentLeft)
+	if err != nil {
+		return inputEvidence{}, fmt.Errorf("label left viewport: %w", err)
+	}
+	if err := session.TouchDown(ctx, left, joystickContact, joystickX, joystickY, 1); err != nil {
+		return inputEvidence{}, fmt.Errorf("joystick center down: %w", err)
+	}
+	if err := session.TouchUp(ctx, joystickContact); err != nil {
+		return inputEvidence{}, fmt.Errorf("joystick center up: %w", err)
+	}
+
+	right, err := session.PreferredLabel(ctx, maa.ViewportAlignmentRight)
+	if err != nil {
+		return inputEvidence{}, fmt.Errorf("label right viewport: %w", err)
+	}
+	if err := session.TouchDown(ctx, right, cameraContact, cameraX, cameraY, 0); err != nil {
+		return inputEvidence{}, fmt.Errorf("camera down: %w", err)
+	}
+	moveOutErr := session.TouchMove(ctx, right, cameraContact, cameraX+cameraDeltaX, cameraY, 0)
+	moveBackErr := session.TouchMove(ctx, right, cameraContact, cameraX, cameraY, 0)
+	upErr := session.TouchUp(ctx, cameraContact)
+	if err := errors.Join(moveOutErr, moveBackErr, upErr); err != nil {
+		return inputEvidence{}, fmt.Errorf("camera reversible swipe: %w", err)
+	}
+	return inputEvidence{left: left, right: right}, nil
+}
+
+type InputProbeAction struct{}
+
+var _ maa.CustomActionRunner = &InputProbeAction{}
+
+func (a *InputProbeAction) Run(ctx *maa.Context, _ *maa.CustomActionArg) bool {
+	if ctx == nil || ctx.GetTasker() == nil || ctx.GetTasker().GetController() == nil {
+		log.Error().Str("component", component).Msg("ViewportInputProbe: controller unavailable")
+		return false
+	}
+	session, err := viewport.New(ctx.GetTasker().GetController())
+	if err != nil {
+		log.Error().Err(err).Str("component", component).Msg("ViewportInputProbe: session failed")
+		return false
+	}
+	probeCtx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	defer func() {
+		if err := session.ReleaseTouches(context.Background()); err != nil {
+			log.Error().Err(err).Str("component", component).Msg("ViewportInputProbe: touch cleanup failed")
+		}
+	}()
+
+	evidence, err := runInputProbe(probeCtx, session)
+	if err != nil {
+		log.Error().Err(err).Str("component", component).Msg("ViewportInputProbe: failed")
+		return false
+	}
+	log.Info().
+		Str("component", component).
+		Str("phase", "joystick_center_released").
+		Str("alignment", alignmentName(evidence.left.Alignment)).
+		Uint64("frame_id", evidence.left.FrameID).
+		Int32("contact", joystickContact).
+		Msg("ViewportInputProbe: joystick verified")
+	log.Info().
+		Str("component", component).
+		Str("phase", "camera_reversed").
+		Str("alignment", alignmentName(evidence.right.Alignment)).
+		Uint64("frame_id", evidence.right.FrameID).
+		Int32("contact", cameraContact).
+		Bool("reversed", true).
+		Msg("ViewportInputProbe: done")
+	return true
+}
+
+func alignmentName(alignment maa.ViewportAlignment) string {
+	switch alignment {
+	case maa.ViewportAlignmentLeft:
+		return "left"
+	case maa.ViewportAlignmentRight:
+		return "right"
+	default:
+		return "center"
+	}
+}
