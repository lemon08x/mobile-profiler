+
+func parseCompatibleScreenshotViewport(info string, width, height int32) (screenshotViewportInfo, error) {
+	viewport, err := parseScreenshotViewport(info)
+	if err != nil {
+		return screenshotViewportInfo{}, err
+	}
+
+	if !viewport.Configured || !viewport.Active {
+		return screenshotViewportInfo{}, fmt.Errorf("screenshot viewport is not configured and active")
+	}
+	if err := validateScreenshotViewportIdentity(viewport, width, height); err != nil {
+		return screenshotViewportInfo{}, err
+	}
+	if viewport.X < 0 || viewport.Y < 0 || viewport.Width <= 0 || viewport.Height <= 0 ||
+		viewport.X+viewport.Width > viewport.RawWidth || viewport.Y+viewport.Height > viewport.RawHeight {
+		return screenshotViewportInfo{}, fmt.Errorf("screenshot viewport is outside the raw image")
+	}
+	if width < height || viewport.Width < targetWidth || viewport.Height < targetHeight {
+		return screenshotViewportInfo{}, fmt.Errorf("active screenshot viewport does not provide a landscape 1280x720 source")
+	}
+	if !isAspectRatio16x9(viewport.Width, viewport.Height) {
+		return screenshotViewportInfo{}, fmt.Errorf(
+			"screenshot viewport size %dx%d is not 16:9",
+			viewport.Width,
+			viewport.Height,
+		)
+	}
+	if !isAspectRatio16x9(int(width), int(height)) && (viewport.Mode != "adaptive" || !viewport.Adaptive) {
+		return screenshotViewportInfo{}, fmt.Errorf("non-16:9 ADB resolution requires an adaptive screenshot viewport")
+	}
+
+	return viewport, nil
+}
+
+func parseCompatiblePortraitLaunchViewport(info string, width, height int32) (screenshotViewportInfo, error) {
+	viewport, err := parseScreenshotViewport(info)
+	if err != nil {
+		return screenshotViewportInfo{}, err
+	}
+	if !viewport.Configured || viewport.Active {
+		return screenshotViewportInfo{}, fmt.Errorf("portrait launch requires a configured but inactive screenshot viewport")
+	}
+	if err := validateScreenshotViewportIdentity(viewport, width, height); err != nil {
+		return screenshotViewportInfo{}, err
+	}
+	if viewport.Mode != "adaptive" {
+		return screenshotViewportInfo{}, fmt.Errorf("portrait launch requires adaptive screenshot viewport mode")
+	}
+	if width >= height {
+		return screenshotViewportInfo{}, fmt.Errorf("portrait launch requires portrait controller resolution")
+	}
+	if int(height) < targetWidth || int(width) < targetHeight {
+		return screenshotViewportInfo{}, fmt.Errorf(
+			"rotated controller resolution %dx%d is smaller than %dx%d",
+			height,
+			width,
+			targetWidth,
+			targetHeight,
+		)
+	}
+
+	return viewport, nil
+}
+
+func isPortraitLaunchTransitionEntry(entry string) bool {
+	return entry == androidOpenGameEntry
+}
+
+func parseScreenshotViewport(info string) (screenshotViewportInfo, error) {
+	if strings.TrimSpace(info) == "" {
+		return screenshotViewportInfo{}, fmt.Errorf("controller info is empty")
+	}
+
+	var parsed controllerViewportInfo
+	if err := json.Unmarshal([]byte(info), &parsed); err != nil {
+		return screenshotViewportInfo{}, fmt.Errorf("parse controller info: %w", err)
+	}
+	if parsed.ScreenshotViewport == nil {
+		return screenshotViewportInfo{}, fmt.Errorf("controller does not report screenshot_viewport capability")
+	}
+	return *parsed.ScreenshotViewport, nil
+}
+
+func validateScreenshotViewportIdentity(viewport screenshotViewportInfo, width, height int32) error {
+	if viewport.LogicalWidth != targetWidth || viewport.LogicalHeight != targetHeight {
+		return fmt.Errorf(
+			"screenshot viewport logical size is %dx%d, want %dx%d",
+			viewport.LogicalWidth,
+			viewport.LogicalHeight,
+			targetWidth,
+			targetHeight,
+		)
+	}
+	if viewport.RawWidth != int(width) || viewport.RawHeight != int(height) {
+		return fmt.Errorf(
+			"screenshot viewport raw size is %dx%d, controller resolution is %dx%d",
+			viewport.RawWidth,
+			viewport.RawHeight,
+			width,
+			height,
+		)
+	}
+	return nil
+}
+
+func (c *AspectRatioChecker) OnNodePipelineNode(ctx *maa.Context, event maa.EventStatus, detail maa.NodePipelineNodeDetail) {
+	if event != maa.EventStatusStarting {
+		return
+	}
+
+	transition, ok := c.getPortraitTransition(detail.TaskID)
+	if !ok {
+		return
+	}
+
+	if !transition.chainValidated {
+		if detail.Name != androidOpenGameEntry {
+			c.failPortraitTransition(ctx, detail, fmt.Errorf("first pipeline node is %q, want %q", detail.Name, androidOpenGameEntry))
+			return
+		}
+
+		launchNode, err := validateAndroidOpenGameLaunchChain(ctx)
+		if err != nil {
+			c.failPortraitTransition(ctx, detail, err)
+			return
+		}
+		c.markPortraitTransitionValidated(detail.TaskID, launchNode)
+		log.Info().
+			Uint64("task_id", detail.TaskID).
+			Str("entry", androidOpenGameEntry).
+			Str("launch_node", launchNode).
+			Msg("validated coordinate-free Android launch chain")
+		return
+	}
+
+	if detail.Name == androidOpenGameEntry || detail.Name == transition.launchNode {
+		return
+	}
+	if detail.Name != androidOpenGameGateNode {
+		c.failPortraitTransition(ctx, detail, fmt.Errorf("pipeline reached %q before the landscape viewport gate", detail.Name))
+		return
+	}
+
+	controller := ctx.GetTasker().GetController()
+	viewport, err := waitForCompatibleScreenshotViewport(controller)
+	if err != nil {
+		c.failPortraitTransition(ctx, detail, err)
+		return
+	}
+
+	c.clearPortraitTransition(detail.TaskID)
+	log.Info().
+		Uint64("task_id", detail.TaskID).
+		Str("entry", androidOpenGameEntry).
+		Str("gate_node", detail.Name).
+		Int("raw_width", viewport.RawWidth).
+		Int("raw_height", viewport.RawHeight).
+		Int("viewport_x", viewport.X).
+		Int("viewport_y", viewport.Y).
+		Int("viewport_width", viewport.Width).
+		Int("viewport_height", viewport.Height).
+		Msg("landscape screenshot viewport activated; continuing AndroidOpenGame")
+}
