+
+// Session serializes alignment selection with cache access and coordinate actions.
+type Session struct {
+	backend backend
+	touchMu sync.Mutex
+	touches map[int32]Frame
+}
+
+func New(controller *maa.Controller) (*Session, error) {
+	if controller == nil {
+		return nil, errors.New("nil controller")
+	}
+	return newSession(&maaBackend{controller: controller}), nil
+}
+
+// CaptureController is the audited one-shot entry point for screenshot-only callers.
+// Stateful recognition/input flows should keep a Session and pass the returned Frame to
+// the corresponding action instead of discarding its alignment evidence.
+func CaptureController(ctx context.Context, controller *maa.Controller, alignment maa.ViewportAlignment, refresh bool) (Frame, error) {
+	session, err := New(controller)
+	if err != nil {
+		return Frame{}, err
+	}
+	return session.Capture(ctx, alignment, refresh)
+}
+
+func newSession(value backend) *Session {
+	return &Session{backend: value, touches: make(map[int32]Frame)}
+}
+
+// PreferredAlignmentForROI uses the same 5/16 edge bands as MaaFramework.
+func PreferredAlignmentForROI(roi image.Rectangle, logicalWidth int) maa.ViewportAlignment {
+	if logicalWidth <= 0 {
+		logicalWidth = 1280
+	}
+	centerX := roi.Min.X + roi.Dx()/2
+	edgeBand := logicalWidth * 5 / 16
+	if centerX < edgeBand {
+		return maa.ViewportAlignmentLeft
+	}
+	if centerX >= logicalWidth-edgeBand {
+		return maa.ViewportAlignmentRight
+	}
+	return maa.ViewportAlignmentCenter
+}
+
+// Capture refreshes at most one raw screenshot and returns its selected logical viewport.
+func (s *Session) Capture(ctx context.Context, alignment maa.ViewportAlignment, refresh bool) (Frame, error) {
+	if !validAlignment(alignment) {
+		return Frame{}, fmt.Errorf("%w: invalid alignment %d", ErrInvalidFrame, alignment)
+	}
+	controllerSessionLock.Lock()
+	defer controllerSessionLock.Unlock()
+	return s.captureLocked(ctx, alignment, refresh)
+}
+
+func (s *Session) CaptureROI(ctx context.Context, roi image.Rectangle, refresh bool) (Frame, error) {
+	controllerSessionLock.Lock()
+	info, err := s.backend.info()
+	controllerSessionLock.Unlock()
+	if err != nil {
+		return Frame{}, err
+	}
+	logicalWidth := info.Logical.Width
+	if logicalWidth == 0 {
+		logicalWidth = 1280
+	}
+	alignment := PreferredAlignmentForROI(roi, logicalWidth)
+	if !alignmentAvailable(info, alignment) {
+		alignment = maa.ViewportAlignmentCenter
+	}
+	return s.Capture(ctx, alignment, refresh)
+}
+
+// CaptureCandidates renders Center, Left, and Right from one raw frame. Unsupported duplicate
+// alignments are omitted, so a standard 16:9 device returns Center only.
+func (s *Session) CaptureCandidates(ctx context.Context, refresh bool) (_ []Frame, result error) {
+	controllerSessionLock.Lock()
+	defer controllerSessionLock.Unlock()
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	before, err := s.backend.info()
+	if err != nil && !errors.Is(err, ErrUnsupportedRuntime) {
+		return nil, err
+	}
+	previous := alignmentFromInfo(before)
+	if refresh {
+		if err := s.backend.screencap(); err != nil {
+			return nil, err
+		}
+	}
+	defer func() {
+		if err := s.backend.setAlignment(previous); err != nil {
+			result = errors.Join(result, fmt.Errorf("restore viewport alignment: %w", err))
+		}
+	}()
+
+	var frames []Frame
+	var frameID uint64
+	for _, alignment := range []maa.ViewportAlignment{
+		maa.ViewportAlignmentCenter,
+		maa.ViewportAlignmentLeft,
+		maa.ViewportAlignmentRight,
+	} {
+		info, infoErr := s.backend.info()
+		if infoErr != nil {
+			return nil, infoErr
+		}
+		if !alignmentAvailable(info, alignment) {
+			continue
+		}
+		if err := s.backend.setAlignment(alignment); err != nil {
+			return nil, err
+		}
+		img, err := s.backend.cacheImage()
+		if err != nil {
+			return nil, err
+		}
+		info, err = s.backend.info()
+		if err != nil {
+			return nil, err
+		}
+		frame, err := makeFrame(img, alignment, info, true)
+		if err != nil {
+			return nil, err
+		}
+		if frameID == 0 {
+			frameID = frame.FrameID
+		} else if frame.FrameID != frameID {
+			return nil, fmt.Errorf("candidate viewport changed raw frame: %d != %d", frame.FrameID, frameID)
+		}
+		frames = append(frames, frame)
+	}
+	if len(frames) == 0 {
+		return nil, ErrInvalidFrame
+	}
+	return frames, nil
+}
+
+// Label returns a non-image coordinate label for fixed semantic inputs such as a joystick or
+// camera region. It remains usable across later screenshots but still carries an auditable frame ID.
+func (s *Session) Label(ctx context.Context, alignment maa.ViewportAlignment) (Frame, error) {
+	if err := ctx.Err(); err != nil {
+		return Frame{}, err
+	}
+	controllerSessionLock.Lock()
+	defer controllerSessionLock.Unlock()
+	info, err := s.backend.info()
+	if err != nil {
+		return Frame{}, err
+	}
+	if info.FrameID == 0 || !alignmentAvailable(info, alignment) {
+		return Frame{}, ErrInvalidFrame
+	}
+	return Frame{Alignment: alignment, FrameID: info.FrameID, Info: info, strict: false}, nil
+}
+
+// PreferredLabel selects the preferred semantic viewport on adaptive displays and
+// transparently uses Center on a standard display. It does not weaken the public
+// controller option: explicitly setting Left/Right on a non-adaptive controller still fails.
+func (s *Session) PreferredLabel(ctx context.Context, preferred maa.ViewportAlignment) (Frame, error) {
+	if !validAlignment(preferred) {
+		return Frame{}, ErrInvalidFrame
+	}
+	if err := ctx.Err(); err != nil {
+		return Frame{}, err
+	}
+	controllerSessionLock.Lock()
+	defer controllerSessionLock.Unlock()
+	info, err := s.backend.info()
+	if err != nil {
+		return Frame{}, err
+	}
+	alignment := preferred
+	if !alignmentAvailable(info, alignment) {
+		if info.Adaptive || !alignmentAvailable(info, maa.ViewportAlignmentCenter) {
+			return Frame{}, ErrInvalidFrame
+		}
+		alignment = maa.ViewportAlignmentCenter
+	}
+	if info.FrameID == 0 {
+		return Frame{}, ErrInvalidFrame
+	}
+	return Frame{Alignment: alignment, FrameID: info.FrameID, Info: info, strict: false}, nil
+}
+
+func (s *Session) Click(ctx context.Context, frame Frame, x, y int32) error {
+	return s.withFrame(ctx, frame, func() error { return s.backend.click(x, y) })
+}
+
+func (s *Session) Swipe(
+	ctx context.Context,
+	frame Frame,
+	x1, y1, x2, y2 int32,
+	duration time.Duration,
+	contact, pressure int32,
+) error {
+	return s.withFrame(ctx, frame, func() error {
+		return s.backend.swipe(x1, y1, x2, y2, duration, contact, pressure)
+	})
+}
+
+func (s *Session) TouchDown(ctx context.Context, frame Frame, contact, x, y, pressure int32) error {
+	err := s.withFrame(ctx, frame, func() error { return s.backend.touchDown(contact, x, y, pressure) })
+	if err == nil {
+		s.touchMu.Lock()
+		s.touches[contact] = frame
+		s.touchMu.Unlock()
+	}
+	return err
+}
+
+func (s *Session) TouchMove(ctx context.Context, frame Frame, contact, x, y, pressure int32) error {
+	s.touchMu.Lock()
+	if active, ok := s.touches[contact]; ok {
+		frame = active
+		frame.strict = false
+	}
+	s.touchMu.Unlock()
+	return s.withFrame(ctx, frame, func() error { return s.backend.touchMove(contact, x, y, pressure) })
+}
+
+func (s *Session) TouchUp(ctx context.Context, contact int32) error {
+	ctxErr := ctx.Err()
+	s.touchMu.Lock()
+	active, hasActive := s.touches[contact]
+	s.touchMu.Unlock()
+
+	controllerSessionLock.Lock()
+	info, infoErr := s.backend.info()
+	var selectErr error
+	if hasActive {
+		selectErr = s.backend.setAlignment(active.Alignment)
+	}
+	actionErr := s.backend.touchUp(contact)
+	var restoreErr error
+	if infoErr == nil {
+		if err := s.backend.setAlignment(alignmentFromInfo(info)); err != nil {
+			restoreErr = fmt.Errorf("restore viewport alignment: %w", err)
+		}
+	}
+	controllerSessionLock.Unlock()
+
+	s.touchMu.Lock()
+	delete(s.touches, contact)
+	s.touchMu.Unlock()
+	return errors.Join(ctxErr, infoErr, selectErr, actionErr, restoreErr)
+}
+
+func (s *Session) Scroll(ctx context.Context, frame Frame, dx, dy int32) error {
+	return s.withFrame(ctx, frame, func() error { return s.backend.scroll(dx, dy) })
+}
+
+// ReleaseTouches releases all contacts started through this session. Callers should defer it
+// around long-running input loops so cancellation and panic paths cannot leave contacts active.
+func (s *Session) ReleaseTouches(ctx context.Context) error {
+	s.touchMu.Lock()
+	contacts := make([]int32, 0, len(s.touches))
+	for contact := range s.touches {
+		contacts = append(contacts, contact)
+	}
+	s.touchMu.Unlock()
+
+	result := ctx.Err()
+	for _, contact := range contacts {
+		if err := s.TouchUp(context.Background(), contact); err != nil {
+			result = errors.Join(result, err)
+		}
+	}
+	return result
+}
+
+func (s *Session) captureLocked(ctx context.Context, alignment maa.ViewportAlignment, refresh bool) (_ Frame, result error) {
+	if err := ctx.Err(); err != nil {
+		return Frame{}, err
+	}
+	before, err := s.backend.info()
+	if err != nil && !errors.Is(err, ErrUnsupportedRuntime) {
+		return Frame{}, err
+	}
+	previous := alignmentFromInfo(before)
+	if refresh {
+		if err := s.backend.screencap(); err != nil {
+			return Frame{}, err
+		}
+	}
+	defer func() {
+		if err := s.backend.setAlignment(previous); err != nil {
+			result = errors.Join(result, fmt.Errorf("restore viewport alignment: %w", err))
+		}
+	}()
+	if err := s.backend.setAlignment(alignment); err != nil {
+		return Frame{}, err
+	}
+	img, err := s.backend.cacheImage()
+	if err != nil {
+		return Frame{}, err
+	}
+	info, err := s.backend.info()
+	if err != nil {
+		return Frame{}, err
+	}
+	return makeFrame(img, alignment, info, true)
+}
+
+func (s *Session) withFrame(ctx context.Context, frame Frame, action func() error) (result error) {
+	if !frame.Valid() {
+		return ErrInvalidFrame
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	controllerSessionLock.Lock()
+	defer controllerSessionLock.Unlock()
+	info, err := s.backend.info()
+	if err != nil {
+		return err
+	}
+	if frame.strict && info.FrameID != frame.FrameID {
+		return fmt.Errorf("%w: current=%d recognized=%d", ErrStaleFrame, info.FrameID, frame.FrameID)
+	}
+	previous := alignmentFromInfo(info)
+	defer func() {
+		if err := s.backend.setAlignment(previous); err != nil {
+			result = errors.Join(result, fmt.Errorf("restore viewport alignment: %w", err))
+		}
+	}()
+	if err := s.backend.setAlignment(frame.Alignment); err != nil {
+		return err
+	}
+	return action()
+}
+
+func makeFrame(img image.Image, alignment maa.ViewportAlignment, info Info, strict bool) (Frame, error) {
+	if img == nil || info.FrameID == 0 {
+		return Frame{}, ErrInvalidFrame
+	}
+	expected := alignmentName(alignment)
+	if info.Alignment != expected || info.CachedAlignment != expected {
+		return Frame{}, fmt.Errorf(
+			"%w: selected=%q cached=%q expected=%q",
+			ErrInvalidFrame,
+			info.Alignment,
+			info.CachedAlignment,
+			expected,
+		)
+	}
+	if info.Logical.Width > 0 && (img.Bounds().Dx() != info.Logical.Width || img.Bounds().Dy() != info.Logical.Height) {
+		return Frame{}, fmt.Errorf(
+			"%w: image=%dx%d logical=%dx%d",
+			ErrInvalidFrame,
+			img.Bounds().Dx(),
+			img.Bounds().Dy(),
+			info.Logical.Width,
+			info.Logical.Height,
+		)
+	}
+	return Frame{Image: img, Alignment: alignment, FrameID: info.FrameID, Info: info, strict: strict}, nil
+}
+
+func validAlignment(alignment maa.ViewportAlignment) bool {
+	return alignment >= maa.ViewportAlignmentCenter && alignment <= maa.ViewportAlignmentRight
+}
+
+func alignmentName(alignment maa.ViewportAlignment) string {
+	switch alignment {
+	case maa.ViewportAlignmentLeft:
+		return "left"
+	case maa.ViewportAlignmentRight:
+		return "right"
+	default:
+		return "center"
+	}
+}
+
+func alignmentFromInfo(info Info) maa.ViewportAlignment {
+	switch info.Alignment {
+	case "left":
+		return maa.ViewportAlignmentLeft
+	case "right":
+		return maa.ViewportAlignmentRight
+	default:
+		return maa.ViewportAlignmentCenter
+	}
+}
+
+func alignmentAvailable(info Info, alignment maa.ViewportAlignment) bool {
+	if !validAlignment(alignment) {
+		return false
+	}
+	if len(info.AvailableAlignments) == 0 {
+		return alignment == maa.ViewportAlignmentCenter
+	}
+	expected := alignmentName(alignment)
+	for _, value := range info.AvailableAlignments {
+		if value == expected {
+			return true
+		}
+	}
+	return false
+}
