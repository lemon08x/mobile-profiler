+		t.Fatal(err)
+	}
+	if got := backend.actions[len(backend.actions)-1]; got != maa.ViewportAlignmentRight {
+		t.Fatalf("released contact moved with alignment=%d", got)
+	}
+}
+
+func TestTouchUpStillReleasesWhenContactAlignmentCannotBeSelected(t *testing.T) {
+	backend := newFakeBackend()
+	session := newSession(backend)
+	left, _ := session.Label(context.Background(), maa.ViewportAlignmentLeft)
+	right, _ := session.Label(context.Background(), maa.ViewportAlignmentRight)
+	if err := session.TouchDown(context.Background(), left, 4, 100, 100, 1); err != nil {
+		t.Fatal(err)
+	}
+	backend.reject = new(maa.ViewportAlignment)
+	*backend.reject = maa.ViewportAlignmentLeft
+	actionCount := len(backend.actions)
+	if err := session.TouchUp(context.Background(), 4); err == nil {
+		t.Fatal("expected alignment selection error")
+	}
+	if len(backend.actions) != actionCount+1 {
+		t.Fatalf("touch up was skipped: actions=%d, want %d", len(backend.actions), actionCount+1)
+	}
+	backend.reject = nil
+	if err := session.TouchMove(context.Background(), right, 4, 200, 100, 1); err != nil {
+		t.Fatal(err)
+	}
+	if got := backend.actions[len(backend.actions)-1]; got != maa.ViewportAlignmentRight {
+		t.Fatalf("failed touch up did not clear contact: alignment=%d", got)
+	}
+}
+
+func TestPanicStillRestoresAlignment(t *testing.T) {
+	backend := newFakeBackend()
+	backend.alignment = maa.ViewportAlignmentCenter
+	session := newSession(backend)
+	frame, _ := session.Label(context.Background(), maa.ViewportAlignmentRight)
+
+	func() {
+		defer func() { _ = recover() }()
+		_ = session.withFrame(context.Background(), frame, func() error {
+			panic("test panic")
+		})
+	}()
+	if backend.alignment != maa.ViewportAlignmentCenter {
+		t.Fatalf("alignment not restored after panic: %d", backend.alignment)
+	}
+}
