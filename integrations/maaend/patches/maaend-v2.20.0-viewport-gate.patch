diff --git a/agent/cpp-algo/source/MapLocator/MinimapExtractor.cpp b/agent/cpp-algo/source/MapLocator/MinimapExtractor.cpp
new file mode 100644
index 0000000..3e6ef6f
--- /dev/null
+++ b/agent/cpp-algo/source/MapLocator/MinimapExtractor.cpp
@@ -0,0 +1,233 @@
+#include "MinimapExtractor.h"
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <vector>
+
+#include <MaaUtils/Logger.h>
+
+#include "MapAlgorithm.h"
+#include "MapLocator.h"
+
+namespace maplocator
+{
+
+namespace
+{
+
+constexpr float kCalibrationConfidenceFloor = 0.70F;
+constexpr int kCoarseSearchStep = 40;
+constexpr int kMaximumPositiveShift = 240;
+constexpr std::array<int, 4> kRefinementOffsets { -20, -10, 10, 20 };
+
+struct Candidate
+{
+    int x = 0;
+    YoloCoarseResult coarse {};
+    bool expected_match = false;
+    bool heading_valid = false;
+    double heading = 0.0;
+};
+
+bool TryCrop(const cv::Mat& image, const MinimapRoiConfig& config, int x, cv::Mat* out)
+{
+    if (out == nullptr || image.empty()) {
+        return false;
+    }
+
+    const cv::Rect roi(x, config.y, config.width, config.height);
+    const cv::Rect bounds(0, 0, image.cols, image.rows);
+    const cv::Rect clipped = roi & bounds;
+    if (clipped != roi || roi.width <= 0 || roi.height <= 0) {
+        return false;
+    }
+
+    *out = image(roi).clone();
+    return !out->empty();
+}
+
+bool MatchesExpectedSelector(const std::string& expected, const YoloCoarseResult& coarse)
+{
+    if (expected.empty()) {
+        return true;
+    }
+    if (coarse.zone_id == expected || coarse.base_class == expected || coarse.raw_class == expected) {
+        return true;
+    }
+    return coarse.raw_class.starts_with(expected);
+}
+
+bool IsUsable(const YoloCoarseResult& coarse)
+{
+    return coarse.valid && !coarse.is_none && !coarse.zone_id.empty() && coarse.zone_id != "None"
+           && coarse.raw_class != "None" && std::isfinite(coarse.confidence)
+           && coarse.confidence >= kCalibrationConfidenceFloor;
+}
+
+bool IsBetter(const Candidate& candidate, const Candidate& best, bool expected_is_available)
+{
+    if (expected_is_available && candidate.expected_match != best.expected_match) {
+        return candidate.expected_match;
+    }
+    // The zone classifier can confidently identify an off-centre slice of the
+    // minimap even when the player arrow is outside the tiny heading sample.
+    // Prefer a candidate that satisfies both contracts before comparing YOLO
+    // confidence; otherwise a ten-pixel ROI drift silently destroys heading.
+    if (candidate.heading_valid != best.heading_valid) {
+        return candidate.heading_valid;
+    }
+    return candidate.coarse.confidence > best.coarse.confidence;
+}
+
+} // namespace
+
+bool AdaptiveMinimapExtractor::Extract(
+    const cv::Mat& image,
+    bool use_adb_minimap_roi,
+    bool allow_horizontal_calibration,
+    const std::string& expected_zone_selector,
+    MapLocator* locator,
+    cv::Mat* out_minimap,
+    MinimapExtractionDetails* out_details)
+{
+    if (out_minimap == nullptr || image.empty()) {
+        return false;
+    }
+
+    cv::Mat scaled_image = image;
+    if (use_adb_minimap_roi && kAdbMinimapFullImageScale != 1.0) {
+        cv::resize(image, scaled_image, cv::Size(), kAdbMinimapFullImageScale, kAdbMinimapFullImageScale, cv::INTER_AREA);
+    }
+
+    const MinimapRoiConfig& roi_config = GetMinimapRoiConfig(use_adb_minimap_roi);
+    if (!use_adb_minimap_roi || !allow_horizontal_calibration || locator == nullptr || !locator->isInitialized()) {
+        return TryCrop(scaled_image, roi_config, roi_config.x, out_minimap);
+    }
+
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (cached_scaled_size_.has_value() && cached_roi_x_.has_value() && cached_scaled_size_.value() == scaled_image.size()) {
+        if (TryCrop(scaled_image, roi_config, cached_roi_x_.value(), out_minimap)) {
+            if (out_details != nullptr) {
+                out_details->roi_x = cached_roi_x_.value();
+                out_details->roi_y = roi_config.y;
+                out_details->used_cached_roi = true;
+            }
+            return true;
+        }
+        InvalidateLocked();
+    }
+
+    std::vector<Candidate> candidates;
+    std::vector<int> attempted_x;
+    auto probe = [&](int x) {
+        if (std::find(attempted_x.begin(), attempted_x.end(), x) != attempted_x.end()) {
+            return;
+        }
+        cv::Mat minimap;
+        if (!TryCrop(scaled_image, roi_config, x, &minimap)) {
+            return;
+        }
+        attempted_x.push_back(x);
+        YoloCoarseResult coarse = locator->predictCoarse(minimap);
+        if (!IsUsable(coarse)) {
+            return;
+        }
+        const bool expected_match = MatchesExpectedSelector(expected_zone_selector, coarse);
+        const double heading = InferYellowArrowRotation(minimap);
+        const bool heading_valid = std::isfinite(heading) && heading >= 0.0;
+        candidates.push_back(Candidate {
+            .x = x,
+            .coarse = std::move(coarse),
+            .expected_match = expected_match,
+            .heading_valid = heading_valid,
+            .heading = heading_valid ? heading : 0.0,
+        });
+    };
+
+    probe(roi_config.x);
+    const bool fixed_is_expected = !candidates.empty() && candidates.front().expected_match;
+    if (!fixed_is_expected) {
+        const int maximum_x = std::min(scaled_image.cols - roi_config.width, roi_config.x + kMaximumPositiveShift);
+        probe(std::max(0, roi_config.x - kCoarseSearchStep));
+        for (int x = roi_config.x + kCoarseSearchStep; x <= maximum_x; x += kCoarseSearchStep) {
+            probe(x);
+        }
+    }
+
+    if (candidates.empty()) {
+        LogWarn << "Adaptive minimap calibration failed closed: no non-None candidate met the confidence floor."
+                << VAR(scaled_image.cols) << VAR(scaled_image.rows);
+        return false;
+    }
+
+    const bool expected_is_available = std::any_of(candidates.begin(), candidates.end(), [](const Candidate& row) {
+        return row.expected_match;
+    });
+    auto best_it = candidates.begin();
+    for (auto it = std::next(candidates.begin()); it != candidates.end(); ++it) {
+        if (IsBetter(*it, *best_it, expected_is_available)) {
+            best_it = it;
+        }
+    }
+
+    const int coarse_best_x = best_it->x;
+    for (int offset : kRefinementOffsets) {
+        probe(coarse_best_x + offset);
+    }
+
+    const bool refined_expected_is_available = std::any_of(candidates.begin(), candidates.end(), [](const Candidate& row) {
+        return row.expected_match;
+    });
+    best_it = candidates.begin();
+    for (auto it = std::next(candidates.begin()); it != candidates.end(); ++it) {
+        if (IsBetter(*it, *best_it, refined_expected_is_available)) {
+            best_it = it;
+        }
+    }
+
+    if (!TryCrop(scaled_image, roi_config, best_it->x, out_minimap)) {
+        return false;
+    }
+
+    cached_scaled_size_ = scaled_image.size();
+    cached_roi_x_ = best_it->x;
+    if (out_details != nullptr) {
+        out_details->roi_x = best_it->x;
+        out_details->roi_y = roi_config.y;
+        out_details->calibrated = true;
+        out_details->coarse = best_it->coarse;
+    }
+    LogInfo << "Adaptive minimap ROI calibrated." << VAR(best_it->x) << VAR(roi_config.y) << VAR(best_it->coarse.raw_class)
+            << VAR(best_it->coarse.zone_id) << VAR(best_it->coarse.confidence) << VAR(best_it->expected_match)
+            << VAR(best_it->heading_valid) << VAR(best_it->heading);
+    return true;
+}
+
+void AdaptiveMinimapExtractor::ObserveLocateResult(const LocateResult& result)
+{
+    if (result.coarse_was_none || result.status == LocateStatus::YoloFailed) {
+        Invalidate();
+    }
+}
+
+void AdaptiveMinimapExtractor::ObserveCoarseResult(const YoloCoarseResult& result)
+{
+    if (!result.valid || result.is_none || result.zone_id.empty() || result.zone_id == "None") {
+        Invalidate();
+    }
+}
+
+void AdaptiveMinimapExtractor::Invalidate()
+{
+    std::lock_guard<std::mutex> lock(mutex_);
+    InvalidateLocked();
+}
+
+void AdaptiveMinimapExtractor::InvalidateLocked()
+{
+    cached_scaled_size_.reset();
+    cached_roi_x_.reset();
+}
+
+} // namespace maplocator
