+#pragma once
+
+#include <cstdint>
+#include <map>
+#include <optional>
+
+#include <MaaFramework/MaaAPI.h>
+#include <MaaUtils/NoWarningCV.hpp>
+
+namespace maaend::viewport
+{
+
+bool UseHeadlessAdaptiveContract();
+
+struct ViewportInfo
+{
+    bool adaptive = false;
+    MaaViewportAlignment alignment = MaaViewportAlignment_Center;
+    MaaViewportAlignment cached_alignment = MaaViewportAlignment_Center;
+    std::uint64_t frame_id = 0;
+    bool center_available = false;
+    bool left_available = false;
+    bool right_available = false;
+};
+
+struct ViewportFrame
+{
+    cv::Mat image;
+    MaaViewportAlignment alignment = MaaViewportAlignment_Center;
+    std::uint64_t frame_id = 0;
+    bool strict = true;
+
+    bool Valid() const;
+    ViewportFrame CoordinateLabel() const;
+};
+
+class ViewportSession
+{
+public:
+    explicit ViewportSession(MaaController* controller);
+    ~ViewportSession();
+
+    ViewportSession(const ViewportSession&) = delete;
+    ViewportSession& operator=(const ViewportSession&) = delete;
+
+    std::optional<ViewportFrame> Capture(MaaViewportAlignment alignment, bool refresh) const;
+    std::optional<ViewportFrame> Adopt(const MaaImageBuffer* image, MaaViewportAlignment alignment) const;
+    std::optional<ViewportFrame> PreferredLabel(MaaViewportAlignment preferred) const;
+
+    bool Click(const ViewportFrame& frame, const cv::Point& point) const;
+    bool TouchDown(const ViewportFrame& frame, int contact, const cv::Point& point, int pressure) const;
+    bool TouchMove(const ViewportFrame& frame, int contact, const cv::Point& point, int pressure) const;
+    bool TouchUp(int contact) const;
+    bool ReleaseTouches() const;
+
+private:
+    bool ReadInfo(ViewportInfo* out_info) const;
+    bool SetAlignment(MaaViewportAlignment alignment) const;
+    void NoteCapturedFrame() const;
+    std::uint64_t EnsureFrameId() const;
+    bool IsAlignmentAvailable(const ViewportInfo& info, MaaViewportAlignment alignment) const;
+    bool PrepareFrame(const ViewportFrame& frame, ViewportInfo* before) const;
+    bool RestoreAlignment(MaaViewportAlignment alignment) const;
+    bool WaitForAction(MaaCtrlId id, const char* action_name) const;
+
+    MaaController* controller_ = nullptr;
+    mutable std::map<int, ViewportFrame> active_contacts_;
+};
+
+} // namespace maaend::viewport
diff --git a/agent/go-service/pkg/viewport/session.go b/agent/go-service/pkg/viewport/session.go
new file mode 100644
index 0000000..51f2bef
--- /dev/null
+++ b/agent/go-service/pkg/viewport/session.go
@@ -0,0 +1,574 @@
+package viewport
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"image"
+	"sync"
+	"time"
+
+	maa "github.com/MaaXYZ/maa-framework-go/v4"
+)
+
+var (
+	ErrInvalidFrame       = errors.New("viewport frame is invalid")
+	ErrStaleFrame         = errors.New("viewport frame is stale")
+	ErrUnsupportedRuntime = errors.New("controller does not expose the viewport contract")
+	controllerSessionLock sync.Mutex
+)
+
+// Rect describes a rectangle in controller telemetry.
+type Rect struct {
+	X      int `json:"x"`
+	Y      int `json:"y"`
+	Width  int `json:"width"`
+	Height int `json:"height"`
+}
+
+// Info is the public screenshot_viewport section returned by Controller.GetInfo.
+type Info struct {
+	Configured           bool                  `json:"configured"`
+	Active               bool                  `json:"active"`
+	Adaptive             bool                  `json:"adaptive"`
+	Alignment            string                `json:"alignment"`
+	CachedAlignment      string                `json:"cached_alignment"`
+	AlignmentValue       maa.ViewportAlignment `json:"alignment_value"`
+	CachedAlignmentValue maa.ViewportAlignment `json:"cached_alignment_value"`
+	FrameID              uint64                `json:"frame_id"`
+	AvailableAlignments  []string              `json:"available_alignments"`
+	Raw                  Rect                  `json:"raw"`
+	Logical              Rect                  `json:"logical"`
+	Viewport             Rect                  `json:"viewport"`
+	RawWidth             int                   `json:"raw_width"`
+	RawHeight            int                   `json:"raw_height"`
+	LogicalWidth         int                   `json:"logical_width"`
+	LogicalHeight        int                   `json:"logical_height"`
+}
+
+// Frame binds an image or fixed-coordinate input label to the alignment and raw frame that produced it.
+type Frame struct {
+	Image     image.Image
+	Alignment maa.ViewportAlignment
+	FrameID   uint64
+	Info      Info
+	strict    bool
+}
+
+func (f Frame) Valid() bool {
+	return validAlignment(f.Alignment) && f.FrameID != 0
+}
+
+// CoordinateLabel explicitly turns a recognition frame into a fixed-coordinate label.
+// The returned value keeps the viewport alignment and source frame ID for telemetry, but
+// it is no longer tied to the lifetime of the image. Use this only for semantic coordinates
+// whose meaning survives a later screenshot (for example a fixed grid cell or safe hover
+// position); recognition-derived points should keep using the original strict Frame.
+func (f Frame) CoordinateLabel() Frame {
+	f.Image = nil
+	f.strict = false
+	return f
+}
+
+type backend interface {
+	setAlignment(maa.ViewportAlignment) error
+	screencap() error
+	cacheImage() (image.Image, error)
+	info() (Info, error)
+	click(x, y int32) error
+	swipe(x1, y1, x2, y2 int32, duration time.Duration, contact, pressure int32) error
+	touchDown(contact, x, y, pressure int32) error
+	touchMove(contact, x, y, pressure int32) error
+	touchUp(contact int32) error
+	scroll(dx, dy int32) error
+}
+
+type maaBackend struct {
+	controller *maa.Controller
+}
+
+func (b *maaBackend) setAlignment(alignment maa.ViewportAlignment) error {
+	return b.controller.SetScreenshotViewportAlignment(alignment)
+}
+
+func (b *maaBackend) screencap() error {
+	if job := b.controller.PostScreencap().Wait(); job == nil || !job.Success() {
+		return errors.New("controller screencap failed")
+	}
+	return nil
+}
+
+func (b *maaBackend) cacheImage() (image.Image, error) {
+	return b.controller.CacheImage()
+}
+
+func (b *maaBackend) info() (Info, error) {
+	value, err := b.controller.GetInfo()
+	if err != nil {
+		return Info{}, err
+	}
+	var envelope struct {
+		ScreenshotViewport Info `json:"screenshot_viewport"`
+	}
+	if err := json.Unmarshal([]byte(value), &envelope); err != nil {
+		return Info{}, fmt.Errorf("decode controller viewport info: %w", err)
+	}
+	info := envelope.ScreenshotViewport
+	if info.Raw.Width == 0 {
+		info.Raw.Width = info.RawWidth
+		info.Raw.Height = info.RawHeight
+	}
+	if info.Logical.Width == 0 {
+		info.Logical.Width = info.LogicalWidth
+		info.Logical.Height = info.LogicalHeight
+	}
+	if info.Alignment == "" || info.CachedAlignment == "" {
+		return Info{}, ErrUnsupportedRuntime
+	}
+	return info, nil
+}
+
+func (b *maaBackend) click(x, y int32) error {
+	if job := b.controller.PostClick(x, y).Wait(); job == nil || !job.Success() {
+		return errors.New("controller click failed")
+	}
+	return nil
+}
+
+func (b *maaBackend) swipe(x1, y1, x2, y2 int32, duration time.Duration, contact, pressure int32) error {
+	if job := b.controller.PostSwipeV2(x1, y1, x2, y2, duration, contact, pressure).Wait(); job == nil || !job.Success() {
+		return errors.New("controller swipe failed")
+	}
+	return nil
+}
+
+func (b *maaBackend) touchDown(contact, x, y, pressure int32) error {
+	if job := b.controller.PostTouchDown(contact, x, y, pressure).Wait(); job == nil || !job.Success() {
+		return errors.New("controller touch down failed")
+	}
+	return nil
+}
+
+func (b *maaBackend) touchMove(contact, x, y, pressure int32) error {
+	if job := b.controller.PostTouchMove(contact, x, y, pressure).Wait(); job == nil || !job.Success() {
+		return errors.New("controller touch move failed")
+	}
+	return nil
+}
+
+func (b *maaBackend) touchUp(contact int32) error {
+	if job := b.controller.PostTouchUp(contact).Wait(); job == nil || !job.Success() {
+		return errors.New("controller touch up failed")
+	}
+	return nil
+}
+
+func (b *maaBackend) scroll(dx, dy int32) error {
+	if job := b.controller.PostScroll(dx, dy).Wait(); job == nil || !job.Success() {
+		return errors.New("controller scroll failed")
+	}
+	return nil
+}
+
+// Session serializes alignment selection with cache access and coordinate actions.
+type Session struct {
+	backend backend
+	touchMu sync.Mutex
+	touches map[int32]Frame
+}
+
+func New(controller *maa.Controller) (*Session, error) {
+	if controller == nil {
+		return nil, errors.New("nil controller")
+	}
+	return newSession(&maaBackend{controller: controller}), nil
+}
+
+// CaptureController is the audited one-shot entry point for screenshot-only callers.
+// Stateful recognition/input flows should keep a Session and pass the returned Frame to
+// the corresponding action instead of discarding its alignment evidence.
+func CaptureController(ctx context.Context, controller *maa.Controller, alignment maa.ViewportAlignment, refresh bool) (Frame, error) {
+	session, err := New(controller)
+	if err != nil {
+		return Frame{}, err
+	}
+	return session.Capture(ctx, alignment, refresh)
+}
+
+func newSession(value backend) *Session {
+	return &Session{backend: value, touches: make(map[int32]Frame)}
+}
+
+// PreferredAlignmentForROI uses the same 5/16 edge bands as MaaFramework.
+func PreferredAlignmentForROI(roi image.Rectangle, logicalWidth int) maa.ViewportAlignment {
+	if logicalWidth <= 0 {
+		logicalWidth = 1280
+	}
+	centerX := roi.Min.X + roi.Dx()/2
+	edgeBand := logicalWidth * 5 / 16
+	if centerX < edgeBand {
+		return maa.ViewportAlignmentLeft
+	}
+	if centerX >= logicalWidth-edgeBand {
+		return maa.ViewportAlignmentRight
+	}
+	return maa.ViewportAlignmentCenter
+}
+
+// Capture refreshes at most one raw screenshot and returns its selected logical viewport.
+func (s *Session) Capture(ctx context.Context, alignment maa.ViewportAlignment, refresh bool) (Frame, error) {
+	if !validAlignment(alignment) {
+		return Frame{}, fmt.Errorf("%w: invalid alignment %d", ErrInvalidFrame, alignment)
+	}
+	controllerSessionLock.Lock()
+	defer controllerSessionLock.Unlock()
+	return s.captureLocked(ctx, alignment, refresh)
+}
+
+func (s *Session) CaptureROI(ctx context.Context, roi image.Rectangle, refresh bool) (Frame, error) {
+	controllerSessionLock.Lock()
+	info, err := s.backend.info()
+	controllerSessionLock.Unlock()
+	if err != nil {
+		return Frame{}, err
+	}
+	logicalWidth := info.Logical.Width
+	if logicalWidth == 0 {
+		logicalWidth = 1280
+	}
+	alignment := PreferredAlignmentForROI(roi, logicalWidth)
+	if !alignmentAvailable(info, alignment) {
+		alignment = maa.ViewportAlignmentCenter
+	}
+	return s.Capture(ctx, alignment, refresh)
+}
+
+// CaptureCandidates renders Center, Left, and Right from one raw frame. Unsupported duplicate
+// alignments are omitted, so a standard 16:9 device returns Center only.
+func (s *Session) CaptureCandidates(ctx context.Context, refresh bool) (_ []Frame, result error) {
+	controllerSessionLock.Lock()
+	defer controllerSessionLock.Unlock()
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	before, err := s.backend.info()
+	if err != nil && !errors.Is(err, ErrUnsupportedRuntime) {
+		return nil, err
+	}
+	previous := alignmentFromInfo(before)
+	if refresh {
+		if err := s.backend.screencap(); err != nil {
+			return nil, err
+		}
+	}
+	defer func() {
+		if err := s.backend.setAlignment(previous); err != nil {
+			result = errors.Join(result, fmt.Errorf("restore viewport alignment: %w", err))
+		}
+	}()
+
+	var frames []Frame
+	var frameID uint64
+	for _, alignment := range []maa.ViewportAlignment{
+		maa.ViewportAlignmentCenter,
+		maa.ViewportAlignmentLeft,
+		maa.ViewportAlignmentRight,
+	} {
+		info, infoErr := s.backend.info()
+		if infoErr != nil {
+			return nil, infoErr
+		}
+		if !alignmentAvailable(info, alignment) {
+			continue
+		}
+		if err := s.backend.setAlignment(alignment); err != nil {
+			return nil, err
+		}
+		img, err := s.backend.cacheImage()
+		if err != nil {
+			return nil, err
+		}
+		info, err = s.backend.info()
+		if err != nil {
+			return nil, err
+		}
+		frame, err := makeFrame(img, alignment, info, true)
+		if err != nil {
+			return nil, err
+		}
+		if frameID == 0 {
+			frameID = frame.FrameID
+		} else if frame.FrameID != frameID {
+			return nil, fmt.Errorf("candidate viewport changed raw frame: %d != %d", frame.FrameID, frameID)
+		}
+		frames = append(frames, frame)
+	}
+	if len(frames) == 0 {
+		return nil, ErrInvalidFrame
+	}
+	return frames, nil
+}
+
+// Label returns a non-image coordinate label for fixed semantic inputs such as a joystick or
+// camera region. It remains usable across later screenshots but still carries an auditable frame ID.
+func (s *Session) Label(ctx context.Context, alignment maa.ViewportAlignment) (Frame, error) {
+	if err := ctx.Err(); err != nil {
+		return Frame{}, err
+	}
+	controllerSessionLock.Lock()
+	defer controllerSessionLock.Unlock()
+	info, err := s.backend.info()
+	if err != nil {
+		return Frame{}, err
+	}
+	if info.FrameID == 0 || !alignmentAvailable(info, alignment) {
+		return Frame{}, ErrInvalidFrame
+	}
+	return Frame{Alignment: alignment, FrameID: info.FrameID, Info: info, strict: false}, nil
+}
+
+// PreferredLabel selects the preferred semantic viewport on adaptive displays and
+// transparently uses Center on a standard display. It does not weaken the public
+// controller option: explicitly setting Left/Right on a non-adaptive controller still fails.
+func (s *Session) PreferredLabel(ctx context.Context, preferred maa.ViewportAlignment) (Frame, error) {
+	if !validAlignment(preferred) {
+		return Frame{}, ErrInvalidFrame
+	}
+	if err := ctx.Err(); err != nil {
+		return Frame{}, err
+	}
+	controllerSessionLock.Lock()
+	defer controllerSessionLock.Unlock()
+	info, err := s.backend.info()
+	if err != nil {
+		return Frame{}, err
+	}
+	alignment := preferred
+	if !alignmentAvailable(info, alignment) {
+		if info.Adaptive || !alignmentAvailable(info, maa.ViewportAlignmentCenter) {
+			return Frame{}, ErrInvalidFrame
+		}
+		alignment = maa.ViewportAlignmentCenter
+	}
+	if info.FrameID == 0 {
+		return Frame{}, ErrInvalidFrame
+	}
+	return Frame{Alignment: alignment, FrameID: info.FrameID, Info: info, strict: false}, nil
+}
+
+func (s *Session) Click(ctx context.Context, frame Frame, x, y int32) error {
+	return s.withFrame(ctx, frame, func() error { return s.backend.click(x, y) })
+}
+
+func (s *Session) Swipe(
+	ctx context.Context,
+	frame Frame,
+	x1, y1, x2, y2 int32,
+	duration time.Duration,
+	contact, pressure int32,
+) error {
+	return s.withFrame(ctx, frame, func() error {
+		return s.backend.swipe(x1, y1, x2, y2, duration, contact, pressure)
+	})
+}
+
+func (s *Session) TouchDown(ctx context.Context, frame Frame, contact, x, y, pressure int32) error {
+	err := s.withFrame(ctx, frame, func() error { return s.backend.touchDown(contact, x, y, pressure) })
+	if err == nil {
+		s.touchMu.Lock()
+		s.touches[contact] = frame
+		s.touchMu.Unlock()
+	}
+	return err
+}
+
+func (s *Session) TouchMove(ctx context.Context, frame Frame, contact, x, y, pressure int32) error {
+	s.touchMu.Lock()
+	if active, ok := s.touches[contact]; ok {
+		frame = active
+		frame.strict = false
+	}
+	s.touchMu.Unlock()
+	return s.withFrame(ctx, frame, func() error { return s.backend.touchMove(contact, x, y, pressure) })
+}
+
+func (s *Session) TouchUp(ctx context.Context, contact int32) error {
+	ctxErr := ctx.Err()
+	s.touchMu.Lock()
+	active, hasActive := s.touches[contact]
+	s.touchMu.Unlock()
+
+	controllerSessionLock.Lock()
+	info, infoErr := s.backend.info()
+	var selectErr error
+	if hasActive {
+		selectErr = s.backend.setAlignment(active.Alignment)
+	}
+	actionErr := s.backend.touchUp(contact)
+	var restoreErr error
+	if infoErr == nil {
+		if err := s.backend.setAlignment(alignmentFromInfo(info)); err != nil {
+			restoreErr = fmt.Errorf("restore viewport alignment: %w", err)
+		}
+	}
+	controllerSessionLock.Unlock()
+
+	s.touchMu.Lock()
+	delete(s.touches, contact)
+	s.touchMu.Unlock()
+	return errors.Join(ctxErr, infoErr, selectErr, actionErr, restoreErr)
+}
+
+func (s *Session) Scroll(ctx context.Context, frame Frame, dx, dy int32) error {
+	return s.withFrame(ctx, frame, func() error { return s.backend.scroll(dx, dy) })
+}
+
+// ReleaseTouches releases all contacts started through this session. Callers should defer it
+// around long-running input loops so cancellation and panic paths cannot leave contacts active.
+func (s *Session) ReleaseTouches(ctx context.Context) error {
+	s.touchMu.Lock()
+	contacts := make([]int32, 0, len(s.touches))
+	for contact := range s.touches {
+		contacts = append(contacts, contact)
+	}
+	s.touchMu.Unlock()
+
+	result := ctx.Err()
+	for _, contact := range contacts {
+		if err := s.TouchUp(context.Background(), contact); err != nil {
+			result = errors.Join(result, err)
+		}
+	}
+	return result
+}
+
+func (s *Session) captureLocked(ctx context.Context, alignment maa.ViewportAlignment, refresh bool) (_ Frame, result error) {
+	if err := ctx.Err(); err != nil {
+		return Frame{}, err
+	}
+	before, err := s.backend.info()
+	if err != nil && !errors.Is(err, ErrUnsupportedRuntime) {
+		return Frame{}, err
+	}
+	previous := alignmentFromInfo(before)
+	if refresh {
+		if err := s.backend.screencap(); err != nil {
+			return Frame{}, err
+		}
+	}
+	defer func() {
+		if err := s.backend.setAlignment(previous); err != nil {
+			result = errors.Join(result, fmt.Errorf("restore viewport alignment: %w", err))
+		}
+	}()
+	if err := s.backend.setAlignment(alignment); err != nil {
+		return Frame{}, err
+	}
+	img, err := s.backend.cacheImage()
+	if err != nil {
+		return Frame{}, err
+	}
+	info, err := s.backend.info()
+	if err != nil {
+		return Frame{}, err
+	}
+	return makeFrame(img, alignment, info, true)
+}
+
+func (s *Session) withFrame(ctx context.Context, frame Frame, action func() error) (result error) {
+	if !frame.Valid() {
+		return ErrInvalidFrame
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	controllerSessionLock.Lock()
+	defer controllerSessionLock.Unlock()
+	info, err := s.backend.info()
+	if err != nil {
+		return err
+	}
+	if frame.strict && info.FrameID != frame.FrameID {
+		return fmt.Errorf("%w: current=%d recognized=%d", ErrStaleFrame, info.FrameID, frame.FrameID)
+	}
+	previous := alignmentFromInfo(info)
+	defer func() {
+		if err := s.backend.setAlignment(previous); err != nil {
+			result = errors.Join(result, fmt.Errorf("restore viewport alignment: %w", err))
+		}
+	}()
+	if err := s.backend.setAlignment(frame.Alignment); err != nil {
+		return err
+	}
+	return action()
+}
+
+func makeFrame(img image.Image, alignment maa.ViewportAlignment, info Info, strict bool) (Frame, error) {
+	if img == nil || info.FrameID == 0 {
+		return Frame{}, ErrInvalidFrame
+	}
+	expected := alignmentName(alignment)
+	if info.Alignment != expected || info.CachedAlignment != expected {
+		return Frame{}, fmt.Errorf(
+			"%w: selected=%q cached=%q expected=%q",
+			ErrInvalidFrame,
+			info.Alignment,
+			info.CachedAlignment,
+			expected,
+		)
+	}
+	if info.Logical.Width > 0 && (img.Bounds().Dx() != info.Logical.Width || img.Bounds().Dy() != info.Logical.Height) {
+		return Frame{}, fmt.Errorf(
+			"%w: image=%dx%d logical=%dx%d",
+			ErrInvalidFrame,
+			img.Bounds().Dx(),
+			img.Bounds().Dy(),
+			info.Logical.Width,
+			info.Logical.Height,
+		)
+	}
+	return Frame{Image: img, Alignment: alignment, FrameID: info.FrameID, Info: info, strict: strict}, nil
+}
+
+func validAlignment(alignment maa.ViewportAlignment) bool {
+	return alignment >= maa.ViewportAlignmentCenter && alignment <= maa.ViewportAlignmentRight
+}
+
+func alignmentName(alignment maa.ViewportAlignment) string {
+	switch alignment {
+	case maa.ViewportAlignmentLeft:
+		return "left"
+	case maa.ViewportAlignmentRight:
+		return "right"
+	default:
+		return "center"
+	}
+}
+
+func alignmentFromInfo(info Info) maa.ViewportAlignment {
+	switch info.Alignment {
+	case "left":
+		return maa.ViewportAlignmentLeft
+	case "right":
+		return maa.ViewportAlignmentRight
+	default:
+		return maa.ViewportAlignmentCenter
+	}
+}
+
+func alignmentAvailable(info Info, alignment maa.ViewportAlignment) bool {
+	if !validAlignment(alignment) {
+		return false
+	}
+	if len(info.AvailableAlignments) == 0 {
+		return alignment == maa.ViewportAlignmentCenter
+	}
+	expected := alignmentName(alignment)
+	for _, value := range info.AvailableAlignments {
+		if value == expected {
+			return true
+		}
+	}
+	return false
+}
diff --git a/agent/go-service/pkg/viewport/session_test.go b/agent/go-service/pkg/viewport/session_test.go
new file mode 100644
index 0000000..986f665
--- /dev/null
+++ b/agent/go-service/pkg/viewport/session_test.go
@@ -0,0 +1,275 @@
+package viewport
+
+import (
+	"context"
+	"errors"
+	"image"
+	"testing"
+	"time"
+
+	maa "github.com/MaaXYZ/maa-framework-go/v4"
+)
+
+type fakeBackend struct {
+	alignment  maa.ViewportAlignment
+	frameID    uint64
+	image      image.Image
+	actions    []maa.ViewportAlignment
+	screencaps int
+	failCache  bool
+	adaptive   bool
+	reject     *maa.ViewportAlignment
+}
+
+func newFakeBackend() *fakeBackend {
+	return &fakeBackend{
+		alignment: maa.ViewportAlignmentCenter,
+		frameID:   1,
+		image:     image.NewRGBA(image.Rect(0, 0, 1280, 720)),
+		adaptive:  true,
+	}
+}
+
+func (b *fakeBackend) setAlignment(alignment maa.ViewportAlignment) error {
+	if !validAlignment(alignment) {
+		return ErrInvalidFrame
+	}
+	if b.reject != nil && *b.reject == alignment {
+		return errors.New("alignment rejected")
+	}
+	b.alignment = alignment
+	return nil
+}
+
+func (b *fakeBackend) screencap() error {
+	b.frameID++
+	b.screencaps++
+	return nil
+}
+
+func (b *fakeBackend) cacheImage() (image.Image, error) {
+	if b.failCache {
+		return nil, errors.New("cache failed")
+	}
+	return b.image, nil
+}
+
+func (b *fakeBackend) info() (Info, error) {
+	name := alignmentName(b.alignment)
+	available := []string{"center", "left", "right"}
+	if !b.adaptive {
+		available = []string{"center"}
+	}
+	return Info{
+		Active:               true,
+		Adaptive:             b.adaptive,
+		Alignment:            name,
+		CachedAlignment:      name,
+		AlignmentValue:       b.alignment,
+		CachedAlignmentValue: b.alignment,
+		FrameID:              b.frameID,
+		AvailableAlignments:  available,
+		Raw:                  Rect{Width: 2800, Height: 1260},
+		Logical:              Rect{Width: 1280, Height: 720},
+	}, nil
+}
+
+func TestPreferredLabelFallsBackToCenterOnStandardDisplay(t *testing.T) {
+	backend := newFakeBackend()
+	backend.adaptive = false
+	backend.alignment = maa.ViewportAlignmentCenter
+	session := newSession(backend)
+
+	label, err := session.PreferredLabel(context.Background(), maa.ViewportAlignmentRight)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if label.Alignment != maa.ViewportAlignmentCenter {
+		t.Fatalf("alignment=%d, want center", label.Alignment)
+	}
+}
+
+func (b *fakeBackend) record() error {
+	b.actions = append(b.actions, b.alignment)
+	return nil
+}
+
+func (b *fakeBackend) click(int32, int32) error { return b.record() }
+func (b *fakeBackend) swipe(int32, int32, int32, int32, time.Duration, int32, int32) error {
+	return b.record()
+}
+func (b *fakeBackend) touchDown(int32, int32, int32, int32) error { return b.record() }
+func (b *fakeBackend) touchMove(int32, int32, int32, int32) error { return b.record() }
+func (b *fakeBackend) touchUp(int32) error                        { return b.record() }
+func (b *fakeBackend) scroll(int32, int32) error                  { return b.record() }
+
+func TestPreferredAlignmentForROI(t *testing.T) {
+	tests := []struct {
+		x    int
+		want maa.ViewportAlignment
+	}{
+		{399, maa.ViewportAlignmentLeft},
+		{400, maa.ViewportAlignmentCenter},
+		{879, maa.ViewportAlignmentCenter},
+		{880, maa.ViewportAlignmentRight},
+	}
+	for _, test := range tests {
+		roi := image.Rect(test.x, 0, test.x+1, 1)
+		if got := PreferredAlignmentForROI(roi, 1280); got != test.want {
+			t.Fatalf("x=%d: got %d, want %d", test.x, got, test.want)
+		}
+	}
+}
+
+func TestCaptureCandidatesUsesOneRawFrameAndRestores(t *testing.T) {
+	backend := newFakeBackend()
+	backend.alignment = maa.ViewportAlignmentRight
+	session := newSession(backend)
+
+	frames, err := session.CaptureCandidates(context.Background(), true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(frames) != 3 || backend.screencaps != 1 {
+		t.Fatalf("frames=%d screencaps=%d", len(frames), backend.screencaps)
+	}
+	for _, frame := range frames {
+		if frame.FrameID != 2 {
+			t.Fatalf("candidate frame id=%d", frame.FrameID)
+		}
+	}
+	if backend.alignment != maa.ViewportAlignmentRight {
+		t.Fatalf("alignment not restored: %d", backend.alignment)
+	}
+}
+
+func TestCaptureErrorRestoresAlignment(t *testing.T) {
+	backend := newFakeBackend()
+	backend.alignment = maa.ViewportAlignmentLeft
+	backend.failCache = true
+	session := newSession(backend)
+
+	if _, err := session.Capture(context.Background(), maa.ViewportAlignmentRight, false); err == nil {
+		t.Fatal("expected cache failure")
+	}
+	if backend.alignment != maa.ViewportAlignmentLeft {
+		t.Fatalf("alignment not restored: %d", backend.alignment)
+	}
+}
+
+func TestStrictFrameRejectsStaleButFixedLabelAllowsIt(t *testing.T) {
+	backend := newFakeBackend()
+	session := newSession(backend)
+	frame, err := session.Capture(context.Background(), maa.ViewportAlignmentLeft, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	backend.frameID++
+	if err := session.Click(context.Background(), frame, 100, 100); !errors.Is(err, ErrStaleFrame) {
+		t.Fatalf("got %v, want ErrStaleFrame", err)
+	}
+
+	label, err := session.Label(context.Background(), maa.ViewportAlignmentRight)
+	if err != nil {
+		t.Fatal(err)
+	}
+	backend.frameID++
+	if err := session.Click(context.Background(), label, 100, 100); err != nil {
+		t.Fatal(err)
+	}
+	if got := backend.actions[len(backend.actions)-1]; got != maa.ViewportAlignmentRight {
+		t.Fatalf("action alignment=%d", got)
+	}
+}
+
+func TestCoordinateLabelPreservesEvidenceButAllowsLaterFrame(t *testing.T) {
+	backend := newFakeBackend()
+	session := newSession(backend)
+	frame, err := session.Capture(context.Background(), maa.ViewportAlignmentLeft, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	label := frame.CoordinateLabel()
+	backend.frameID++
+	if label.Image != nil || label.FrameID != frame.FrameID || label.Alignment != frame.Alignment {
+		t.Fatalf("coordinate label lost source evidence: %#v", label)
+	}
+	if err := session.Click(context.Background(), label, 100, 100); err != nil {
+		t.Fatal(err)
+	}
+	if got := backend.actions[len(backend.actions)-1]; got != maa.ViewportAlignmentLeft {
+		t.Fatalf("action alignment=%d", got)
+	}
+}
+
+func TestContactKeepsDownAlignmentAndTouchUpClears(t *testing.T) {
+	backend := newFakeBackend()
+	session := newSession(backend)
+	left, _ := session.Label(context.Background(), maa.ViewportAlignmentLeft)
+	right, _ := session.Label(context.Background(), maa.ViewportAlignmentRight)
+
+	if err := session.TouchDown(context.Background(), left, 1, 100, 100, 1); err != nil {
+		t.Fatal(err)
+	}
+	if err := session.TouchMove(context.Background(), right, 1, 200, 100, 1); err != nil {
+		t.Fatal(err)
+	}
+	if got := backend.actions[len(backend.actions)-1]; got != maa.ViewportAlignmentLeft {
+		t.Fatalf("active contact moved with alignment=%d", got)
+	}
+	if err := session.TouchUp(context.Background(), 1); err != nil {
+		t.Fatal(err)
+	}
+	if got := backend.actions[len(backend.actions)-1]; got != maa.ViewportAlignmentLeft {
+		t.Fatalf("touch up alignment=%d, want left", got)
+	}
+	if err := session.TouchMove(context.Background(), right, 1, 200, 100, 1); err != nil {
+		t.Fatal(err)
+	}
+	if got := backend.actions[len(backend.actions)-1]; got != maa.ViewportAlignmentRight {
+		t.Fatalf("released contact moved with alignment=%d", got)
+	}
+}
+
+func TestTouchUpStillReleasesWhenContactAlignmentCannotBeSelected(t *testing.T) {
+	backend := newFakeBackend()
+	session := newSession(backend)
+	left, _ := session.Label(context.Background(), maa.ViewportAlignmentLeft)
+	right, _ := session.Label(context.Background(), maa.ViewportAlignmentRight)
+	if err := session.TouchDown(context.Background(), left, 4, 100, 100, 1); err != nil {
+		t.Fatal(err)
+	}
+	backend.reject = new(maa.ViewportAlignment)
+	*backend.reject = maa.ViewportAlignmentLeft
+	actionCount := len(backend.actions)
+	if err := session.TouchUp(context.Background(), 4); err == nil {
+		t.Fatal("expected alignment selection error")
+	}
+	if len(backend.actions) != actionCount+1 {
+		t.Fatalf("touch up was skipped: actions=%d, want %d", len(backend.actions), actionCount+1)
+	}
+	backend.reject = nil
+	if err := session.TouchMove(context.Background(), right, 4, 200, 100, 1); err != nil {
+		t.Fatal(err)
+	}
+	if got := backend.actions[len(backend.actions)-1]; got != maa.ViewportAlignmentRight {
+		t.Fatalf("failed touch up did not clear contact: alignment=%d", got)
+	}
+}
+
+func TestPanicStillRestoresAlignment(t *testing.T) {
+	backend := newFakeBackend()
+	backend.alignment = maa.ViewportAlignmentCenter
+	session := newSession(backend)
+	frame, _ := session.Label(context.Background(), maa.ViewportAlignmentRight)
+
+	func() {
+		defer func() { _ = recover() }()
+		_ = session.withFrame(context.Background(), frame, func() error {
+			panic("test panic")
+		})
+	}()
+	if backend.alignment != maa.ViewportAlignmentCenter {
+		t.Fatalf("alignment not restored after panic: %d", backend.alignment)
+	}
+}
