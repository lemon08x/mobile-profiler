@@ -0,0 +1,69 @@
+package maptrackerdefault
+
+import (
+	"image"
+	"image/color"
+	"path/filepath"
+	"testing"
+
+	internal "github.com/MaaXYZ/MaaEnd/agent/go-service/maptracker/internal"
+	"github.com/MaaXYZ/MaaEnd/agent/go-service/pkg/control"
+	"github.com/MaaXYZ/MaaEnd/agent/go-service/pkg/minicv"
+)
+
+func TestInferRotationCalibratesShiftedADBMinimap(t *testing.T) {
+	pointerPath := filepath.Join(
+		"..", "..", "..", "..", "assets", "resource", "image",
+		"MapTracker", "MiniMapIcons", "Pointer.png",
+	)
+	originalLoader := internal.Resource.PointerTemplateLoader
+	internal.Resource.PointerTemplateLoader = minicv.NewTemplateLoaderOfPath(pointerPath)
+	defer func() { internal.Resource.PointerTemplateLoader = originalLoader }()
+
+	template, err := internal.Resource.PointerTemplateLoader.Get()
+	if err != nil {
+		t.Fatal(err)
+	}
+	const expectedX = 65
+	screen := image.NewRGBA(image.Rect(0, 0, 1280, 720))
+	for y := range screen.Bounds().Dy() {
+		for x := range screen.Bounds().Dx() {
+			shade := uint8(35 + (x+y)%11)
+			screen.SetRGBA(x, y, color.RGBA{R: shade, G: shade, B: shade, A: 255})
+		}
+	}
+	scaledPointer := minicv.ImageScale(template.Image, 1.25)
+	left := expectedX - scaledPointer.Bounds().Dx()/2
+	top := adbMiniMapDefaultCenterY - scaledPointer.Bounds().Dy()/2
+	for y := range scaledPointer.Bounds().Dy() {
+		for x := range scaledPointer.Bounds().Dx() {
+			pixel := scaledPointer.RGBAAt(x, y)
+			if pixel.G > 240 && pixel.R < 20 && pixel.B < 20 {
+				continue
+			}
+			screen.SetRGBA(left+x, top+y, pixel)
+		}
+	}
+
+	adbMiniMapCenterCache.Lock()
+	originalX := adbMiniMapCenterCache.x
+	adbMiniMapCenterCache.x = adbMiniMapDefaultCenterX
+	adbMiniMapCenterCache.Unlock()
+	defer func() {
+		adbMiniMapCenterCache.Lock()
+		adbMiniMapCenterCache.x = originalX
+		adbMiniMapCenterCache.Unlock()
+	}()
+
+	result := (&MapTrackerInfer{}).inferRotation(
+		control.CONTROL_TYPE_ADB,
+		screen,
+		4,
+	)
+	if result.Conf < adbMiniMapCalibratedConf {
+		t.Fatalf("expected calibrated confidence, got %.4f", result.Conf)
+	}
+	if result.CenterX < expectedX-adbMiniMapSearchStepX || result.CenterX > expectedX+adbMiniMapSearchStepX {
+		t.Fatalf("expected center near %d, got %d", expectedX, result.CenterX)
+	}
+}
