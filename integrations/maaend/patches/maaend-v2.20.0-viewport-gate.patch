+{
+    const double remaining_budget = std::max(0.25, waypoint_distance - arrival_distance * 0.5);
+    const double target_displacement = remaining_budget * kAdbSampleHoldPulseTargetFraction;
+    const double speed = std::clamp(
+        sample_hold_units_per_ms_,
+        kAdbSampleHoldMinUnitsPerMs,
+        kAdbSampleHoldMaxUnitsPerMs);
+    int pulse_ms = static_cast<int>(std::lround(target_displacement / speed));
+    pulse_ms = std::clamp(pulse_ms, kAdbSampleHoldMinPulseMs, kAdbSampleHoldMaxPulseMs);
+
+    if (upcoming_turn_deg >= kNavRunSharpTurnDeg) {
+        pulse_ms = std::min(pulse_ms, kAdbSampleHoldSharpTurnMaxPulseMs);
+    }
+    if (waypoint_distance <= kMicroThreshold || (strict_arrival && waypoint_distance <= arrival_distance + 2.0)) {
+        pulse_ms = std::min(pulse_ms, kAdbSampleHoldNearGoalMaxPulseMs);
+    }
+    return pulse_ms;
