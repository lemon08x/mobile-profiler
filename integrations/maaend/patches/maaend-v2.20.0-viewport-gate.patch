+package aspectratio
+
+import (
+	"fmt"
+	"testing"
+
+	"github.com/MaaXYZ/maa-framework-go/v4"
+)
+
+func viewportControllerInfo(fields string) string {
+	return fmt.Sprintf(`{"type":"adb","screenshot_viewport":{%s}}`, fields)
+}
+
+func TestParseCompatibleScreenshotViewport(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		name    string
+		info    string
+		width   int32
+		height  int32
+		wantErr bool
+	}{
+		{
+			name: "adaptive ultra-wide phone",
+			info: viewportControllerInfo(
+				`"configured":true,"active":true,"mode":"adaptive","adaptive":true,` +
+					`"raw_width":2800,"raw_height":1260,"logical_width":1280,"logical_height":720,` +
+					`"x":280,"y":0,"width":2240,"height":1260`,
+			),
+			width:  2800,
+			height: 1260,
+		},
+		{
+			name: "scaled 16 by 9 display",
+			info: viewportControllerInfo(
+				`"configured":true,"active":true,"mode":"center","adaptive":false,` +
+					`"raw_width":1920,"raw_height":1080,"logical_width":1280,"logical_height":720,` +
+					`"x":0,"y":0,"width":1920,"height":1080`,
+			),
+			width:  1920,
+			height: 1080,
+		},
+		{
+			name:    "capability missing",
+			info:    `{"type":"adb"}`,
+			width:   2800,
+			height:  1260,
+			wantErr: true,
+		},
+		{
+			name: "configured but inactive",
+			info: viewportControllerInfo(
+				`"configured":true,"active":false,"mode":"adaptive","adaptive":false,` +
+					`"raw_width":1260,"raw_height":2800,"logical_width":1280,"logical_height":720`,
+			),
+			width:   1260,
+			height:  2800,
+			wantErr: true,
+		},
+		{
+			name: "wrong logical size",
+			info: viewportControllerInfo(
+				`"configured":true,"active":true,"mode":"adaptive","adaptive":true,` +
+					`"raw_width":2800,"raw_height":1260,"logical_width":1600,"logical_height":720,` +
+					`"x":280,"y":0,"width":2240,"height":1260`,
+			),
+			width:   2800,
+			height:  1260,
+			wantErr: true,
+		},
+		{
+			name: "stale raw size",
+			info: viewportControllerInfo(
+				`"configured":true,"active":true,"mode":"adaptive","adaptive":true,` +
+					`"raw_width":2400,"raw_height":1080,"logical_width":1280,"logical_height":720,` +
+					`"x":240,"y":0,"width":1920,"height":1080`,
+			),
+			width:   2800,
+			height:  1260,
+			wantErr: true,
+		},
+		{
+			name: "viewport outside raw image",
+			info: viewportControllerInfo(
+				`"configured":true,"active":true,"mode":"adaptive","adaptive":true,` +
+					`"raw_width":2800,"raw_height":1260,"logical_width":1280,"logical_height":720,` +
+					`"x":700,"y":0,"width":2240,"height":1260`,
+			),
+			width:   2800,
+			height:  1260,
+			wantErr: true,
+		},
+		{
+			name: "ultra-wide center-only mode",
+			info: viewportControllerInfo(
+				`"configured":true,"active":true,"mode":"center","adaptive":false,` +
+					`"raw_width":2800,"raw_height":1260,"logical_width":1280,"logical_height":720,` +
+					`"x":280,"y":0,"width":2240,"height":1260`,
+			),
+			width:   2800,
+			height:  1260,
+			wantErr: true,
+		},
+		{
+			name:    "malformed controller info",
+			info:    `{`,
+			width:   2800,
+			height:  1260,
+			wantErr: true,
+		},
+	}
+
+	for _, tt := range tests {
+		tt := tt
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			_, err := parseCompatibleScreenshotViewport(tt.info, tt.width, tt.height)
+			if (err != nil) != tt.wantErr {
+				t.Fatalf("parseCompatibleScreenshotViewport() error = %v, wantErr %v", err, tt.wantErr)
+			}
+		})
+	}
+}
+
+func TestParseCompatiblePortraitLaunchViewport(t *testing.T) {
+	t.Parallel()
+
+	valid := `"configured":true,"active":false,"mode":"adaptive","adaptive":false,` +
+		`"raw_width":1260,"raw_height":2800,"logical_width":1280,"logical_height":720`
+	tests := []struct {
+		name    string
+		fields  string
+		width   int32
+		height  int32
+		wantErr bool
+	}{
+		{
+			name:   "configured adaptive portrait phone",
+			fields: valid,
+			width:  1260,
+			height: 2800,
+		},
+		{
+			name: "active capability is not a transition",
+			fields: `"configured":true,"active":true,"mode":"adaptive","adaptive":true,` +
+				`"raw_width":1260,"raw_height":2800,"logical_width":1280,"logical_height":720`,
+			width:   1260,
+			height:  2800,
+			wantErr: true,
+		},
+		{
+			name: "center mode is rejected",
+			fields: `"configured":true,"active":false,"mode":"center","adaptive":false,` +
+				`"raw_width":1260,"raw_height":2800,"logical_width":1280,"logical_height":720`,
+			width:   1260,
+			height:  2800,
+			wantErr: true,
+		},
+		{
+			name:    "landscape state is rejected",
+			fields:  valid,
+			width:   2800,
+			height:  1260,
+			wantErr: true,
+		},
+		{
+			name: "stale raw dimensions are rejected",
+			fields: `"configured":true,"active":false,"mode":"adaptive","adaptive":false,` +
+				`"raw_width":1080,"raw_height":2400,"logical_width":1280,"logical_height":720`,
+			width:   1260,
+			height:  2800,
+			wantErr: true,
+		},
+		{
+			name: "rotated resolution is too small",
+			fields: `"configured":true,"active":false,"mode":"adaptive","adaptive":false,` +
+				`"raw_width":700,"raw_height":1200,"logical_width":1280,"logical_height":720`,
+			width:   700,
+			height:  1200,
+			wantErr: true,
+		},
+		{
+			name: "wrong logical size is rejected",
+			fields: `"configured":true,"active":false,"mode":"adaptive","adaptive":false,` +
+				`"raw_width":1260,"raw_height":2800,"logical_width":1920,"logical_height":1080`,
+			width:   1260,
+			height:  2800,
+			wantErr: true,
+		},
+	}
+
+	for _, tt := range tests {
+		tt := tt
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			_, err := parseCompatiblePortraitLaunchViewport(viewportControllerInfo(tt.fields), tt.width, tt.height)
+			if (err != nil) != tt.wantErr {
+				t.Fatalf("parseCompatiblePortraitLaunchViewport() error = %v, wantErr %v", err, tt.wantErr)
+			}
+		})
+	}
+}
+
+func TestPortraitLaunchTransitionEntryIsExact(t *testing.T) {
+	t.Parallel()
+
+	if !isPortraitLaunchTransitionEntry("AndroidOpenGame") {
+		t.Fatal("AndroidOpenGame should be eligible for the portrait launch transition")
+	}
+	for _, entry := range []string{"OpenGame", "AndroidOpenGame_CN", "DailyTask", "androidopengame", " AndroidOpenGame"} {
+		if isPortraitLaunchTransitionEntry(entry) {
+			t.Fatalf("entry %q unexpectedly received the portrait launch exception", entry)
+		}
+	}
+}
+
+func TestValidateCoordinateFreeNode(t *testing.T) {
+	t.Parallel()
+
+	directStart := &maa.Node{
+		Recognition: &maa.Recognition{Type: maa.RecognitionTypeDirectHit},
+		Action:      &maa.Action{Type: maa.ActionTypeStartApp},
+	}
+	if err := validateCoordinateFreeNode(directStart, maa.ActionTypeStartApp); err != nil {
+		t.Fatalf("validateCoordinateFreeNode() error = %v", err)
+	}
+
+	coordinateAction := &maa.Node{
+		Recognition: &maa.Recognition{Type: maa.RecognitionTypeDirectHit},
+		Action:      &maa.Action{Type: maa.ActionTypeClick},
+	}
+	if err := validateCoordinateFreeNode(coordinateAction, maa.ActionTypeStartApp); err == nil {
+		t.Fatal("coordinate action unexpectedly passed the launch-chain guard")
+	}
+
+	imageRecognition := &maa.Node{
+		Recognition: &maa.Recognition{Type: maa.RecognitionTypeOCR},
+		Action:      &maa.Action{Type: maa.ActionTypeStartApp},
+	}
+	if err := validateCoordinateFreeNode(imageRecognition, maa.ActionTypeStartApp); err == nil {
+		t.Fatal("image recognition unexpectedly passed before viewport activation")
+	}
+}
