+func parseCompatibleScreenshotViewport(info string, width, height int32) (screenshotViewportInfo, error) {
+	viewport, err := parseScreenshotViewport(info)
+	if err != nil {
+		return screenshotViewportInfo{}, err
+	}
+
+	if !viewport.Configured || !viewport.Active {
+		return screenshotViewportInfo{}, fmt.Errorf("screenshot viewport is not configured and active")
+	}
+	if err := validateScreenshotViewportIdentity(viewport, width, height); err != nil {
+		return screenshotViewportInfo{}, err
+	}
+	if viewport.X < 0 || viewport.Y < 0 || viewport.Width <= 0 || viewport.Height <= 0 ||
+		viewport.X+viewport.Width > viewport.RawWidth || viewport.Y+viewport.Height > viewport.RawHeight {
+		return screenshotViewportInfo{}, fmt.Errorf("screenshot viewport is outside the raw image")
+	}
+	if width < height || viewport.Width < targetWidth || viewport.Height < targetHeight {
+		return screenshotViewportInfo{}, fmt.Errorf("active screenshot viewport does not provide a landscape 1280x720 source")
+	}
+	if !isAspectRatio16x9(viewport.Width, viewport.Height) {
+		return screenshotViewportInfo{}, fmt.Errorf(
+			"screenshot viewport size %dx%d is not 16:9",
+			viewport.Width,
+			viewport.Height,
+		)
+	}
+	if !isAspectRatio16x9(int(width), int(height)) && (viewport.Mode != "adaptive" || !viewport.Adaptive) {
+		return screenshotViewportInfo{}, fmt.Errorf("non-16:9 ADB resolution requires an adaptive screenshot viewport")
+	}
+
+	return viewport, nil
+}
