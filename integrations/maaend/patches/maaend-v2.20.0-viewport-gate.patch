+func (c *AspectRatioChecker) OnNodePipelineNode(ctx *maa.Context, event maa.EventStatus, detail maa.NodePipelineNodeDetail) {
+	if event != maa.EventStatusStarting {
+		return
+	}
+
+	transition, ok := c.getPortraitTransition(detail.TaskID)
+	if !ok {
+		return
+	}
+
+	if !transition.chainValidated {
+		if detail.Name != androidOpenGameEntry {
+			c.failPortraitTransition(ctx, detail, fmt.Errorf("first pipeline node is %q, want %q", detail.Name, androidOpenGameEntry))
+			return
+		}
+
+		launchNode, err := validateAndroidOpenGameLaunchChain(ctx)
+		if err != nil {
