+	x         int32
+	y         int32
+}
+
+func (f *fakeVisitFriendsDetailClickSession) PreferredLabel(_ context.Context, alignment maa.ViewportAlignment) (viewport.Frame, error) {
+	f.alignment = alignment
+	return viewport.Frame{Alignment: alignment, FrameID: 17}, nil
+}
+
+func (f *fakeVisitFriendsDetailClickSession) Click(_ context.Context, _ viewport.Frame, x, y int32) error {
+	f.x = x
+	f.y = y
+	return nil
+}
+
+func TestClickVisitFriendsDetailButtonKeepsCenterFrameCoordinates(t *testing.T) {
+	view := &fakeVisitFriendsDetailClickSession{}
+	if err := clickVisitFriendsDetailButton(context.Background(), view, []int{1229, 181, 32, 33}); err != nil {
+		t.Fatal(err)
+	}
+	if view.alignment != maa.ViewportAlignmentCenter {
+		t.Fatalf("alignment=%d, want center", view.alignment)
+	}
+	if view.x != 1245 || view.y != 197 {
+		t.Fatalf("point=(%d,%d), want (1245,197)", view.x, view.y)
+	}
+}
+
+func TestClickVisitFriendsDetailButtonRejectsInvalidBox(t *testing.T) {
+	view := &fakeVisitFriendsDetailClickSession{}
+	if err := clickVisitFriendsDetailButton(context.Background(), view, []int{1, 2, 0, 4}); err == nil {
+		t.Fatal("expected invalid-size error")
+	}
+}
+
+func TestClickVisitFriendsTerminalCloseUsesRightViewport(t *testing.T) {
+	view := &fakeVisitFriendsDetailClickSession{}
+	if err := clickVisitFriendsTerminalClose(context.Background(), view); err != nil {
+		t.Fatal(err)
+	}
+	if view.alignment != maa.ViewportAlignmentRight {
+		t.Fatalf("alignment=%d, want right", view.alignment)
+	}
+	if view.x != 1133 || view.y != 34 {
+		t.Fatalf("point=(%d,%d), want (1133,34)", view.x, view.y)
+	}
+}
