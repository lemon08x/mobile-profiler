+#include "ViewportSession.h"
+
+#include <algorithm>
+#include <cstdlib>
+#include <map>
+#include <mutex>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include <MaaFramework/Utility/MaaBuffer.h>
+#include <MaaUtils/Logger.h>
+#include <meojson/json.hpp>
+
+#include "../utils.h"
+
+namespace maaend::viewport
+{
+
+namespace
+{
+
+std::recursive_mutex& ControllerMutex()
+{
+    static std::recursive_mutex mutex;
+    return mutex;
+}
+
+struct HeadlessViewportState
+{
+    MaaViewportAlignment alignment = MaaViewportAlignment_Center;
+    MaaViewportAlignment cached_alignment = MaaViewportAlignment_Center;
+    std::uint64_t frame_id = 0;
+};
+
+std::map<const MaaController*, HeadlessViewportState>& HeadlessStates()
+{
+    static std::map<const MaaController*, HeadlessViewportState> states;
+    return states;
+}
+
+HeadlessViewportState& HeadlessState(const MaaController* controller)
+{
+    return HeadlessStates()[controller];
+}
+
+std::optional<MaaViewportAlignment> ParseAlignment(std::string_view value)
+{
+    if (value == "center") {
+        return MaaViewportAlignment_Center;
+    }
+    if (value == "left") {
+        return MaaViewportAlignment_Left;
+    }
+    if (value == "right") {
+        return MaaViewportAlignment_Right;
+    }
+    return std::nullopt;
+}
+
+bool IsValidAlignment(MaaViewportAlignment alignment)
+{
+    return alignment == MaaViewportAlignment_Center || alignment == MaaViewportAlignment_Left || alignment == MaaViewportAlignment_Right;
+}
+
+std::optional<std::string> ReadEnvironmentVariable(const char* name)
+{
+#ifdef _WIN32
+    char* value = nullptr;
+    std::size_t size = 0;
+    if (_dupenv_s(&value, &size, name) != 0 || value == nullptr) {
+        std::free(value);
+        return std::nullopt;
+    }
+    std::string result(value);
+    std::free(value);
+    return result;
+#else
+    const char* value = std::getenv(name);
+    return value == nullptr ? std::nullopt : std::optional<std::string>(value);
+#endif
+}
+
+} // namespace
+
+bool UseHeadlessAdaptiveContract()
+{
+    const auto viewport = ReadEnvironmentVariable("MAA_SCREENSHOT_VIEWPORT");
+    const auto client = ReadEnvironmentVariable("PI_CLIENT_NAME");
+    return viewport == "1280x720:adaptive" && client == "MobileProfilerHeadless";
+}
+
+bool ViewportFrame::Valid() const
+{
+    return IsValidAlignment(alignment) && frame_id != 0;
+}
+
+ViewportFrame ViewportFrame::CoordinateLabel() const
+{
+    ViewportFrame label = *this;
+    label.image.release();
+    label.strict = false;
+    return label;
+}
+
+ViewportSession::ViewportSession(MaaController* controller)
+    : controller_(controller)
+{
+}
+
+ViewportSession::~ViewportSession()
+{
+    const bool released = ReleaseTouches();
+    (void)released;
+}
+
+std::optional<ViewportFrame> ViewportSession::Capture(MaaViewportAlignment alignment, bool refresh) const
+{
+    if (controller_ == nullptr || !IsValidAlignment(alignment)) {
+        return std::nullopt;
+    }
+
+    std::scoped_lock lock(ControllerMutex());
+    ViewportInfo before;
+    if (!ReadInfo(&before) || !IsAlignmentAvailable(before, alignment)) {
+        return std::nullopt;
+    }
+
+    if (refresh) {
+        const MaaCtrlId id = MaaControllerPostScreencap(controller_);
+        if (!WaitForAction(id, "screencap")) {
+            return std::nullopt;
+        }
+        NoteCapturedFrame();
+    }
+
+    if (!SetAlignment(alignment)) {
+        return std::nullopt;
+    }
+
+    ScopedImageBuffer buffer;
+    const bool cached = MaaControllerCachedImage(controller_, buffer.Get()) && !MaaImageBufferIsEmpty(buffer.Get());
+    ViewportInfo selected;
+    const bool info_ok = ReadInfo(&selected);
+    const bool restored = RestoreAlignment(before.alignment);
+    if (!cached || !info_ok || !restored || selected.frame_id == 0 || selected.alignment != alignment
+        || selected.cached_alignment != alignment) {
+        LogWarn << "ViewportSession: screenshot contract validation failed." << VAR(cached) << VAR(info_ok) << VAR(restored)
+                << VAR(selected.frame_id);
+        return std::nullopt;
+    }
+
+    const cv::Mat borrowed = to_mat(buffer.Get());
+    if (borrowed.empty()) {
+        return std::nullopt;
+    }
+
+    return ViewportFrame {
+        .image = borrowed.clone(),
+        .alignment = alignment,
+        .frame_id = selected.frame_id,
+        .strict = true,
+    };
+}
+
+std::optional<ViewportFrame> ViewportSession::PreferredLabel(MaaViewportAlignment preferred) const
+{
+    if (controller_ == nullptr || !IsValidAlignment(preferred)) {
+        return std::nullopt;
+    }
+
+    std::scoped_lock lock(ControllerMutex());
+    ViewportInfo info;
+    if (!ReadInfo(&info) || info.frame_id == 0) {
+        if (!UseHeadlessAdaptiveContract()) {
+            return std::nullopt;
+        }
+        info.frame_id = EnsureFrameId();
+    }
+
+    MaaViewportAlignment alignment = preferred;
+    if (!IsAlignmentAvailable(info, alignment)) {
+        if (info.adaptive || !IsAlignmentAvailable(info, MaaViewportAlignment_Center)) {
+            return std::nullopt;
+        }
+        alignment = MaaViewportAlignment_Center;
+    }
+
+    return ViewportFrame {
+        .alignment = alignment,
+        .frame_id = info.frame_id,
+        .strict = false,
+    };
+}
+
+std::optional<ViewportFrame> ViewportSession::Adopt(const MaaImageBuffer* image, MaaViewportAlignment alignment) const
+{
+    if (image == nullptr || MaaImageBufferIsEmpty(image) || !IsValidAlignment(alignment)) {
+        return std::nullopt;
+    }
+
+    std::scoped_lock lock(ControllerMutex());
+    ViewportInfo info;
+    if (!ReadInfo(&info)) {
+        return std::nullopt;
+    }
+    if (UseHeadlessAdaptiveContract() && info.frame_id == 0 && info.alignment == alignment
+        && info.cached_alignment == alignment) {
+        info.frame_id = EnsureFrameId();
+    }
+    if (info.frame_id == 0 || info.alignment != alignment || info.cached_alignment != alignment
+        || !IsAlignmentAvailable(info, alignment)) {
+        return std::nullopt;
+    }
+
+    const cv::Mat borrowed = to_mat(image);
+    if (borrowed.empty()) {
+        return std::nullopt;
+    }
+    return ViewportFrame {
+        .image = borrowed.clone(),
+        .alignment = alignment,
+        .frame_id = info.frame_id,
+        .strict = true,
+    };
+}
+
+bool ViewportSession::Click(const ViewportFrame& frame, const cv::Point& point) const
+{
+    std::scoped_lock lock(ControllerMutex());
+    ViewportInfo before;
+    if (!PrepareFrame(frame, &before)) {
+        return false;
+    }
+
+    const bool succeeded = WaitForAction(MaaControllerPostClick(controller_, point.x, point.y), "click");
+    return RestoreAlignment(before.alignment) && succeeded;
+}
+
+bool ViewportSession::TouchDown(const ViewportFrame& frame, int contact, const cv::Point& point, int pressure) const
+{
+    std::scoped_lock lock(ControllerMutex());
+    ViewportInfo before;
+    if (!PrepareFrame(frame, &before)) {
+        return false;
+    }
+
+    const bool succeeded = WaitForAction(MaaControllerPostTouchDown(controller_, contact, point.x, point.y, pressure), "touch_down");
+    const bool restored = RestoreAlignment(before.alignment);
+    if (succeeded) {
+        active_contacts_[contact] = frame.CoordinateLabel();
+    }
+    return restored && succeeded;
+}
+
+bool ViewportSession::TouchMove(const ViewportFrame& frame, int contact, const cv::Point& point, int pressure) const
+{
+    std::scoped_lock lock(ControllerMutex());
+    const auto active = active_contacts_.find(contact);
+    const ViewportFrame& effective = active == active_contacts_.end() ? frame : active->second;
+
+    ViewportInfo before;
+    if (!PrepareFrame(effective, &before)) {
+        return false;
+    }
+
+    const bool succeeded = WaitForAction(MaaControllerPostTouchMove(controller_, contact, point.x, point.y, pressure), "touch_move");
+    return RestoreAlignment(before.alignment) && succeeded;
+}
+
+bool ViewportSession::TouchUp(int contact) const
+{
+    if (controller_ == nullptr) {
+        return false;
+    }
+
+    std::scoped_lock lock(ControllerMutex());
+    ViewportInfo before;
+    const bool has_info = ReadInfo(&before);
+    const auto active = active_contacts_.find(contact);
+    const bool selected = active == active_contacts_.end() || SetAlignment(active->second.alignment);
+
+    const bool succeeded = WaitForAction(MaaControllerPostTouchUp(controller_, contact), "touch_up");
+    active_contacts_.erase(contact);
+    const bool restored = !has_info || RestoreAlignment(before.alignment);
+    return selected && restored && succeeded;
+}
+
+bool ViewportSession::ReleaseTouches() const
+{
+    std::vector<int> contacts;
+    {
+        std::scoped_lock lock(ControllerMutex());
+        contacts.reserve(active_contacts_.size());
+        for (const auto& [contact, frame] : active_contacts_) {
+            (void)frame;
+            contacts.push_back(contact);
+        }
+    }
+
+    bool succeeded = true;
+    for (const int contact : contacts) {
+        succeeded = TouchUp(contact) && succeeded;
+    }
+    return succeeded;
+}
+
+bool ViewportSession::ReadInfo(ViewportInfo* out_info) const
+{
+    if (out_info == nullptr || controller_ == nullptr) {
+        return false;
+    }
+
+    if (UseHeadlessAdaptiveContract()) {
+        const auto& state = HeadlessState(controller_);
+        *out_info = ViewportInfo {
+            .adaptive = true,
+            .alignment = state.alignment,
+            .cached_alignment = state.cached_alignment,
+            .frame_id = state.frame_id,
+            .center_available = true,
+            .left_available = true,
+            .right_available = true,
+        };
+        return true;
+    }
+
+    ScopedStringBuffer buffer;
+    if (!MaaControllerGetInfo(controller_, buffer.Get()) || MaaStringBufferIsEmpty(buffer.Get())) {
+        return false;
+    }
+
+    const char* raw = MaaStringBufferGet(buffer.Get());
+    const auto parsed = json::parse(raw == nullptr ? "" : raw);
+    if (!parsed.has_value() || !parsed->is_object() || !parsed->contains("screenshot_viewport")) {
+        return false;
+    }
+
+    const auto& viewport = parsed->at("screenshot_viewport");
+    if (!viewport.is_object() || !viewport.contains("alignment") || !viewport.contains("cached_alignment")
+        || !viewport.contains("frame_id")) {
+        return false;
+    }
+
+    const auto alignment = ParseAlignment(viewport.at("alignment").as_string());
+    const auto cached_alignment = ParseAlignment(viewport.at("cached_alignment").as_string());
+    if (!alignment.has_value() || !cached_alignment.has_value()) {
+        return false;
+    }
+
+    ViewportInfo info;
+    info.alignment = alignment.value();
+    info.cached_alignment = cached_alignment.value();
+    info.frame_id = static_cast<std::uint64_t>(std::max(0, viewport.at("frame_id").as_integer()));
+    if (viewport.contains("adaptive")) {
+        info.adaptive = viewport.at("adaptive").as_boolean();
+    }
+    if (viewport.contains("available_alignments") && viewport.at("available_alignments").is_array()) {
+        for (const auto& item : viewport.at("available_alignments").as_array()) {
+            const auto value = ParseAlignment(item.as_string());
+            if (!value.has_value()) {
+                continue;
+            }
+            info.center_available = info.center_available || value.value() == MaaViewportAlignment_Center;
+            info.left_available = info.left_available || value.value() == MaaViewportAlignment_Left;
+            info.right_available = info.right_available || value.value() == MaaViewportAlignment_Right;
+        }
+    }
+    if (!info.center_available && !info.left_available && !info.right_available) {
+        info.center_available = true;
+    }
+
+    *out_info = info;
+    return true;
+}
+
+bool ViewportSession::SetAlignment(MaaViewportAlignment alignment) const
+{
+    if (controller_ == nullptr || !IsValidAlignment(alignment)) {
+        return false;
+    }
+
+    LogInfo << "ViewportSession: setting screenshot alignment." << VAR(alignment) << VAR(UseHeadlessAdaptiveContract());
+    const bool succeeded =
+        MaaControllerSetOption(controller_, MaaCtrlOption_ScreenshotViewportAlignment, &alignment, sizeof(alignment));
+    if (succeeded && UseHeadlessAdaptiveContract()) {
+        auto& state = HeadlessState(controller_);
+        state.alignment = alignment;
+        state.cached_alignment = alignment;
+    }
+    LogInfo << "ViewportSession: screenshot alignment result." << VAR(alignment) << VAR(succeeded);
+    return succeeded;
+}
+
+void ViewportSession::NoteCapturedFrame() const
+{
+    if (!UseHeadlessAdaptiveContract() || controller_ == nullptr) {
+        return;
+    }
+    auto& state = HeadlessState(controller_);
+    ++state.frame_id;
+    if (state.frame_id == 0) {
+        state.frame_id = 1;
+    }
+    state.cached_alignment = state.alignment;
+}
+
+std::uint64_t ViewportSession::EnsureFrameId() const
+{
+    if (!UseHeadlessAdaptiveContract() || controller_ == nullptr) {
+        return 0;
+    }
+    auto& state = HeadlessState(controller_);
+    if (state.frame_id == 0) {
+        state.frame_id = 1;
+    }
+    return state.frame_id;
+}
+
+bool ViewportSession::IsAlignmentAvailable(const ViewportInfo& info, MaaViewportAlignment alignment) const
+{
+    switch (alignment) {
+    case MaaViewportAlignment_Center:
+        return info.center_available;
+    case MaaViewportAlignment_Left:
+        return info.left_available;
+    case MaaViewportAlignment_Right:
+        return info.right_available;
+    default:
+        return false;
+    }
+}
+
+bool ViewportSession::PrepareFrame(const ViewportFrame& frame, ViewportInfo* before) const
+{
+    if (!frame.Valid() || before == nullptr || !ReadInfo(before) || !IsAlignmentAvailable(*before, frame.alignment)) {
+        return false;
+    }
+    if (frame.strict && before->frame_id != frame.frame_id) {
+        LogWarn << "ViewportSession: stale recognition frame rejected." << VAR(before->frame_id) << VAR(frame.frame_id);
+        return false;
+    }
+    return SetAlignment(frame.alignment);
+}
+
+bool ViewportSession::RestoreAlignment(MaaViewportAlignment alignment) const
+{
+    if (SetAlignment(alignment)) {
+        return true;
+    }
+    LogWarn << "ViewportSession: failed to restore screenshot viewport alignment." << VAR(alignment);
+    return false;
+}
+
+bool ViewportSession::WaitForAction(MaaCtrlId id, const char* action_name) const
+{
+    if (controller_ == nullptr || id == MaaInvalidId) {
+        LogWarn << "ViewportSession: failed to post controller action." << VAR(action_name);
+        return false;
+    }
+
+    const MaaStatus status = MaaControllerWait(controller_, id);
+    if (status == MaaStatus_Succeeded) {
+        return true;
+    }
+    LogWarn << "ViewportSession: controller action did not succeed." << VAR(action_name) << VAR(id) << VAR(status);
+    return false;
+}
+
+} // namespace maaend::viewport
