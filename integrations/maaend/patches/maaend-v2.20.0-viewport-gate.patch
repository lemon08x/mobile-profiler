+		return errors.New("controller swipe failed")
+	}
+	return nil
+}
+
+func (b *maaBackend) touchDown(contact, x, y, pressure int32) error {
+	if job := b.controller.PostTouchDown(contact, x, y, pressure).Wait(); job == nil || !job.Success() {
+		return errors.New("controller touch down failed")
+	}
+	return nil
+}
+
+func (b *maaBackend) touchMove(contact, x, y, pressure int32) error {
