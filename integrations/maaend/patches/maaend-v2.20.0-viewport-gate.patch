+package viewportprobe
+
+import (
+	"context"
+	"fmt"
+	"testing"
+
+	"github.com/MaaXYZ/MaaEnd/agent/go-service/pkg/viewport"
+	maa "github.com/MaaXYZ/maa-framework-go/v4"
+)
+
+type fakeInputSession struct {
+	events []string
+}
+
+func (s *fakeInputSession) PreferredLabel(_ context.Context, alignment maa.ViewportAlignment) (viewport.Frame, error) {
+	frameID := uint64(11)
+	if alignment == maa.ViewportAlignmentRight {
+		frameID = 12
+	}
+	return viewport.Frame{Alignment: alignment, FrameID: frameID}, nil
+}
+
+func (s *fakeInputSession) TouchDown(_ context.Context, frame viewport.Frame, contact, x, y, pressure int32) error {
+	s.events = append(s.events, fmt.Sprintf("down:%d:%s:%d:%d:%d", contact, alignmentName(frame.Alignment), x, y, pressure))
+	return nil
+}
+
+func (s *fakeInputSession) TouchMove(_ context.Context, frame viewport.Frame, contact, x, y, pressure int32) error {
+	s.events = append(s.events, fmt.Sprintf("move:%d:%s:%d:%d:%d", contact, alignmentName(frame.Alignment), x, y, pressure))
+	return nil
+}
+
+func (s *fakeInputSession) TouchUp(_ context.Context, contact int32) error {
+	s.events = append(s.events, fmt.Sprintf("up:%d", contact))
+	return nil
+}
+
+func TestRunInputProbeUsesLeftJoystickAndReversesRightCamera(t *testing.T) {
+	session := &fakeInputSession{}
+	evidence, err := runInputProbe(context.Background(), session)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := []string{
+		"down:0:left:195:551:1",
+		"up:0",
+		"down:1:right:640:264:0",
+		"move:1:right:664:264:0",
+		"move:1:right:640:264:0",
+		"up:1",
+	}
+	if fmt.Sprint(session.events) != fmt.Sprint(want) {
+		t.Fatalf("events = %v, want %v", session.events, want)
+	}
+	if evidence.left.FrameID != 11 || evidence.right.FrameID != 12 {
+		t.Fatalf("unexpected evidence: %+v", evidence)
+	}
+}
