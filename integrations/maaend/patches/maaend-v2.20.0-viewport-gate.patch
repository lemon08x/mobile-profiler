+// Copyright (c) 2026 Harry Huang
+package maptrackerbigmap
+
+import "testing"
+
+func TestBigMapPickTargetRequiresSafeMarkerMargin(t *testing.T) {
+	viewPort := NewBigMapViewport(100, 200, 2)
+
+	mapAtScreen := func(screenX, screenY float64) (float64, float64) {
+		return viewPort.GetMapCoordOf(screenX, screenY)
+	}
+
+	insideX := viewPort.Left + BIG_MAP_PICK_SAFE_PADDING
+	insideY := viewPort.Top + BIG_MAP_PICK_SAFE_PADDING
+	mapX, mapY := mapAtScreen(insideX, insideY)
+	if !isBigMapPickTargetSafe(viewPort, mapX, mapY) {
+		t.Fatal("target exactly on the safe margin should be accepted")
+	}
+
+	mapX, mapY = mapAtScreen(insideX-1, insideY)
+	if isBigMapPickTargetSafe(viewPort, mapX, mapY) {
+		t.Fatal("target with a clipped horizontal marker margin should be rejected")
+	}
+
+	mapX, mapY = mapAtScreen(insideX, insideY-1)
+	if isBigMapPickTargetSafe(viewPort, mapX, mapY) {
+		t.Fatal("target with a clipped vertical marker margin should be rejected")
+	}
+}
+
+func TestBigMapPickTargetRejectsNilViewport(t *testing.T) {
+	if isBigMapPickTargetSafe(nil, 0, 0) {
+		t.Fatal("nil viewport must fail closed")
+	}
+}
