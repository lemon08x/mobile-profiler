+                    << VAR(sample_hold_pulse_origin_.x) << VAR(sample_hold_pulse_origin_.y)
+                    << VAR(position_->x) << VAR(position_->y);
+        }
+        LogInfo << "ADB sample-and-hold pulse observation." << VAR(sample_hold_pulse_ms_) << VAR(displacement)
+                << VAR(observed_units_per_ms) << VAR(usable_speed) << VAR(sample_hold_units_per_ms_)
+                << VAR(position_->x) << VAR(position_->y);
