+
+func validateAndroidOpenGameLaunchChain(ctx *maa.Context) (string, error) {
+	entry, err := ctx.GetNode(androidOpenGameEntry)
+	if err != nil {
+		return "", fmt.Errorf("read %s node: %w", androidOpenGameEntry, err)
+	}
+	if err := validateCoordinateFreeNode(entry, maa.ActionTypeDoNothing); err != nil {
+		return "", fmt.Errorf("validate %s node: %w", androidOpenGameEntry, err)
+	}
+	if len(entry.Next) != 1 || entry.Next[0].JumpBack || entry.Next[0].Anchor {
+		return "", fmt.Errorf("%s must select exactly one unannotated launch node", androidOpenGameEntry)
+	}
+
+	launchNode := entry.Next[0].Name
+	expectedPackage, ok := androidOpenGameLaunchPackages[launchNode]
+	if !ok {
+		return "", fmt.Errorf("%s selects unsupported launch node %q", androidOpenGameEntry, launchNode)
+	}
+	launch, err := ctx.GetNode(launchNode)
+	if err != nil {
+		return "", fmt.Errorf("read %s node: %w", launchNode, err)
+	}
+	if err := validateCoordinateFreeNode(launch, maa.ActionTypeStartApp); err != nil {
+		return "", fmt.Errorf("validate %s node: %w", launchNode, err)
+	}
+	startParam, ok := launch.Action.Param.(*maa.StartAppParam)
+	if !ok || startParam.Package != expectedPackage {
+		return "", fmt.Errorf("%s does not start its expected package", launchNode)
+	}
+	if len(launch.Next) != 1 || launch.Next[0].Name != androidOpenGameGateNode || launch.Next[0].JumpBack || launch.Next[0].Anchor {
+		return "", fmt.Errorf("%s must continue directly to %s", launchNode, androidOpenGameGateNode)
+	}
+
+	gate, err := ctx.GetNode(androidOpenGameGateNode)
+	if err != nil {
+		return "", fmt.Errorf("read %s node: %w", androidOpenGameGateNode, err)
+	}
+	if err := validateCoordinateFreeNode(gate, maa.ActionTypeDoNothing); err != nil {
+		return "", fmt.Errorf("validate %s gate node: %w", androidOpenGameGateNode, err)
+	}
+
+	return launchNode, nil
+}
+
+func validateCoordinateFreeNode(node *maa.Node, actionType maa.ActionType) error {
+	if node == nil || node.Recognition == nil || node.Recognition.Type != maa.RecognitionTypeDirectHit {
+		return fmt.Errorf("recognition must be DirectHit")
+	}
+	if node.Action == nil || node.Action.Type != actionType {
+		return fmt.Errorf("action must be %s", actionType)
+	}
+	return nil
+}
+
+func waitForCompatibleScreenshotViewport(controller *maa.Controller) (screenshotViewportInfo, error) {
+	if controller == nil {
+		return screenshotViewportInfo{}, fmt.Errorf("controller is unavailable at landscape viewport gate")
+	}
+
+	deadline := time.Now().Add(portraitTransitionWait)
+	var lastErr error
+	for {
+		width, height, resolutionErr := controller.GetResolution()
+		if resolutionErr == nil {
+			viewport, viewportErr := readCompatibleScreenshotViewport(controller, width, height)
+			if viewportErr == nil {
+				return viewport, nil
+			}
+			lastErr = viewportErr
+		} else {
+			lastErr = fmt.Errorf("read controller resolution: %w", resolutionErr)
+		}
+
+		if time.Now().After(deadline) {
+			return screenshotViewportInfo{}, fmt.Errorf("landscape screenshot viewport did not activate within %s: %w", portraitTransitionWait, lastErr)
+		}
+		if job := controller.PostScreencap().Wait(); !job.Success() {
+			lastErr = fmt.Errorf("screencap failed while waiting for landscape orientation")
+		}
+		time.Sleep(portraitTransitionPoll)
+	}
+}
+
+func (c *AspectRatioChecker) beginPortraitTransition(taskID uint64, transition portraitTransition) {
+	c.transitionMu.Lock()
+	defer c.transitionMu.Unlock()
+	if c.transitions == nil {
+		c.transitions = make(map[uint64]portraitTransition)
+	}
+	c.transitions[taskID] = transition
+}
+
+func (c *AspectRatioChecker) getPortraitTransition(taskID uint64) (portraitTransition, bool) {
+	c.transitionMu.Lock()
+	defer c.transitionMu.Unlock()
+	transition, ok := c.transitions[taskID]
+	return transition, ok
+}
+
+func (c *AspectRatioChecker) markPortraitTransitionValidated(taskID uint64, launchNode string) {
+	c.transitionMu.Lock()
+	defer c.transitionMu.Unlock()
+	transition, ok := c.transitions[taskID]
+	if !ok {
+		return
+	}
+	transition.launchNode = launchNode
+	transition.chainValidated = true
+	c.transitions[taskID] = transition
+}
+
+func (c *AspectRatioChecker) clearPortraitTransition(taskID uint64) {
+	c.transitionMu.Lock()
+	defer c.transitionMu.Unlock()
+	delete(c.transitions, taskID)
+}
+
+func (c *AspectRatioChecker) failPortraitTransition(ctx *maa.Context, detail maa.NodePipelineNodeDetail, err error) {
+	transition, _ := c.getPortraitTransition(detail.TaskID)
+	c.clearPortraitTransition(detail.TaskID)
+	log.Error().
+		Err(err).
+		Uint64("task_id", detail.TaskID).
+		Str("entry", androidOpenGameEntry).
+		Str("node", detail.Name).
+		Bool("stop_task", true).
+		Msg("portrait Android launch transition failed closed")
+	c.stopWithWarning(
+		ctx.GetTasker(),
+		transition.controllerDisplay,
+		transition.width,
+		transition.height,
+		i18n.T("tasker.aspect_ratio_warning.requirement_exact", targetWidth, targetHeight),
+	)
+}
