+)
+
+func TestUIDCandidatesKeepLatencyDigitsOutOfUID(t *testing.T) {
+	labelled, fallback := uidCandidates([]string{
+		"22ms UID: 1467472365",
+	})
+	if len(labelled) != 1 || labelled[0] != "1467472365" {
+		t.Fatalf("unexpected labelled candidates: %v", labelled)
+	}
+	if len(fallback) != 0 {
+		t.Fatalf("labelled UID must not remain as fallback: %v", fallback)
+	}
+}
+
+func TestUIDCandidatesJoinSplitOCRResults(t *testing.T) {
+	labelled, _ := uidCandidates([]string{
+		"UID:",
+		"1467472365",
+		"UID: 1467472365",
+	})
+	if len(labelled) != 1 || labelled[0] != "1467472365" {
+		t.Fatalf("unexpected labelled candidates: %v", labelled)
+	}
+}
+
+func TestSelectUIDMatchPrefersUniqueLabelledCandidate(t *testing.T) {
+	center := viewport.Frame{
+		Alignment: maa.ViewportAlignmentCenter,
+		FrameID:   7,
+	}
+	left := viewport.Frame{
+		Alignment: maa.ViewportAlignmentLeft,
+		FrameID:   7,
+	}
+	selected, ok := selectUIDMatch([]uidMatch{
+		{digits: "1467472365", frame: center, labelled: true},
+		{digits: "12345678", frame: left},
+	})
+	if !ok || selected.digits != "1467472365" || selected.frame.Alignment != maa.ViewportAlignmentCenter {
+		t.Fatalf("unexpected selection: %#v, ok=%v", selected, ok)
+	}
+}
+
+func TestSelectUIDMatchRejectsAmbiguousLabelledCandidates(t *testing.T) {
+	_, ok := selectUIDMatch([]uidMatch{
+		{digits: "1467472365", labelled: true},
+		{digits: "2467472365", labelled: true},
+	})
+	if ok {
+		t.Fatal("ambiguous labelled UID candidates must be rejected")
+	}
+}
