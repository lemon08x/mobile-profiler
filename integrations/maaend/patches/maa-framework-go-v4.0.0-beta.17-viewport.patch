 	}
 }
 
+// SetScreenshotViewportAlignment re-renders the current cached raw screenshot using alignment.
+// It does not capture a new raw frame. Left and Right require an active adaptive viewport, and
+// every alignment requires a valid cached raw frame.
+func (c *Controller) SetScreenshotViewportAlignment(alignment ViewportAlignment) error {
+	if alignment < ViewportAlignmentCenter || alignment > ViewportAlignmentRight {
+		return fmt.Errorf("invalid screenshot viewport alignment: %d", alignment)
+	}
+	value := int32(alignment)
+	return c.setOption(
+		native.MaaCtrlOption_ScreenshotViewportAlignment,
+		unsafe.Pointer(&value),
+		unsafe.Sizeof(value),
+	)
+}
