+// ViewportAlignment selects a logical 16:9 viewport from an adaptive raw screenshot frame.
+type ViewportAlignment int32
+
+const (
+	ViewportAlignmentCenter ViewportAlignment = 0
+	ViewportAlignmentLeft   ViewportAlignment = 1
+	ViewportAlignmentRight  ViewportAlignment = 2
