+func TestNodeRecognitionDetail_ViewportEvidence(t *testing.T) {
+	const payload = `{
+		"task_id": 200000001,
+		"reco_id": 400000001,
+		"name": "InWorld",
+		"focus": null,
+		"reco_details": {
+			"reco_id": 400000001,
+			"name": "InWorld",
+			"algorithm": "TemplateMatch",
+			"box": [10, 20, 30, 40],
+			"viewport_alignment": "left",
+			"frame_id": 42,
+			"detail": {"score": 0.99}
+		}
+	}`
+
+	var detail NodeRecognitionDetail
+	require.NoError(t, unmarshalJSON([]byte(payload), &detail))
+	require.NotNil(t, detail.RecognitionDetails)
+	require.Equal(t, uint64(400000001), detail.RecognitionDetails.RecognitionID)
+	require.Equal(t, "left", detail.RecognitionDetails.ViewportAlignment)
+	require.Equal(t, uint64(42), detail.RecognitionDetails.FrameID)
+	require.Equal(t, &Rect{10, 20, 30, 40}, detail.RecognitionDetails.Box)
+}
+
+func TestNodePipelineNodeDetail_RecognitionDetailsLifecycle(t *testing.T) {
+	var starting NodePipelineNodeDetail
+	require.NoError(t, unmarshalJSON([]byte(`{"task_id":1,"node_id":2,"name":"InWorld"}`), &starting))
+	require.Nil(t, starting.RecognitionDetails)
+
+	var succeeded NodePipelineNodeDetail
+	require.NoError(t, unmarshalJSON([]byte(`{
+		"task_id":1,
+		"node_id":2,
+		"name":"InWorld",
+		"reco_details":{
+			"reco_id":3,
+			"name":"InWorld",
+			"algorithm":"DirectHit",
+			"box":[0,0,1280,720],
+			"viewport_alignment":"right",
+			"frame_id":7,
+			"detail":null
+		}
+	}`), &succeeded))
+	require.NotNil(t, succeeded.RecognitionDetails)
+	require.Equal(t, "right", succeeded.RecognitionDetails.ViewportAlignment)
+	require.Equal(t, uint64(7), succeeded.RecognitionDetails.FrameID)
+}
