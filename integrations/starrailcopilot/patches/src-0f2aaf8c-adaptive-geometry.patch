--- /dev/null
+++ b/module/device/geometry.py
@@ -0,0 +1,374 @@
+"""Coordinate contracts for running SRC's 1280x720 logic on wide displays.
+
+The existing recognition resources stay in a 1280x720 logical coordinate
+space.  A physical screenshot can expose three overlapping 16:9 viewports:
+left, center, and right.  Geometry is immutable and attached to every frame so
+an input never depends on mutable process-wide "active viewport" state.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from enum import Enum
+from typing import Optional, Tuple
+
+import cv2
+import numpy as np
+
+
+ADAPTIVE_GEOMETRY_PATCH_VERSION = "mobile-profiler-src-0f2aaf8c-v1"
+LOGICAL_WIDTH = 1280
+LOGICAL_HEIGHT = 720
+LOGICAL_SIZE = (LOGICAL_WIDTH, LOGICAL_HEIGHT)
+LOGICAL_ASPECT_RATIO = LOGICAL_WIDTH / LOGICAL_HEIGHT
+MAX_SUPPORTED_ASPECT_RATIO = 3.0
+
+Point = Tuple[float, float]
+
+
+class GeometryError(ValueError):
+    """Raised when a display/capture relationship cannot be mapped safely."""
+
+
+class Alignment(str, Enum):
+    LEFT = "left"
+    CENTER = "center"
+    RIGHT = "right"
+
+    @classmethod
+    def coerce(cls, value: "Alignment | str") -> "Alignment":
+        if isinstance(value, cls):
+            return value
+        try:
+            return cls(str(value).strip().lower())
+        except ValueError as exc:
+            choices = ", ".join(item.value for item in cls)
+            raise GeometryError(
+                f"Unknown viewport alignment {value!r}; expected one of {choices}"
+            ) from exc
+
+
+@dataclass(frozen=True)
+class Insets:
+    left: float = 0
+    top: float = 0
+    right: float = 0
+    bottom: float = 0
+
+    def __post_init__(self):
+        if min(self.left, self.top, self.right, self.bottom) < 0:
+            raise GeometryError(f"Insets must be non-negative: {self}")
+
+
+@dataclass(frozen=True)
+class Rect:
+    left: float
+    top: float
+    right: float
+    bottom: float
+
+    def __post_init__(self):
+        if self.right <= self.left or self.bottom <= self.top:
+            raise GeometryError(f"Rectangle must have positive area: {self}")
+
+    @property
+    def width(self) -> float:
+        return self.right - self.left
+
+    @property
+    def height(self) -> float:
+        return self.bottom - self.top
+
+    @property
+    def center(self) -> Point:
+        return (
+            self.left + self.width / 2,
+            self.top + self.height / 2,
+        )
+
+    def contains(self, point: Point, *, tolerance: float = 1e-6) -> bool:
+        x, y = point
+        return (
+            self.left - tolerance <= x <= self.right + tolerance
+            and self.top - tolerance <= y <= self.bottom + tolerance
+        )
+
+
+@dataclass(frozen=True)
+class DisplayGeometry:
+    """The oriented physical display used by Android input backends."""
+
+    width: int
+    height: int
+    rotation: int = 0
+    safe_insets: Insets = field(default_factory=Insets)
+
+    def __post_init__(self):
+        if self.width <= 0 or self.height <= 0:
+            raise GeometryError(
+                f"Display dimensions must be positive: {self.width}x{self.height}"
+            )
+        if self.width <= self.height:
+            raise GeometryError(
+                f"Adaptive geometry requires an oriented landscape display: "
+                f"{self.width}x{self.height}"
+            )
+        if self.rotation not in (0, 1, 2, 3):
+            raise GeometryError(f"Invalid Android display rotation: {self.rotation}")
+        if (
+            self.safe_insets.left + self.safe_insets.right >= self.width
+            or self.safe_insets.top + self.safe_insets.bottom >= self.height
+        ):
+            raise GeometryError(
+                f"Safe insets consume the complete display: {self.safe_insets}"
+            )
+
+    @property
+    def bounds(self) -> Rect:
+        return Rect(0, 0, self.width, self.height)
+
+    @property
+    def safe_bounds(self) -> Rect:
+        return Rect(
+            self.safe_insets.left,
+            self.safe_insets.top,
+            self.width - self.safe_insets.right,
+            self.height - self.safe_insets.bottom,
+        )
+
+    def oriented_to_natural(self, point: Point) -> tuple[Point, tuple[int, int]]:
+        """Map an oriented screenshot point to the touch device's natural axes."""
+
+        if not self.bounds.contains(point):
+            raise GeometryError(f"Display point is outside {self.bounds}: {point}")
+        x, y = point
+        if self.rotation == 0:
+            return (x, y), (self.width, self.height)
+        if self.rotation == 1:
+            return (self.height - y, x), (self.height, self.width)
+        if self.rotation == 2:
+            return (self.width - x, self.height - y), (self.width, self.height)
+        return (y, self.width - x), (self.height, self.width)
+
+
+@dataclass(frozen=True)
+class CaptureGeometry:
+    """A screenshot/video frame and the physical display region it represents."""
+
+    width: int
+    height: int
+    display: DisplayGeometry
+    display_rect: Optional[Rect] = None
+
+    def __post_init__(self):
+        if self.width <= 0 or self.height <= 0:
+            raise GeometryError(
+                f"Capture dimensions must be positive: {self.width}x{self.height}"
+            )
+        if self.width <= self.height:
+            raise GeometryError(
+                f"Adaptive geometry requires a landscape capture: "
+                f"{self.width}x{self.height}"
+            )
+        if self.height < LOGICAL_HEIGHT:
+            raise GeometryError(
+                f"Capture height {self.height} is below the "
+                f"{LOGICAL_HEIGHT}px logical baseline"
+            )
+        display_rect = self.display_rect or self.display.bounds
+        if (
+            display_rect.left < 0
+            or display_rect.top < 0
+            or display_rect.right > self.display.width
+            or display_rect.bottom > self.display.height
+        ):
+            raise GeometryError(
+                f"Capture display rect {display_rect} exceeds {self.display.bounds}"
+            )
+        object.__setattr__(self, "display_rect", display_rect)
+
+    @property
+    def bounds(self) -> Rect:
+        return Rect(0, 0, self.width, self.height)
+
+    def capture_to_display(self, point: Point) -> Point:
+        if not self.bounds.contains(point):
+            raise GeometryError(f"Capture point is outside {self.bounds}: {point}")
+        x, y = point
+        rect = self.display_rect
+        return (
+            rect.left + x / self.width * rect.width,
+            rect.top + y / self.height * rect.height,
+        )
+
+    def display_to_capture(self, point: Point) -> Point:
+        rect = self.display_rect
+        if not rect.contains(point):
+            raise GeometryError(f"Display point is outside capture rect {rect}: {point}")
+        x, y = point
+        return (
+            (x - rect.left) / rect.width * self.width,
+            (y - rect.top) / rect.height * self.height,
+        )
+
+    @property
+    def safe_bounds(self) -> Rect:
+        safe = self.display.safe_bounds
+        top_left = self.display_to_capture((safe.left, safe.top))
+        bottom_right = self.display_to_capture((safe.right, safe.bottom))
+        return Rect(*top_left, *bottom_right)
+
+    def viewport(self, alignment: "Alignment | str") -> "Viewport":
+        alignment = Alignment.coerce(alignment)
+        available = self.safe_bounds
+        aspect_ratio = available.width / available.height
+        if aspect_ratio + 1e-6 < LOGICAL_ASPECT_RATIO:
+            raise GeometryError(
+                f"Safe capture area is narrower than 16:9: "
+                f"{available.width:.3f}x{available.height:.3f}"
+            )
+        if aspect_ratio > MAX_SUPPORTED_ASPECT_RATIO:
+            raise GeometryError(
+                f"Safe capture aspect ratio {aspect_ratio:.4f} exceeds "
+                f"the supported maximum {MAX_SUPPORTED_ASPECT_RATIO:.4f}"
+            )
+
+        viewport_width = available.height * LOGICAL_ASPECT_RATIO
+        spare = max(0.0, available.width - viewport_width)
+        if alignment is Alignment.LEFT:
+            offset = 0.0
+        elif alignment is Alignment.CENTER:
+            offset = spare / 2
+        else:
+            offset = spare
+        rect = Rect(
+            available.left + offset,
+            available.top,
+            available.left + offset + viewport_width,
+            available.bottom,
+        )
+        return Viewport(alignment=alignment, capture=self, capture_rect=rect)
+
+    def logical_to_capture(
+        self, point: Point, alignment: "Alignment | str" = Alignment.CENTER
+    ) -> Point:
+        return self.viewport(alignment).logical_to_capture(point)
+
+    def logical_to_display(
+        self, point: Point, alignment: "Alignment | str" = Alignment.CENTER
+    ) -> Point:
+        return self.capture_to_display(self.logical_to_capture(point, alignment))
+
+    def for_capture_size(self, width: int, height: int) -> "CaptureGeometry":
+        """Describe another full-display capture, for example scrcpy control video."""
+
+        return CaptureGeometry(
+            width=width,
+            height=height,
+            display=self.display,
+            display_rect=self.display_rect,
+        )
+
+
+@dataclass(frozen=True)
+class Viewport:
+    alignment: Alignment
+    capture: CaptureGeometry
+    capture_rect: Rect
+
+    @property
+    def logical_bounds(self) -> Rect:
+        return Rect(0, 0, LOGICAL_WIDTH, LOGICAL_HEIGHT)
+
+    def logical_to_capture(self, point: Point) -> Point:
+        if not self.logical_bounds.contains(point):
+            raise GeometryError(
+                f"Logical point is outside {self.logical_bounds}: {point}"
+            )
+        x, y = point
+        return (
+            self.capture_rect.left + x / LOGICAL_WIDTH * self.capture_rect.width,
+            self.capture_rect.top + y / LOGICAL_HEIGHT * self.capture_rect.height,
+        )
+
+    def capture_to_logical(self, point: Point) -> Point:
+        if not self.capture_rect.contains(point):
+            raise GeometryError(
+                f"Capture point is outside {self.alignment.value} viewport "
+                f"{self.capture_rect}: {point}"
+            )
+        x, y = point
+        return (
+            (x - self.capture_rect.left) / self.capture_rect.width * LOGICAL_WIDTH,
+            (y - self.capture_rect.top) / self.capture_rect.height * LOGICAL_HEIGHT,
+        )
+
+    def crop(self, raw_image: np.ndarray) -> np.ndarray:
+        """Crop this viewport once and normalize it to SRC's logical size."""
+
+        if raw_image.ndim < 2:
+            raise GeometryError(f"Screenshot has invalid shape: {raw_image.shape}")
+        raw_height, raw_width = raw_image.shape[:2]
+        if (raw_width, raw_height) != (self.capture.width, self.capture.height):
+            raise GeometryError(
+                f"Screenshot shape {raw_width}x{raw_height} does not match "
+                f"capture geometry {self.capture.width}x{self.capture.height}"
+            )
+        left = max(0, min(raw_width - 1, int(round(self.capture_rect.left))))
+        top = max(0, min(raw_height - 1, int(round(self.capture_rect.top))))
+        right = max(left + 1, min(raw_width, int(round(self.capture_rect.right))))
+        bottom = max(top + 1, min(raw_height, int(round(self.capture_rect.bottom))))
+        cropped = raw_image[top:bottom, left:right]
+        if (cropped.shape[1], cropped.shape[0]) == LOGICAL_SIZE:
+            return cropped
+        interpolation = (
+            cv2.INTER_AREA
+            if cropped.shape[1] >= LOGICAL_WIDTH
+            and cropped.shape[0] >= LOGICAL_HEIGHT
+            else cv2.INTER_LINEAR
+        )
+        return cv2.resize(cropped, LOGICAL_SIZE, interpolation=interpolation)
+
+
+@dataclass(frozen=True)
+class LogicalFrame:
+    frame_id: int
+    alignment: Alignment
+    image: np.ndarray
+    geometry: CaptureGeometry
+
+    @property
+    def viewport(self) -> Viewport:
+        return self.geometry.viewport(self.alignment)
+
+
+@dataclass(frozen=True)
+class Action:
+    point: Point
+    alignment: Alignment = Alignment.CENTER
+    contact_id: int = 0
+    frame_id: Optional[int] = None
+
+    def __post_init__(self):
+        object.__setattr__(self, "alignment", Alignment.coerce(self.alignment))
+        if self.contact_id < 0:
+            raise GeometryError(f"Contact id must be non-negative: {self.contact_id}")
+
+
+@dataclass(frozen=True)
+class Hit:
+    rect: Rect
+    alignment: Alignment
+    frame_id: int
+
+    def __post_init__(self):
+        object.__setattr__(self, "alignment", Alignment.coerce(self.alignment))
+
+    def action(self, contact_id: int = 0) -> Action:
+        return Action(
+            point=self.rect.center,
+            alignment=self.alignment,
+            contact_id=contact_id,
+            frame_id=self.frame_id,
+        )
+
